# Project-specific: trajectory logs (kept in runs/ but excluded from repo)
# (Remove this if you want to commit trajectory JSONLs)
runs/**/*.jsonl
!runs/.gitkeep

# Claude harness state
.claude/

# Environment / secrets
.env
.env.local

# RLCD fine-tuned Laya checkpoints (1.6 GB weights each; regenerate via scripts/train_rlcd_laya.py)
runs/rlcd_laya_*/*
!runs/rlcd_laya_*/rlcd_train_report.json

# Reference paper PDFs (~60 MB; re-downloadable via the links in
# docs/ref_papers/optimization_theory_survey.md)
docs/ref_papers/pdfs/

# Trained model dumps under runs/ (regenerable; keep the repo lean —
# the 4x569MB typed_decision_*.pt accidents are recoverable from history)
runs/*.pt

# Attribution batch: model pickles and heavy raw per-step payloads
# (loops/labels/controls JSONs, 3-17MB each). Small analysis summaries,
# REPORT.md and smoke runs stay tracked, matching the runs/**/*.jsonl policy.
runs/**/*.pkl
runs/attribution_*/loops.json
runs/attribution_*/labels.json
runs/attribution_*/controls.json
runs/attribution_*/dim_loops.json
runs/attribution_*/dim_labels.json
runs/attribution_*/dim_controls.json
runs/attribution_*/repeat32.json

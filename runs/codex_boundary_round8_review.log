   202	
   203	def enforce_record_pooling(
   204	    stamps: list[dict],
   205	    policy: str | VersionPolicy,
   206	    *,
   207	    source: str = "",
   208	    pool_legacy: bool = False,
   209	    pooling_note: str = "",
   210	) -> None:
   211	    """Enforce the guide 4.5 no-silent-mixing rule over a loaded source.
   212	
   213	    Compares RAW stamp values (not status classes), so two DIFFERENT
   214	    known-past stamps also count as a mix (codex round-4 B3). A mix of
   215	    distinct stamps on one axis is a cross-version pool; the guide
   216	    requires an explicit decision with a recorded same-data A/B note.
   217	    Under any non-ALLOW policy: pool_legacy=False -> WARN warns, STRICT
   218	    raises; pool_legacy=True REQUIRES a non-empty pooling_note, records
   219	    the decision in the audit trail (pooling_decisions()), and proceeds.
   220	
   221	    Boundary limitation (documented in guide 4.5): this checks ONE loaded
   222	    source; combining multiple separately loaded files must pass each
   223	    through read_jsonl and cite the same pooling note.
   224	    """
   225	    policy = VersionPolicy(policy)
   226	    if policy is VersionPolicy.ALLOW:
   227	        return
   228	    if pool_legacy:
   229	        if not pooling_note.strip():
   230	            raise VersionPolicyError(
   231	                f"{source}: pool_legacy=True requires a pooling_note "
   232	                f"describing the same-data A/B justification (guide 6.6 "
   233	                f"rule 1)")
   234	        entry = {"source": source, "note": pooling_note}
   235	        _persist_pooling_decision(entry)  # raises on failure — only then:
   236	        _recorded_pooling_decisions.append(entry)  # durable before visible
   237	        return
   238	    import warnings
   239	
   240	    for axis in ("harness", "utility"):
   241	        # An absent stamp counts as its own value: records that predate the
   242	        # stamp mechanism pool with stamped records only by explicit note.
   243	        values = sorted({str(s.get(f"{axis}_version")) for s in stamps})
   244	        if len(values) > 1:
   245	            msg = (f"{source}: mixes {axis} stamps {values}; pooling "
   246	                   f"across versions requires an explicit same-data A/B "
   247	                   f"note (guide 6.6 rule 1) — pass pool_legacy=True with "
   248	                   f"a pooling_note to record that decision")
   249	            if policy is VersionPolicy.STRICT:
   250	                raise VersionPolicyError(msg)
   251	            warnings.warn(msg, stacklevel=2)
   252	
   253	
   254	def stamp_metadata(
   255	    metadata: Mapping[str, Any] | None,
   256	    *,
   257	    harness_version: str = HARNESS_VERSION,
   258	    utility_version: str = UTILITY_VERSION,
   259	) -> dict[str, Any]:
   260	    """Return a copy of ``metadata`` with both version stamps applied.
   261	
   262	    Existing stamp keys are overwritten (the caller is generating records
   263	    with the current code, whose stamps ARE the current constants).
   264	    """
   265	    out = dict(metadata) if metadata else {}
   266	    out["harness_version"] = harness_version
   267	    out["utility_version"] = utility_version
   268	    return out
   269	
   270	
   271	def check_record_versions(
   272	    record_metadata: Mapping[str, Any],
   273	) -> dict[str, VersionStatus]:
   274	    """Classify a record's stamps against the current constants.
   275	
   276	    ``record_metadata`` is the ``metadata`` dict of a DecisionRecord (the
   277	    stamps live at its top level; see the generator).
   278	    """
   279	    return {
   280	        "harness": _status(record_metadata.get("harness_version"),
   281	                           HARNESS_VERSION, "harness"),
   282	        "utility": _status(record_metadata.get("utility_version"),
   283	                           UTILITY_VERSION, "utility"),
   284	    }
   285	
   286	
   287	def _status(stamp: Any, current: str, axis: str) -> VersionStatus:
   288	    if stamp == current:
   289	        return VersionStatus.OK
   290	    if stamp is None or stamp in _KNOWN_PAST.get(axis, set()):
   291	        return VersionStatus.LEGACY
   292	    return VersionStatus.MISMATCH


   147	
   148	def assert_combinable(
   149	    stamps_by_source: dict[str, list[dict]],
   150	    policy: str | VersionPolicy,
   151	    *,
   152	    pooling_note: str = "",
   153	    source_notes: dict[str, str] | None = None,
   154	) -> None:
   155	    """Cross-file companion to enforce_record_pooling (guide 4.5).
   156	
   157	    Any consumer combining records from SEVERAL loaded sources must pass
   158	    each source's raw metadata dicts here: the check unions the stamps
   159	    across the complete combined pool and applies the same no-silent-
   160	    mixing rule (warn/raise under non-allow policies).
   161	
   162	    The explicit opt-in requires ONE consistent note for the whole pool:
   163	    either `pooling_note` (a single decision covering all sources), or
   164	    `source_notes` (the per-source opt-in notes recorded when each source
   165	    was loaded) — the latter must be non-empty for every source and all
   166	    identical, and must agree with `pooling_note` when both are given
   167	    (codex round-6 B2).
   168	    """
   169	    if source_notes is not None:
   170	        missing_note = sorted(s for s, n in source_notes.items()
   171	                              if not str(n).strip())
   172	        if missing_note:
   173	            raise VersionPolicyError(
   174	                f"source_notes missing/empty for {missing_note}; every "
   175	                f"pooled source needs its recorded opt-in note")
   176	        missing_source = sorted(set(stamps_by_source)
   177	                                 - set(source_notes))
   178	        extra_source = sorted(set(source_notes)
   179	                              - set(stamps_by_source))
   180	        if missing_source or extra_source:
   181	            raise VersionPolicyError(
   182	                f"source_notes keys must match the pooled sources exactly: "
   183	                f"missing={missing_source}, extra={extra_source}")
   184	        distinct = {str(n).strip() for n in source_notes.values()}
   185	        if len(distinct) != 1:
   186	            raise VersionPolicyError(
   187	                f"per-source pooling notes disagree: {sorted(distinct)} — "
   188	                f"a combined pool requires ONE consistent decision")
   189	        if pooling_note and str(pooling_note).strip() not in distinct:
   190	            raise VersionPolicyError(
   191	                f"pooling_note {pooling_note!r} disagrees with the "
   192	                f"per-source notes {sorted(distinct)}")
   193	        pooling_note = distinct.pop()
   194	    combined: list[dict] = []
   195	    for source, stamps in stamps_by_source.items():
   196	        for s in stamps:
   197	            combined.append({**s, "_source": source})
   198	    enforce_record_pooling(
   199	        combined, policy, source="+".join(stamps_by_source),
   200	        pool_legacy=bool(pooling_note), pooling_note=pooling_note)

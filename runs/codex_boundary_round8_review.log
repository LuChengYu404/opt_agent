    "| STOP | B1 | A_flow | 终止型动作 |",
    "| GLOBAL_EXPLORATION | B2 | A_pt | 重复行 |")

_UNKNOWN_SECTION = _GOOD_SECTION + "| NEW_SHINY_ACTION | B2 | A_pt | 未注册 |\n"

_SHORT_ROW_SECTION = _GOOD_SECTION + "| UNCERTAINTY_SAMPLING | B2 |\n"


   137	        POOLING_AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
   138	        with POOLING_AUDIT_PATH.open("a", encoding="utf-8") as stream:
   139	            stream.write(json.dumps(entry, ensure_ascii=False,
   140	                                    sort_keys=True) + "\n")
   141	    except OSError as exc:
   142	        raise VersionPolicyError(
   143	            f"pooling opt-in for {entry.get('source')!r} could not be "
   144	            f"persisted to {POOLING_AUDIT_PATH} ({exc}); refusing to "
   145	            f"proceed without a durable audit trail") from exc

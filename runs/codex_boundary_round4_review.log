    98	class AlwaysSurrogatePolicy:
    99	    def __init__(self, seed: int = 0) -> None:
   100	        self.seed = seed
   101	
   102	    def select_action(self, state, backend=None):
   103	        choices = candidate_actions_for_state(state, seed=self.seed)
   104	        if "surrogate_acquisition" in choices:
   105	            return choices["surrogate_acquisition"]
   106	        return next(iter(choices.values()))

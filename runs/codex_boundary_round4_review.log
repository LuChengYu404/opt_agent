   314	                    per_family[f]["best_level"], 0) + 1
   315	            pred = max(counts, key=lambda L: (counts[L], -L))  # tie -> smaller level
   316	            lofo.append({"held_out": held, "predicted": pred,
   317	                         "actual": per_family[held]["best_level"],
   318	                         "correct": pred == per_family[held]["best_level"]})
   319	    lofo_acc = (sum(1 for r in lofo if r["correct"]) / len(lofo)) if lofo else None

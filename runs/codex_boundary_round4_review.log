/bin/bash -lc "python - <<'PY'
import json, math, random, statistics
p=json.load(open('runs/exp_meta_config_grid.json')); rows=p['trajectories']; levels=p['levels']; n=p['seeds']; by={(r['family'],r['seed'],r['n_init']):r['best'] for r in rows}
rng=random.Random(429); vals={}
for f in p['families']:
 d=p['dimensions'][f]; xs=[L/(2*d+1) for L in levels]; xm=statistics.fmean(xs); den=sum((x-xm)**2 for x in xs)
 pairs=[]
 for s in range(n):
  ys=[by[(f,s,L)] for L in levels]; ym=statistics.fmean(ys); b=sum((x-xm)*(y-ym) for x,y in zip(xs,ys))/den
  pairs.append((b,by[(f,s,p['reference_level'])]))
 out=[]
 for _ in range(3000):
  batch=[pairs[rng.randrange(n)] for i in range(n)]
  z=statistics.pstdev(x for b,x in batch)
  if z: out.append(statistics.fmean(b for b,x in batch)/z)
 print(f,'bootstrap_se',round(statistics.stdev(out),4),'n',len(out))

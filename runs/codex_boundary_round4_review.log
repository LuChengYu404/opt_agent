    34	# Stamps that may appear in historical records. "phase8.6b" doubles as the
    35	# current UTILITY_VERSION; harness_version was simply absent before h1.
    36	_KNOWN_PAST: dict[str, set[str]] = {
    37	    "harness": set(),  # h1 is the first stamped harness version
    38	    "utility": set(),  # phase8.6b is the first formalized utility version
    39	}
    40	
    41	
    42	class VersionStatus(str, Enum):
    43	    OK = "ok"

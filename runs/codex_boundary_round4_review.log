   109	def run_one_trajectory(family: str, n_init: int, budget: int, seed: int) -> dict:
   110	    backend = BocodeBotorchBackend()
   111	    backend.initialize(BackendConfig(problem_id=family, seed=seed, n_init=n_init))
   112	    loop = DecisionLoop(backend, total_budget=budget)
   113	    loop.run(AlwaysSurrogatePolicy(seed=0), max_rounds=budget + 5)
   114	    history = backend.get_history()
   115	    return {
   116	        "family": family, "seed": seed, "n_init": n_init,
   117	        "best": float(history.objectives[:, 0].max().item()),
   118	        "n_evals": len(history),
   119	        "dimension": int(history.X.shape[1]),
   120	        "termination": (loop.termination_reason.value
   121	                        if loop.termination_reason else None),
   122	    }

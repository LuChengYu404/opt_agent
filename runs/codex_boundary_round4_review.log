   211	    # explicit opt-in records the pooling decision
   212	    with _w.catch_warnings(record=True) as caught:
   213	        _w.simplefilter("always")
   214	        records = read_jsonl(path, version_policy="strict",
   215	                             pool_legacy=True)
   216	    assert len(records) == 2
   217	    assert not any("mixes" in str(w.message) for w in caught)

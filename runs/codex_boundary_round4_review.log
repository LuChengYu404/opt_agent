   178	def homogeneity(means: dict[str, float], variances: dict[str, float]) -> dict:
   179	    ms, vs = list(means.values()), list(variances.values())
   180	    fixed = (sum(m / v for m, v in zip(ms, vs))
   181	             / sum(1.0 / v for v in vs))
   182	    chi2 = sum((m - fixed) ** 2 / v for m, v in zip(ms, vs))
   183	    df = len(ms) - 1
   184	    return {"statistic": chi2, "df": df,
   185	            "p_value": 1.0 - scipy_stats.chi2.cdf(chi2, df=df),
   186	            "pooled": fixed,
   187	            "i2": max(0.0, (chi2 - df) / chi2) if chi2 > 0 else 0.0}

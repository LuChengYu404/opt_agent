     1	"""Boundary registry sync tests — enforce RESEARCH_BOUNDARY_GUIDE.md §2.4/§6.1.
     2	
     3	The point of these tests is that the action menu CANNOT drift from its
     4	boundary classification: adding/removing/reclassifying an action without
     5	touching both the registry and the guide §2.4 table turns the suite red.
     6	
     7	Verified columns (guide §2.4 schema): ActionType | 归类 | 子菜单 | 备注 —
     8	menu membership, boundary class, and submenu are compared strictly; the
     9	备注 column is free text and is only required to be non-empty. The parser
    10	fails closed on malformed tables (bad header, short rows, duplicate or
    11	unknown action rows).
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import sys
    17	from pathlib import Path
    18	
    19	import pytest
    20	
    21	sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    22	
    23	from opt_agent.actions.boundary_registry import (
    24	    BOUNDARY_CLASSES,
    25	    BOUNDARY_REGISTRY,
    26	    SUBMENUS,
    27	    RegistrySyncError,
    28	    boundary_class_of,
    29	    submenu_of,
    30	    verify_registry_sync,
    31	)
    32	from opt_agent.actions.models import ActionType
    33	
    34	GUIDE_PATH = (
    35	    Path(__file__).resolve().parents[1] / "docs" / "RESEARCH_BOUNDARY_GUIDE.md"
    36	)
    37	
    38	EXPECTED_HEADER = ("ActionType", "归类", "子菜单", "备注")
    39	
    40	
    41	def _parse_section_rows(section_text: str) -> dict[str, tuple[str, str, str]]:
    42	    """Strictly parse a §2.4-style markdown table.
    43	
    44	    Returns {action_value: (boundary_class, submenu, note)}. Raises
    45	    AssertionError on schema violations — the sync test must fail closed,
    46	    not skip quietly.
    47	    """
    48	    lines = section_text.splitlines()
    49	    header_hits = [i for i, ln in enumerate(lines)
    50	                   if ln.strip().startswith("| ActionType |")]
    51	    assert len(header_hits) == 1, (
    52	        f"expected exactly one §2.4 table, found {len(header_hits)}")
    53	    header_idx = header_hits[0]
    54	    header_cells = [c.strip() for c in lines[header_idx].strip().strip("|").split("|")]
    55	    assert tuple(header_cells[:4]) == EXPECTED_HEADER, (
    56	        f"unexpected §2.4 table header: {header_cells!r} "
    57	        f"(expected {EXPECTED_HEADER})"
    58	    )
    59	    rows: dict[str, tuple[str, str, str]] = {}
    60	    for line in lines[header_idx + 1:]:
    61	        stripped = line.strip()
    62	        if not stripped.startswith("|"):
    63	            break  # table ended
    64	        cells = [c.strip() for c in stripped.strip("|").split("|")]
    65	        if cells and cells[0].startswith("-"):
    66	            continue  # separator row
    67	        assert len(cells) == 4, (
    68	            f"malformed §2.4 row (needs exactly 4 cells, got {len(cells)}): "
    69	            f"{line!r}")
    70	        name, cls, submenu, note = cells
    71	        try:
    72	            action_value = ActionType[name].value
    73	        except KeyError:
    74	            raise AssertionError(
    75	                f"§2.4 row names unknown action {name!r}: {line!r}")
    76	        assert action_value not in rows, (
    77	            f"duplicate §2.4 row for {action_value!r}")
    78	        assert note, f"§2.4 row for {name} has an empty 备注 cell"
    79	        rows[action_value] = (cls, submenu, note)
    80	    return rows
    81	
    82	
    83	def _guide_section_2_4_rows() -> dict[str, tuple[str, str, str]]:
    84	    """Parse the guide's §2.4 table (reads the rendered document, so a doc
    85	    edit alone cannot desynchronize code from spec)."""
    86	    text = GUIDE_PATH.read_text(encoding="utf-8")
    87	    start = text.index("### 2.4")
    88	    end = text.index("\n## ", start)
    89	    return _parse_section_rows(text[start:end])
    90	
    91	
    92	# ---------------------------------------------------------------------------
    93	# Registry <-> menu
    94	# ---------------------------------------------------------------------------
    95	
    96	
    97	def test_registry_matches_action_type_menu_exactly():
    98	    verify_registry_sync()  # raises RegistrySyncError on any drift
    99	    assert set(BOUNDARY_REGISTRY) == set(ActionType)
   100	
   101	
   102	def test_registry_error_names_missing_action():
   103	    registry_entries = dict(BOUNDARY_REGISTRY)
   104	    missing = ActionType.STOP
   105	    del registry_entries[missing]
   106	    import opt_agent.actions.boundary_registry as mod
   107	
   108	    original = mod.BOUNDARY_REGISTRY
   109	    mod.BOUNDARY_REGISTRY = registry_entries
   110	    try:
   111	        with pytest.raises(RegistrySyncError) as exc:
   112	            verify_registry_sync()
   113	        assert missing.value in str(exc.value)
   114	    finally:
   115	        mod.BOUNDARY_REGISTRY = original
   116	
   117	

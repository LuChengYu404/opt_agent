   141	    spec_actions = {action_type for _, action_type, _ in ALL_CANDIDATE_SPECS}
   142	    assert spec_actions == set(BOUNDARY_REGISTRY), (
   143	        "factory/registry drift: factory-only="
   144	        f"{sorted(a.value for a in spec_actions - set(BOUNDARY_REGISTRY))}, "
   145	        "registry-only="

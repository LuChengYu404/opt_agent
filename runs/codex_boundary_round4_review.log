   150	# ---------------------------------------------------------------------------
   151	# Guide table parser (unit tests on synthetic tables)
   152	# ---------------------------------------------------------------------------
   153	
   154	_GOOD_SECTION = """
   155	### 2.4 表
   156	
   157	| ActionType | 归类 | 子菜单 | 备注 |
   158	|---|---|---|---|
   159	| GLOBAL_EXPLORATION | B2 | A_pt | 采样模式位 |
   160	| STOP | B1 | A_flow | 终止型动作 |
   161	"""
   162	
   163	_DUPLICATE_SECTION = _GOOD_SECTION.replace(
   164	    "| STOP | B1 | A_flow | 终止型动作 |",
   165	    "| GLOBAL_EXPLORATION | B2 | A_pt | 重复行 |")
   166	
   167	_UNKNOWN_SECTION = _GOOD_SECTION + "| NEW_SHINY_ACTION | B2 | A_pt | 未注册 |\n"
   168	
   169	_SHORT_ROW_SECTION = _GOOD_SECTION + "| UNCERTAINTY_SAMPLING | B2 |\n"
   170	
   171	_BAD_HEADER_SECTION = _GOOD_SECTION.replace("| 子菜单 |", "| 菜单 |")
   172	
   173	
   174	def test_parser_accepts_well_formed_table():
   175	    rows = _parse_section_rows(_GOOD_SECTION)
   176	    assert rows == {"global_exploration": ("B2", "A_pt", "采样模式位"),
   177	                    "stop": ("B1", "A_flow", "终止型动作")}
   178	

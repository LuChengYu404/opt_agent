/bin/bash -lc "python - <<'PY'
import json, math, statistics
from scipy.stats import chi2
p=json.load(open('runs/exp_meta_config_grid.json'))
rows=p['trajectories']; levels=p['levels']; ref=p['reference_level']; n=p['seeds']
by={(r['family'],r['seed'],r['n_init']):r['best'] for r in rows}
means={}; variances={}
for f in p['families']:
    d=p['dimensions'][f]; xs=[L/(2*d+1) for L in levels]; xm=statistics.fmean(xs); den=sum((x-xm)**2 for x in xs)
    slopes=[]; base=[]
    for s in range(n):
        ys=[by[(f,s,L)] for L in levels]; ym=statistics.fmean(ys)
        slopes.append(sum((x-xm)*(y-ym) for x,y in zip(xs,ys))/den)
        base.append(by[(f,s,ref)])
    scale=statistics.pstdev(base)
    theta=statistics.fmean(slopes)/scale
    jack=[]
    for omit in range(n):
        bb=[v for i,v in enumerate(slopes) if i"'!=omit]; xx=[v for i,v in enumerate(base) if i!=omit]
        jack.append(statistics.fmean(bb)/statistics.pstdev(xx))
    jbar=statistics.fmean(jack)
    v=(n-1)/n*sum((x-jbar)**2 for x in jack)
    means[f]=theta; variances[f]=v
    print(f, '"'theta',round(theta,4),'naive_se',round(statistics.stdev(slopes)/math.sqrt(n)/scale,4),'jack_se',round(math.sqrt(v),4))
pooled=sum(means[f]/variances[f] for f in means)/sum(1/variances[f] for f in means)
q=sum((means[f]-pooled)**2/variances[f] for f in means)
print('jackknife_Q',q,'p',chi2.sf(q,len(means)-1),'I2',max(0,(q-4)/q))

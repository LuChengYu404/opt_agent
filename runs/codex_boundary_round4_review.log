   124	
   125	def paired_bootstrap_ci(diffs: list[float], n_boot: int, seed: int = 0) -> list[float]:
   126	    rng = random.Random(seed)
   127	    n = len(diffs)
   128	    means = sorted(statistics.fmean(
   129	        [diffs[rng.randrange(n)] for _ in range(n)]) for _ in range(n_boot))
   130	    return [means[int(0.025 * n_boot)], means[int(0.975 * n_boot) - 1]]
   131	
   132	
   133	def ols_slope(xs: list[float], ys: list[float]) -> float:
   134	    mx, my = statistics.fmean(xs), statistics.fmean(ys)
   135	    num = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
   136	    den = sum((x - mx) ** 2 for x in xs)
   137	    return num / den if den else float("nan")
   138	
   139	
   140	def analyze_contrast(diffs: list[float], n_boot: int,
   141	                     disc_idx: list[int], conf_idx: list[int]) -> dict:
   142	    n = len(diffs)
   143	    mean = statistics.fmean(diffs)
   144	    sd = statistics.stdev(diffs)
   145	    se = sd / math.sqrt(n)
   146	    ci = paired_bootstrap_ci(diffs, n_boot)
   147	    t_stat = mean / se if se > 0 else float("nan")
   148	    p_t = (2.0 * (1.0 - scipy_stats.t.cdf(abs(t_stat), df=n - 1))
   149	           if se > 0 else float("nan"))
   150	
   151	    def half(idxs: list[int]) -> dict:
   152	        d = [diffs[i] for i in idxs]
   153	        m = statistics.fmean(d)
   154	        s = statistics.stdev(d)
   155	        c = paired_bootstrap_ci(d, max(1000, n_boot // 2), seed=1)
   156	        return {"mean": m, "sd": s, "ci95": c,
   157	                "ci_excludes_zero": (c[0] > 0) or (c[1] < 0)}
   158	
   159	    disc, conf = half(disc_idx), half(conf_idx)
   160	    return {
   161	        "n_pairs": n, "mean": mean, "sd": sd, "se": se,
   162	        "ci95": ci, "ci_excludes_zero": (ci[0] > 0) or (ci[1] < 0),
   163	        "ci_half_width": (ci[1] - ci[0]) / 2.0,
   164	        "paired_t": {"t": t_stat, "df": n - 1, "p_two_sided": p_t},
   165	        "cohens_dz": mean / sd if sd > 0 else float("nan"),
   166	        "mdd80": MDD_FACTOR * se,
   167	        # Equivalence bound (codex round-3 E2): a precise null requires the
   168	        # CI to lie ENTIRELY within +/- MISE*sd, not merely to be narrow
   169	        # (a narrow CI centered on a large effect is not a null).
   170	        "precise_enough_for_null": (ci[0] > -MISE * sd and ci[1] < MISE * sd)
   171	        if sd > 0 else False,
   172	        "discovery_half": disc, "confirmation_half": conf,
   173	        "confirmed": (disc["mean"] > 0) == (conf["mean"] > 0)
   174	                     and conf["ci_excludes_zero"],
   175	    }

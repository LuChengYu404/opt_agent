   186	    """A source mixing legacy and current stamps must not pool silently:
   187	    WARN warns, STRICT raises, pool_legacy=True records the opt-in."""
   188	    import warnings as _w
   189	
   190	    import opt_agent.dataset.versioning as ver
   191	    from opt_agent.dataset.decision_record import read_jsonl
   192	
   193	    monkeypatch.setattr(ver, "_legacy_warned", set())

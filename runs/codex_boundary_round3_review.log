     1	"""Shared candidate-action factory used by System-1 and the dataset layer.
     2	
     3	Per codex gpt-6-sol review 2026-09-23 (major M1):
     4	  - Candidates come from a SINGLE source — `ALL_CANDIDATE_SPECS` below.
     5	    `candidate_actions_for_state` filters that source by state; the
     6	    dataset generator's `full_candidates` reads the same source for
     7	    its unfiltered vocabulary. There is no second 8-action list.
     8	  - action_id is the lowercase `ActionType.value` (matches the dataset's
     9	    `full_candidates` vocabulary).
    10	  - Factory filters by remaining_budget, sample count, and surrogate fit
    11	    state so callers never need to validate budget feasibility separately.
    12	
    13	The factory returns a `dict[action_id, OptimizationAction]` so the consumer
    14	can:
    15	  - Build the `criteria` payload for Laya's `choice` primitive.
    16	  - Verify a chosen action_id is among the offered candidates.
    17	  - Hand the OptimizationAction directly to DecisionLoop.step().
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	from opt_agent.actions.models import ActionType, OptimizationAction
    23	from opt_agent.state import OptimizationState
    24	
    25	
    26	# Single source of truth for the candidate vocabulary. The first element
    27	# of each tuple is the action_id (stable string), the second is the
    28	# ActionType, and the third is the default parameter dict (without
    29	# `seed`, which callers add per-trajectory).
    30	#
    31	# `full_candidates()` reads this list unfiltered; the runtime factory
    32	# filters it by state.
    33	#
    34	# `BOUNDARY_TOL` is the default `tol` parameter for BOUNDARY_SAMPLING and
    35	# the metric threshold used by `state.extractor._boundary_coverage` to
    36	# decide whether a sampled point lies "near" a domain edge. Both must
    37	# reference the same constant so the coverage metric stays aligned with
    38	# the action's default search margin.
    39	BOUNDARY_TOL: float = 0.05
    40	
    41	ALL_CANDIDATE_SPECS: tuple[tuple[str, ActionType, dict], ...] = (
    42	    ("global_exploration",  ActionType.GLOBAL_EXPLORATION,    {"n_samples": 2}),
    43	    ("local_exploitation",  ActionType.LOCAL_EXPLOITATION,    {"step": 0.1}),
    44	    ("uncertainty_sampling", ActionType.UNCERTAINTY_SAMPLING, {"n_samples": 1}),
    45	    ("error_guided_sampling", ActionType.ERROR_GUIDED_SAMPLING, {"n_samples": 1}),
    46	    ("boundary_sampling",   ActionType.BOUNDARY_SAMPLING,     {"n_samples": 2, "tol": BOUNDARY_TOL}),
    47	    ("surrogate_acquisition", ActionType.SURROGATE_ACQUISITION, {}),
    48	    ("retrain_surrogate",   ActionType.RETRAIN_SURROGATE,     {}),
    49	    ("stop",                ActionType.STOP,                  {}),
    50	)
    51	
    52	
    53	def _make(action_type: ActionType, params: dict, seed: int) -> OptimizationAction:
    54	    """Build an OptimizationAction, threading `seed` through if the
    55	    action type accepts it. Mirrors the legacy `_ALLOWED_PARAMS` test
    56	    in `actions.models`."""
    57	    from opt_agent.actions.models import _ALLOWED_PARAMS
    58	    merged = dict(params)
    59	    if "seed" in _ALLOWED_PARAMS[action_type]:
    60	        merged["seed"] = seed
    61	    return OptimizationAction(action_type, merged)
    62	
    63	
    64	def sample_params(
    65	    action_type: ActionType,
    66	    remaining_budget: int,
    67	    rng: "random.Random",
    68	) -> dict:
    69	    """Generate a random parameter dict for an action that requires one.
    70	
    71	    Used by ``RandomPolicy`` and ``UniformPolicy`` (and any other
    72	    ablation policy that needs a budget-feasible random action). The
    73	    candidate vocabulary and per-action defaults are in
    74	    ``ALL_CANDIDATE_SPECS``; this function handles the four
    75	    parameterised sampling actions plus LOCAL_EXPLOITATION.
    76	
    77	    Param-free actions (``SURROGATE_ACQUISITION``, ``RETRAIN_SURROGATE``,
    78	    ``STOP``) return an empty dict — the caller should then ``_make`` it
    79	    directly without a ``sample_params`` step.
    80	    """
    81	    import random
    82	    if action_type == ActionType.GLOBAL_EXPLORATION:
    83	        n = rng.randint(1, min(3, remaining_budget))
    84	        return {"n_samples": n, "seed": rng.randint(0, 10_000)}
    85	    if action_type == ActionType.LOCAL_EXPLOITATION:
    86	        return {
    87	            "step": round(rng.uniform(0.01, 0.2), 4),
    88	            "seed": rng.randint(0, 10_000),
    89	        }
    90	    if action_type in (
    91	        ActionType.UNCERTAINTY_SAMPLING,
    92	        ActionType.ERROR_GUIDED_SAMPLING,
    93	    ):
    94	        n = rng.randint(1, min(3, remaining_budget))
    95	        return {"n_samples": n, "seed": rng.randint(0, 10_000)}
    96	    if action_type == ActionType.BOUNDARY_SAMPLING:
    97	        n = rng.randint(1, min(3, remaining_budget))
    98	        return {
    99	            "n_samples": n,
   100	            "tol": round(rng.uniform(0.01, 0.10), 4),
   101	            "seed": rng.randint(0, 10_000),
   102	        }
   103	    return {}
   104	
   105	
   106	def candidate_actions_for_state(
   107	    state: OptimizationState, *, seed: int = 0,
   108	) -> dict[str, OptimizationAction]:
   109	    """Build budget-valid candidates as {action_id: OptimizationAction}.
   110	
   111	    Filtering rules
   112	    ---------------
   113	    - remaining_budget <= 0  → only `stop` (forced termination).
   114	    - remaining_budget > 0   → always include `stop` so the policy may
   115	      terminate early. Emit at least one sampling action.
   116	    - surrogate not yet fitted → include `retrain_surrogate`.
   117	    - n_samples > 0           → include `local_exploitation` /
   118	      `error_guided_sampling` (need at least one observed point).
   119	    """
   120	    remaining = state.resource.remaining_budget
   121	    if remaining <= 0:
   122	        return {"stop": OptimizationAction(ActionType.STOP)}
   123	
   124	    action_seed = seed + state.sampling.n_samples
   125	    out: dict[str, OptimizationAction] = {}
   126	
   127	    for action_id, action_type, params in ALL_CANDIDATE_SPECS:
   128	        if action_id == "stop":
   129	            out["stop"] = OptimizationAction(ActionType.STOP)
   130	            continue
   131	        if action_id == "retrain_surrogate":
   132	            if not state.surrogate.is_current:
   133	                out[action_id] = _make(action_type, params, action_seed)
   134	            continue
   135	        if action_id in ("local_exploitation", "error_guided_sampling"):
   136	            if state.sampling.n_samples:
   137	                out[action_id] = _make(action_type, params, action_seed)
   138	            continue
   139	        # Sampling + surrogate_acquisition: cap n_samples at remaining budget.
   140	        merged = dict(params)
   141	        if "n_samples" in merged:
   142	            merged["n_samples"] = min(merged["n_samples"], remaining)
   143	        out[action_id] = _make(action_type, merged, action_seed)
   144	
   145	    return out


   170	def homogeneity(means: dict[str, float], variances: dict[str, float]) -> dict:
   171	    ms, vs = list(means.values()), list(variances.values())
   172	    fixed = (sum(m / v for m, v in zip(ms, vs))
   173	             / sum(1.0 / v for v in vs))
   174	    chi2 = sum((m - fixed) ** 2 / v for m, v in zip(ms, vs))
   175	    df = len(ms) - 1
   176	    return {"statistic": chi2, "df": df,
   177	            "p_value": 1.0 - scipy_stats.chi2.cdf(chi2, df=df),
   178	            "pooled": fixed,
   179	            "i2": max(0.0, (chi2 - df) / chi2) if chi2 > 0 else 0.0}

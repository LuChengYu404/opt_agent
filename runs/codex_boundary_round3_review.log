    46	def _finite_float(name: str, value: Any, lo: float, hi: float) -> float:
    47	    if not isinstance(value, (int, float)) or isinstance(value, bool):
    48	        raise ValueError(f"{name!r} must be a number; got {type(value).__name__}")
    49	    value = float(value)
    50	    if not math.isfinite(value):
    51	        raise ValueError(f"{name!r} must be finite; got {value}")
    52	    if not (lo <= value <= hi):
    53	        raise ValueError(f"{name!r} must lie in [{lo}, {hi}]; got {value}")
    54	    return value

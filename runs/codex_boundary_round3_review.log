   171	def analyze_family(family: str, diffs: list[float], n_boot: int,
   172	                   discovery: list[int], confirmation: list[int]) -> dict:
   173	    n = len(diffs)
   174	    mean = statistics.fmean(diffs)
   175	    sd = statistics.stdev(diffs)
   176	    se = sd / math.sqrt(n)
   177	    ci = paired_bootstrap_ci(diffs, n_boot=n_boot)
   178	    t_stat = mean / se
   179	    p_t = 2.0 * (1.0 - scipy_stats.t.cdf(abs(t_stat), df=n - 1))
   180	
   181	    def half(indices: list[int]) -> dict:
   182	        d = [diffs[i] for i in indices]
   183	        m = statistics.fmean(d)
   184	        s = statistics.stdev(d)
   185	        c = paired_bootstrap_ci(d, n_boot=max(1000, n_boot // 2), seed=1)
   186	        return {"mean": m, "sd": s, "ci95": c,
   187	                "ci_excludes_zero": (c[0] > 0) or (c[1] < 0)}
   188	
   189	    disc = half(discovery)
   190	    conf = half(confirmation)
   191	    sign_agree = (disc["mean"] > 0) == (conf["mean"] > 0)
   192	    confirmed = sign_agree and conf["ci_excludes_zero"]
   193	    return {
   194	        "n_pairs": n,
   195	        "mean_diff_large_minus_small": mean,
   196	        "sd_pair_diff": sd,
   197	        "se": se,
   198	        "ci95_bootstrap": ci,
   199	        "ci_excludes_zero": (ci[0] > 0) or (ci[1] < 0),
   200	        "ci_half_width": (ci[1] - ci[0]) / 2.0,
   201	        "paired_t": {"t": t_stat, "df": n - 1, "p_two_sided": p_t},
   202	        "cohens_dz": mean / sd,
   203	        "mdd80": MDD_FACTOR * se,
   204	        "precise_enough_for_null": ((ci[1] - ci[0]) / 2.0) < MISE * sd,
   205	        "discovery_half": disc,
   206	        "confirmation_half": conf,
   207	        "sign_agree_across_halves": sign_agree,
   208	        "confirmed_family": confirmed,
   209	        "best_config_by_mean": ("large" if mean > 0 else "small"),
   210	    }

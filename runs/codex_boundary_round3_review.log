    25	
    26	from __future__ import annotations
    27	
    28	from enum import Enum
    29	from typing import Any, Mapping
    30	
    31	HARNESS_VERSION = "h1"
    32	UTILITY_VERSION = "phase8.6b"
    33	
    34	# Stamps that may appear in historical records. "phase8.6b" doubles as the
    35	# current UTILITY_VERSION; harness_version was simply absent before h1.
    36	_KNOWN_PAST: dict[str, set[str]] = {
    37	    "harness": set(),  # h1 is the first stamped harness version
    38	    "utility": set(),  # phase8.6b is the first formalized utility version
    39	}
    40	
    41	
    42	class VersionStatus(str, Enum):
    43	    OK = "ok"
    44	    LEGACY = "legacy"
    45	    MISMATCH = "mismatch"
    46	
    47	
    48	class VersionPolicy(str, Enum):
    49	    """Pooling policy enforced at a dataset loading boundary (guide 4.5/6.6).
    50	
    51	    ALLOW  - no check (back-compat; implicit pooling decision is "unchecked").
    52	    WARN   - summarize LEGACY once per source (do-not-pool reminder) and warn
    53	             on MISMATCH, but keep reading.
    54	    STRICT - raise VersionPolicyError on the first MISMATCH; LEGACY still only
    55	             warns (legacy records are the repo's history, the policy makes
    56	             the pooling decision EXPLICIT rather than forbidding reads).
    57	    """
    58	
    59	    ALLOW = "allow"
    60	    WARN = "warn"
    61	    STRICT = "strict"
    62	
    63	
    64	class VersionPolicyError(ValueError):
    65	    """A record carries an unrecognized version stamp under STRICT policy."""
    66	
    67	
    68	_legacy_warned: set[str] = set()
    69	
    70	
    71	def enforce_record_versions(
    72	    record_metadata: Mapping[str, Any],
    73	    policy: str | VersionPolicy,
    74	    *,
    75	    record_id: str = "",
    76	    source: str = "",
    77	) -> dict[str, VersionStatus]:
    78	    """Apply a pooling policy to one record's metadata.
    79	
    80	    Returns the per-axis status (same shape as check_record_versions).
    81	    LEGACY warns at most once per (source, axis) to avoid spam on large
    82	    legacy datasets; MISMATCH raises under STRICT.
    83	    """
    84	    policy = VersionPolicy(policy)
    85	    status = check_record_versions(record_metadata)
    86	    if policy is VersionPolicy.ALLOW:
    87	        return status
    88	    import warnings
    89	
    90	    for axis, st in status.items():
    91	        key = f"{source}:{axis}"
    92	        if st is VersionStatus.LEGACY and key not in _legacy_warned:
    93	            _legacy_warned.add(key)
    94	            warnings.warn(
    95	                f"{source}: {axis} stamp is legacy/absent (record "
    96	                f"{record_id!r} first seen); pooling legacy records with "
    97	                f"current-version records requires an explicit same-data "
    98	                f"A/B note (guide 6.6 rule 1)",
    99	                stacklevel=2,
   100	            )
   101	        if st is VersionStatus.MISMATCH:
   102	            stamp = record_metadata.get(f"{axis}_version")
   103	            msg = (f"{source}: record {record_id!r} has unrecognized "
   104	                   f"{axis} stamp {stamp!r} (current: "
   105	                   f"{HARNESS_VERSION if axis == 'harness' else UTILITY_VERSION}); "
   106	                   f"refusing to pool under STRICT policy")
   107	            if policy is VersionPolicy.STRICT:
   108	                raise VersionPolicyError(msg)
   109	            warnings.warn(msg, stacklevel=2)
   110	    return status

   120	
   121	    Existing stamp keys are overwritten (the caller is generating records
   122	    with the current code, whose stamps ARE the current constants).
   123	    """
   124	    out = dict(metadata) if metadata else {}
   125	    out["harness_version"] = harness_version
   126	    out["utility_version"] = utility_version

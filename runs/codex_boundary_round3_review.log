    88	        phase = phase_of_ratio(
    89	            float(r["state"]["resource"]["remaining_budget_ratio"])
    90	        )
    91	        pred_vec = rf.predict([extract_features(r["state"], phase)])[0]
    92	        pred = dict(zip(sorted(gold), pred_vec))
    93	        c, t, m = _rf_pairwise_and_top1(pred, gold)
    94	        out[r["id"]] = (c, t, m)
    95	    return out

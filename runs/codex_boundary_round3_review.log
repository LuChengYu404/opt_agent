    81	def rf_per_record(rf, scales, val_dicts: list[dict]) -> dict[str, tuple[int, int, int]]:
    82	    """record id → (correct_pairs, total_pairs, top1_match) for the RF."""
    83	    out: dict[str, tuple[int, int, int]] = {}

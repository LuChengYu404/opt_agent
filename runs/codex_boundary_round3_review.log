    70	def _guide_section_2_4_rows() -> dict[str, tuple[str, str, str]]:
    71	    """Parse the guide §2.4 markdown table -> {action_value: (class, submenu-ish, row)}.
    72	
    73	    The table columns are: ActionType | 归类 | 备注. This deliberately parses
    74	    the rendered document rather than importing constants, so a doc edit
    75	    alone cannot desynchronize code from spec.
    76	    """
    77	    text = GUIDE_PATH.read_text(encoding="utf-8")
    78	    start = text.index("### 2.4")
    79	    end = text.index("\n## ", start)
    80	    section = text[start:end]
    81	    lines = section.splitlines()
    82	    header_idx = next(
    83	        i for i, ln in enumerate(lines) if ln.strip().startswith("| ActionType |")
    84	    )
    85	    rows: dict[str, tuple[str, str, str]] = {}
    86	    for line in lines[header_idx + 1:]:
    87	        stripped = line.strip()
    88	        if not stripped.startswith("|"):
    89	            break  # table ended
    90	        cells = [c.strip() for c in stripped.strip("|").split("|")]
    91	        if len(cells) < 2 or cells[0].startswith("-"):
    92	            continue  # separator row
    93	        # The guide table names enum MEMBERS (GLOBAL_EXPLORATION); normalize
    94	        # to values (global_exploration) for comparison with ActionType.
    95	        try:
    96	            action_value = ActionType[cells[0]].value
    97	        except KeyError:
    98	            action_value = cells[0]
    99	        rows[action_value] = (cells[1], cells[2] if len(cells) > 2 else "", line)
   100	    return rows

    71	        )
    72	        X.append(extract_features(r["state"], phase))
    73	        Y.append([utils[a] for a in sorted(utils)])
    74	    rf = RandomForestRegressor(
    75	        n_estimators=200, max_depth=8, min_samples_leaf=5, random_state=0, n_jobs=-1

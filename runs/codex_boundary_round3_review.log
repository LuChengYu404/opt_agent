   159	def paired_bootstrap_ci(diffs: list[float], n_boot: int = 5000,
   160	                        seed: int = 0) -> list[float]:
   161	    rng = random.Random(seed)
   162	    n = len(diffs)
   163	    means = []
   164	    for _ in range(n_boot):
   165	        sample = [diffs[rng.randrange(n)] for _ in range(n)]
   166	        means.append(statistics.fmean(sample))
   167	    means.sort()
   168	    return [means[int(0.025 * n_boot)], means[int(0.975 * n_boot) - 1]]

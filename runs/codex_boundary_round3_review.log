   213	def interaction_test(per_family_mean: dict[str, float],
   214	                     per_family_var: dict[str, float]) -> dict:
   215	    """Homogeneity of per-family advantages (continuous Cochran's Q).
   216	
   217	    H0: Delta_f identical across families; Wald X^2 ~ chi^2_{F-1}.
   218	    """
   219	    means = list(per_family_mean.values())
   220	    variances = list(per_family_var.values())
   221	    fixed = sum(m / v for m, v in zip(means, variances)) / \
   222	        sum(1.0 / v for v in variances)  # inverse-variance weighted common mean
   223	    chi2 = sum((m - fixed) ** 2 / v for m, v in zip(means, variances))
   224	    df = len(means) - 1
   225	    p = 1.0 - scipy_stats.chi2.cdf(chi2, df=df)
   226	    i2 = max(0.0, (chi2 - df) / chi2) if chi2 > 0 else 0.0
   227	    return {
   228	        "statistic": chi2,
   229	        "df": df,
   230	        "p_value": p,
   231	        "pooled_common_delta": fixed,
   232	        "heterogeneity_i2": i2,
   233	        "null": "Delta_1 == ... == Delta_F (no family x config interaction)",
   234	    }

     1	"""EXP-META-CONFIG-SCREEN — meta-level pre-screen (guide §10.3 / codex E2).
     2	
     3	Question (predeclared BEFORE running): before building any meta-level
     4	supervision pipeline (configuration-level counterfactuals), is there
     5	DETECTABLE configuration-conditionality on the current panel? Guide §4.4
     6	warns the meta-level advantage can be nonpositive; this screen is the cheap
     7	paired test the round-1 review asked for.
     8	
     9	Design:
    10	  - Config axis: initial design size n_init ∈ {5 ("small", the harness
    11	    default), 12 ("large")} — a design-phase configuration per guide §1.2
    12	    (初始设计/预算切分), the only meta-level knob the current backend
    13	    exposes without new model code. Total budget FIXED at 30 evaluations
    14	    for both arms (same spend; different split between design and BO).
    15	  - Inner policy pinned to AlwaysSurrogate in both arms (isolates the
    16	    config effect from policy effects).
    17	  - Pairing: same family + same seed → same scrambled Sobol stream
    18	    (nested: the first 5 points of draw(12) equal draw(5)).
    19	  - Endpoint: terminal best objective (backend MAXIMIZES).
    20	
    21	Readouts:
    22	  1. Per-family paired advantage Δ_f = E_seed[y_large − y_small] with
    23	     seed-level bootstrap CI.
    24	  2. Cross-family meta-D on family-standardized utilities:
    25	     ū_{a,f} = mean_seed[y_{a,f}] / s_f (s_f = pooled std of both arms),
    26	     D_meta = E_f[max_a ū_{a,f}] − max_a E_f[ū_{a,f}]. With two configs
    27	     this equals (E_f|d_f| − |E_f d_f|)/2 — it is > 0 iff the per-family
    28	     advantage varies across families beyond its mean (interaction).
    29	  3. Bootstrap over seeds within family for both.
    30	
    31	Predeclared decision rule:
    32	  - SCREEN POSITIVE (config-conditionality exists → meta pipeline justified
    33	    on this axis) if ≥2 families have CI-excluding-zero Δ_f with OPPOSITE
    34	    signs, or D_meta's bootstrap CI excludes zero.
    35	  - SCREEN NEGATIVE otherwise: no detectable meta advantage at this
    36	    axis/panel → per guide §4.4, do NOT build meta supervision on this
    37	    axis; report and stop.
    38	
    39	Hardware: CPU-bound trajectories ~10 s each; 5 families × 20 seeds × 2
    40	configs = 200 trajectories, parallel pool.
    41	"""
    42	from __future__ import annotations
    43	
    44	import argparse
    45	import json
    46	import random
    47	import statistics
    48	import sys
    49	import time
    50	from pathlib import Path
    51	
    52	ROOT = Path(__file__).resolve().parents[1]
    53	sys.path.insert(0, str(ROOT / "src"))
    54	
    55	from opt_agent.actions import candidate_actions_for_state
    56	from opt_agent.backend.bocode_botorch import BackendConfig, BocodeBotorchBackend
    57	from opt_agent.loop.decision_loop import DecisionLoop
    58	
    59	CONFIGS = {"small": 5, "large": 12}
    60	
    61	
    62	def _worker_init() -> None:
    63	    """Cap torch threads per worker (oversubscription guard, repo precedent:
    64	    the longhorizon driver hit load 315 with default threads)."""
    65	    import torch
    66	
    67	    torch.set_num_threads(1)
    68	
    69	
    70	class AlwaysSurrogatePolicy:
    71	    """Pinned inner policy: always SURROGATE_ACQUISITION."""
    72	
    73	    def __init__(self, seed: int = 0) -> None:
    74	        self.seed = seed
    75	
    76	    def select_action(self, state, backend=None):
    77	        choices = candidate_actions_for_state(state, seed=self.seed)
    78	        if "surrogate_acquisition" in choices:
    79	            return choices["surrogate_acquisition"]
    80	        return next(iter(choices.values()))
    81	
    82	
    83	def run_one_trajectory(family: str, config_name: str, budget: int,
    84	                       seed: int) -> dict:
    85	    """Run one (family, config, seed) episode; return terminal best + n_evals."""
    86	    backend = BocodeBotorchBackend()
    87	    backend.initialize(BackendConfig(
    88	        problem_id=family,
    89	        seed=seed,
    90	        n_init=CONFIGS[config_name],
    91	    ))
    92	    loop = DecisionLoop(backend, total_budget=budget)
    93	    loop.run(AlwaysSurrogatePolicy(seed=0), max_rounds=budget + 5)
    94	    history = backend.get_history()
    95	    return {
    96	        "best": float(history.objectives[:, 0].max().item()),
    97	        "n_evals": len(history),
    98	        "termination": (
    99	            loop.termination_reason.value if loop.termination_reason else None
   100	        ),
   101	    }
   102	
   103	
   104	def paired_bootstrap_ci(diffs: list[float], n_boot: int = 5000,
   105	                        seed: int = 0) -> list[float]:
   106	    rng = random.Random(seed)
   107	    n = len(diffs)
   108	    means = []
   109	    for _ in range(n_boot):
   110	        sample = [diffs[rng.randrange(n)] for _ in range(n)]
   111	        means.append(statistics.fmean(sample))
   112	    means.sort()
   113	    lo = means[int(0.025 * n_boot)]
   114	    hi = means[int(0.975 * n_boot) - 1]
   115	    return [lo, hi]
   116	
   117	
   118	def main() -> int:
   119	    parser = argparse.ArgumentParser()
   120	    parser.add_argument("--families", nargs="+",
   121	                        default=["Branin", "Hartmann", "Ackley",
   122	                                 "SixHumpCamel", "Rastrigin"])
   123	    parser.add_argument("--seeds", type=int, default=20)
   124	    parser.add_argument("--budget", type=int, default=30)
   125	    parser.add_argument("--workers", type=int, default=24)
   126	    parser.add_argument("--n-boot", type=int, default=5000)
   127	    parser.add_argument("--output", type=Path,
   128	                        default=ROOT / "runs" / "exp_meta_config_screen.json")
   129	    args = parser.parse_args()
   130	
   131	    jobs = [(fam, cfg, args.budget, seed)
   132	            for fam in args.families
   133	            for seed in range(args.seeds)
   134	            for cfg in CONFIGS]
   135	    print(f"Total jobs: {len(jobs)} = {len(args.families)} families × "
   136	          f"{args.seeds} seeds × {len(CONFIGS)} configs {sorted(CONFIGS)}")
   137	    print(f"Budget {args.budget} (design+BO), pinned AlwaysSurrogate policy")
   138	
   139	    import multiprocessing as mp
   140	    t0 = time.monotonic()
   141	    with mp.Pool(args.workers, initializer=_worker_init) as pool:
   142	        results = pool.starmap(run_one_trajectory, jobs)
   143	    elapsed = time.monotonic() - t0
   144	    print(f"Done in {elapsed:.1f}s ({len(jobs)/elapsed:.1f} trajectories/s)")
   145	
   146	    # Reshape: results follow the job order (family, seed, config).
   147	    by_key: dict[tuple, dict] = {}
   148	    idx = 0
   149	    for fam in args.families:
   150	        for seed in range(args.seeds):
   151	            for cfg in CONFIGS:
   152	                by_key[(fam, seed, cfg)] = results[idx]
   153	                idx += 1
   154	
   155	    # Sanity: both arms spent the same budget.
   156	    n_evals = {r["n_evals"] for r in results}
   157	    print(f"n_evals observed: {sorted(n_evals)}")
   158	
   159	    # 1. Per-family paired advantage.
   160	    per_family = {}
   161	    for fam in args.families:
   162	        diffs = [by_key[(fam, s, "large")]["best"] - by_key[(fam, s, "small")]["best"]
   163	                 for s in range(args.seeds)]
   164	        mean = statistics.fmean(diffs)
   165	        ci = paired_bootstrap_ci(diffs, n_boot=args.n_boot)
   166	        per_family[fam] = {
   167	            "mean_diff_large_minus_small": mean,
   168	            "ci95": ci,
   169	            "ci_excludes_zero": (ci[0] > 0) or (ci[1] < 0),
   170	            "per_seed_diffs": diffs,
   171	            "best_config_by_mean": ("large" if mean > 0 else "small"),
   172	        }
   173	
   174	    # 2. Cross-family meta-D on standardized utilities.
   175	    fam_stats = {}
   176	    for fam in args.families:
   177	        y_small = [by_key[(fam, s, "small")]["best"] for s in range(args.seeds)]
   178	        y_large = [by_key[(fam, s, "large")]["best"] for s in range(args.seeds)]
   179	        pooled = y_small + y_large
   180	        s_f = statistics.pstdev(pooled)
   181	        fam_stats[fam] = {
   182	            "u_small": statistics.fmean(y_small) / s_f,
   183	            "u_large": statistics.fmean(y_large) / s_f,
   184	            "s_f": s_f,
   185	        }
   186	    u = {fam: {"small": st["u_small"], "large": st["u_large"]}
   187	         for fam, st in fam_stats.items()}
   188	
   189	    def d_meta(u_map: dict) -> float:
   190	        fams = list(u_map)
   191	        e_max = statistics.fmean(max(u_map[f][a] for a in CONFIGS) for f in fams)
   192	        max_e = max(statistics.fmean(u_map[f][a] for f in fams) for a in CONFIGS)
   193	        return e_max - max_e
   194	
   195	    d_meta_point = d_meta(u)
   196	
   197	    # Bootstrap: resample seeds within each family, recompute u and D_meta.
   198	    rng = random.Random(0)
   199	    boots = []
   200	    for _ in range(args.n_boot):
   201	        u_b = {}
   202	        for fam in args.families:
   203	            picks = [rng.randrange(args.seeds) for _ in range(args.seeds)]
   204	            ys = [by_key[(fam, p, "small")]["best"] for p in picks]
   205	            yl = [by_key[(fam, p, "large")]["best"] for p in picks]
   206	            pooled = ys + yl
   207	            s_b = statistics.pstdev(pooled) or 1.0
   208	            u_b[fam] = {"small": statistics.fmean(ys) / s_b,
   209	                        "large": statistics.fmean(yl) / s_b}
   210	        boots.append(d_meta(u_b))
   211	    boots.sort()
   212	    d_meta_ci = [boots[int(0.025 * args.n_boot)],
   213	                 boots[int(0.975 * args.n_boot) - 1]]
   214	
   215	    # 3. Predeclared decision rule.
   216	    sig = [f for f in args.families if per_family[f]["ci_excludes_zero"]]
   217	    pos = [f for f in sig if per_family[f]["mean_diff_large_minus_small"] > 0]
   218	    neg = [f for f in sig if per_family[f]["mean_diff_large_minus_small"] < 0]
   219	    opposite = bool(pos) and bool(neg)
   220	    d_meta_sig = (d_meta_ci[0] > 0) or (d_meta_ci[1] < 0)
   221	    verdict = "POSITIVE" if (opposite or d_meta_sig) else "NEGATIVE"
   222	
   223	    payload = {
   224	        "experiment": "exp_meta_config_screen",
   225	        "predeclared_rule": (
   226	            "POSITIVE iff (>=2 families CI-significant in opposite directions) "
   227	            "or (meta-D bootstrap CI excludes zero); else NEGATIVE"
   228	        ),
   229	        "families": args.families,
   230	        "seeds": args.seeds,
   231	        "budget": args.budget,
   232	        "configs": CONFIGS,
   233	        "policy": "AlwaysSurrogate (pinned)",
   234	        "n_evals_observed": sorted(n_evals),
   235	        "per_family": {
   236	            fam: {k: v for k, v in row.items() if k != "per_seed_diffs"}
   237	            for fam, row in per_family.items()
   238	        },
   239	        "meta_d": {
   240	            "point": d_meta_point,

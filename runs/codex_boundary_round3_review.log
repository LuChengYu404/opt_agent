    40	
    41	def _parse_section_rows(section_text: str) -> dict[str, tuple[str, str, str]]:
    42	    """Strictly parse a §2.4-style markdown table.
    43	
    44	    Returns {action_value: (boundary_class, submenu, note)}. Raises
    45	    AssertionError on schema violations — the sync test must fail closed,
    46	    not skip quietly.
    47	    """
    48	    lines = section_text.splitlines()
    49	    header_idx = next(
    50	        (i for i, ln in enumerate(lines)
    51	         if ln.strip().startswith("| ActionType |")), None)
    52	    assert header_idx is not None, "guide §2.4 table header not found"
    53	    header_cells = [c.strip() for c in lines[header_idx].strip().strip("|").split("|")]
    54	    assert tuple(header_cells[:4]) == EXPECTED_HEADER, (
    55	        f"unexpected §2.4 table header: {header_cells!r} "
    56	        f"(expected {EXPECTED_HEADER})"
    57	    )
    58	    rows: dict[str, tuple[str, str, str]] = {}
    59	    for line in lines[header_idx + 1:]:
    60	        stripped = line.strip()
    61	        if not stripped.startswith("|"):
    62	            break  # table ended
    63	        cells = [c.strip() for c in stripped.strip("|").split("|")]
    64	        if cells and cells[0].startswith("-"):
    65	            continue  # separator row
    66	        assert len(cells) >= 4, f"malformed §2.4 row (needs 4 cells): {line!r}"
    67	        name, cls, submenu, note = cells[0], cells[1], cells[2], cells[3]
    68	        try:
    69	            action_value = ActionType[name].value
    70	        except KeyError:
    71	            raise AssertionError(
    72	                f"§2.4 row names unknown action {name!r}: {line!r}")
    73	        assert action_value not in rows, (
    74	            f"duplicate §2.4 row for {action_value!r}")
    75	        assert note, f"§2.4 row for {name} has an empty 备注 cell"
    76	        rows[action_value] = (cls, submenu, note)
    77	    return rows
    78	
    79	
    80	def _guide_section_2_4_rows() -> dict[str, tuple[str, str, str]]:
    81	    """Parse the guide's §2.4 table (reads the rendered document, so a doc
    82	    edit alone cannot desynchronize code from spec)."""
    83	    text = GUIDE_PATH.read_text(encoding="utf-8")
    84	    start = text.index("### 2.4")
    85	    end = text.index("\n## ", start)
    86	    return _parse_section_rows(text[start:end])

   136	def analyze_contrast(diffs: list[float], n_boot: int,
   137	                     disc_idx: list[int], conf_idx: list[int]) -> dict:
   138	    n = len(diffs)
   139	    mean = statistics.fmean(diffs)
   140	    sd = statistics.stdev(diffs)
   141	    se = sd / math.sqrt(n)
   142	    ci = paired_bootstrap_ci(diffs, n_boot)
   143	    t_stat = mean / se if se > 0 else float("nan")
   144	    p_t = (2.0 * (1.0 - scipy_stats.t.cdf(abs(t_stat), df=n - 1))
   145	           if se > 0 else float("nan"))
   146	
   147	    def half(idxs: list[int]) -> dict:
   148	        d = [diffs[i] for i in idxs]
   149	        m = statistics.fmean(d)
   150	        s = statistics.stdev(d)
   151	        c = paired_bootstrap_ci(d, max(1000, n_boot // 2), seed=1)
   152	        return {"mean": m, "sd": s, "ci95": c,
   153	                "ci_excludes_zero": (c[0] > 0) or (c[1] < 0)}
   154	
   155	    disc, conf = half(disc_idx), half(conf_idx)
   156	    return {
   157	        "n_pairs": n, "mean": mean, "sd": sd, "se": se,
   158	        "ci95": ci, "ci_excludes_zero": (ci[0] > 0) or (ci[1] < 0),
   159	        "ci_half_width": (ci[1] - ci[0]) / 2.0,
   160	        "paired_t": {"t": t_stat, "df": n - 1, "p_two_sided": p_t},
   161	        "cohens_dz": mean / sd if sd > 0 else float("nan"),
   162	        "mdd80": MDD_FACTOR * se,
   163	        "precise_enough_for_null": ((ci[1] - ci[0]) / 2.0) < MISE * sd if sd > 0 else False,
   164	        "discovery_half": disc, "confirmation_half": conf,
   165	        "confirmed": (disc["mean"] > 0) == (conf["mean"] > 0)
   166	                     and conf["ci_excludes_zero"],
   167	    }

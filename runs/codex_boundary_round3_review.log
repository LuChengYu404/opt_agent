     1	"""Dataset / harness version stamps — code-side half of guide §4.5 + §6.6.
     2	
     3	Discipline (RESEARCH_BOUNDARY_GUIDE.md):
     4	
     5	- ``HARNESS_VERSION`` freezes the measurement system: observation format
     6	  (state features), action menu, and label pipeline. Any change to state
     7	  features, the ActionType menu, or any S-class supervision-defining
     8	  component (§6.6) REQUIRES a bump.
     9	- ``UTILITY_VERSION`` is the finer stamp: it tracks the S-class label
    10	  definition only (utility weights/scales, continuation policy, rollout
    11	  horizon, gold temperature, action-subset quota, replicate count).
    12	
    13	Reading rule (:func:`check_record_versions`):
    14	
    15	- ``OK``       — record carries the current stamps; poolable.
    16	- ``LEGACY``   — stamp missing (records predate the mechanism) or holds a
    17	  known-past value: readable, but must not be pooled with current-version
    18	  records without an explicit same-data A/B note (§6.6 rule 1).
    19	- ``MISMATCH`` — stamp is not a recognized value (e.g. a future version
    20	  read by older code): refuse to pool.
    21	
    22	Known-past values are listed in ``_KNOWN_PAST``; extend it when bumping
    23	either constant so old data reads as LEGACY rather than MISMATCH.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	from enum import Enum
    29	from typing import Any, Mapping
    30	
    31	HARNESS_VERSION = "h1"
    32	UTILITY_VERSION = "phase8.6b"
    33	
    34	# Stamps that may appear in historical records. "phase8.6b" doubles as the
    35	# current UTILITY_VERSION; harness_version was simply absent before h1.
    36	_KNOWN_PAST: dict[str, set[str]] = {
    37	    "harness": set(),  # h1 is the first stamped harness version
    38	    "utility": set(),  # phase8.6b is the first formalized utility version
    39	}
    40	
    41	
    42	class VersionStatus(str, Enum):
    43	    OK = "ok"
    44	    LEGACY = "legacy"
    45	    MISMATCH = "mismatch"
    46	
    47	
    48	class VersionPolicy(str, Enum):
    49	    """Pooling policy enforced at a dataset loading boundary (guide 4.5/6.6).
    50	
    51	    ALLOW  - no check (back-compat; implicit pooling decision is "unchecked").
    52	    WARN   - summarize LEGACY once per source (do-not-pool reminder) and warn
    53	             on MISMATCH, but keep reading.
    54	    STRICT - raise VersionPolicyError on the first MISMATCH; LEGACY still only
    55	             warns (legacy records are the repo's history, the policy makes
    56	             the pooling decision EXPLICIT rather than forbidding reads).
    57	    """
    58	
    59	    ALLOW = "allow"
    60	    WARN = "warn"
    61	    STRICT = "strict"
    62	
    63	
    64	class VersionPolicyError(ValueError):
    65	    """A record carries an unrecognized version stamp under STRICT policy."""
    66	
    67	
    68	_legacy_warned: set[str] = set()
    69	
    70	
    71	def enforce_record_versions(
    72	    record_metadata: Mapping[str, Any],
    73	    policy: str | VersionPolicy,
    74	    *,
    75	    record_id: str = "",
    76	    source: str = "",
    77	) -> dict[str, VersionStatus]:
    78	    """Apply a pooling policy to one record's metadata.
    79	
    80	    Returns the per-axis status (same shape as check_record_versions).
    81	    LEGACY warns at most once per (source, axis) to avoid spam on large
    82	    legacy datasets; MISMATCH raises under STRICT.
    83	    """
    84	    policy = VersionPolicy(policy)
    85	    status = check_record_versions(record_metadata)
    86	    if policy is VersionPolicy.ALLOW:
    87	        return status
    88	    import warnings
    89	
    90	    for axis, st in status.items():
    91	        key = f"{source}:{axis}"
    92	        if st is VersionStatus.LEGACY and key not in _legacy_warned:
    93	            _legacy_warned.add(key)
    94	            warnings.warn(
    95	                f"{source}: {axis} stamp is legacy/absent (record "
    96	                f"{record_id!r} first seen); pooling legacy records with "
    97	                f"current-version records requires an explicit same-data "
    98	                f"A/B note (guide 6.6 rule 1)",
    99	                stacklevel=2,
   100	            )
   101	        if st is VersionStatus.MISMATCH:
   102	            stamp = record_metadata.get(f"{axis}_version")
   103	            msg = (f"{source}: record {record_id!r} has unrecognized "
   104	                   f"{axis} stamp {stamp!r} (current: "
   105	                   f"{HARNESS_VERSION if axis == 'harness' else UTILITY_VERSION}); "
   106	                   f"refusing to pool under STRICT policy")
   107	            if policy is VersionPolicy.STRICT:
   108	                raise VersionPolicyError(msg)
   109	            warnings.warn(msg, stacklevel=2)
   110	    return status
   111	
   112	
   113	def stamp_metadata(
   114	    metadata: Mapping[str, Any] | None,
   115	    *,
   116	    harness_version: str = HARNESS_VERSION,
   117	    utility_version: str = UTILITY_VERSION,
   118	) -> dict[str, Any]:
   119	    """Return a copy of ``metadata`` with both version stamps applied.
   120	
   121	    Existing stamp keys are overwritten (the caller is generating records
   122	    with the current code, whose stamps ARE the current constants).
   123	    """
   124	    out = dict(metadata) if metadata else {}
   125	    out["harness_version"] = harness_version
   126	    out["utility_version"] = utility_version
   127	    return out
   128	
   129	
   130	def check_record_versions(
   131	    record_metadata: Mapping[str, Any],
   132	) -> dict[str, VersionStatus]:
   133	    """Classify a record's stamps against the current constants.
   134	
   135	    ``record_metadata`` is the ``metadata`` dict of a DecisionRecord (the
   136	    stamps live at its top level; see the generator).
   137	    """
   138	    return {
   139	        "harness": _status(record_metadata.get("harness_version"),
   140	                           HARNESS_VERSION, "harness"),
   141	        "utility": _status(record_metadata.get("utility_version"),
   142	                           UTILITY_VERSION, "utility"),
   143	    }
   144	
   145	
   146	def _status(stamp: Any, current: str, axis: str) -> VersionStatus:
   147	    if stamp == current:
   148	        return VersionStatus.OK
   149	    if stamp is None or stamp in _KNOWN_PAST.get(axis, set()):
   150	        return VersionStatus.LEGACY
   151	    return VersionStatus.MISMATCH
     1	"""Optimization Decision Dataset (Phase 7).
     2	
     3	Per MASTER_PLAN.md §11 and codex (gpt-5.6-sol) review 2025-09-23.
     4	
     5	JSONL schema (one record per decision point):
     6	
     7	    {
     8	      "id": "branin:0:0:3",
     9	      "problem": {"family": "branin", "dimension": 2, "seed": 0},
    10	      "state": {...dataclasses.asdict(OptimizationState)...},
    11	      "candidate_actions": [
    12	          {"action_id": "global_exploration", "type": "global_exploration", "params": {...}},
    13	          ...
    14	      ],
    15	      "gold_probs": {"action_id": probability, ...},
    16	      "rollout_results": {
    17	          "action_id": {
    18	              "status": "valid|invalid",
    19	              "utility": float,
    20	              "delta_optimization": float,
    21	              "delta_surrogate": float|null,
    22	              "delta_coverage": float,
    23	              "n_new_samples": int,
    24	              "n_model_fits": int,
    25	              "error": str|null
    26	          }, ...
    27	      },
    28	      "temperature": float,
    29	      "metadata": {...}
    30	    }
    31	
    32	Vocabulary invariant: keys in gold_probs and rollout_results are identical
    33	(set equality), and both are a subset of the candidate_actions ids. With
    34	partial rollouts (rollout_action_subsample < 8) only a deterministic
    35	k-subset of the candidates is rolled out and labeled —
    36	metadata["partial_rollout"] records which ids; full datasets are set-equal
    37	across all three fields. This is enforced by the generator and verified by
    38	tests.
    39	"""
    40	
    41	from __future__ import annotations
    42	
    43	import json
    44	import math
    45	from dataclasses import asdict, dataclass, field, is_dataclass
    46	from enum import Enum
    47	from pathlib import Path
    48	from typing import Any, Iterable, Iterator, Mapping
    49	
    50	
    51	@dataclass(frozen=True)
    52	class DecisionRecord:
    53	    """A single (state, candidate_actions, gold_probs) record for System-1 training."""
    54	    id: str
    55	    problem: dict[str, Any]
    56	    state: dict[str, Any]
    57	    candidate_actions: list[dict[str, Any]]
    58	    gold_probs: dict[str, float]
    59	    rollout_results: dict[str, dict[str, Any]]
    60	    temperature: float
    61	    metadata: dict[str, Any] = field(default_factory=dict)
    62	
    63	
    64	def _json_safe(value: Any) -> Any:
    65	    """Recursively convert dataclasses, Enums, NaN/Inf floats to JSON-safe types."""
    66	    if is_dataclass(value) and not isinstance(value, type):
    67	        return _json_safe(asdict(value))
    68	    if isinstance(value, Enum):
    69	        return value.value
    70	    if isinstance(value, float):
    71	        return value if math.isfinite(value) else None
    72	    if isinstance(value, Mapping):
    73	        return {str(k): _json_safe(v) for k, v in value.items()}
    74	    if isinstance(value, (list, tuple)):
    75	        return [_json_safe(v) for v in value]
    76	    if value is None or isinstance(value, (str, int, bool)):
    77	        return value
    78	    raise TypeError(f"Unsupported JSON value: {type(value).__name__}")
    79	
    80	
    81	def write_jsonl(records: Iterable[DecisionRecord], path: Path) -> None:
    82	    """Write DecisionRecords to JSONL. NaN/Inf are sanitized to None."""
    83	    path = Path(path)
    84	    path.parent.mkdir(parents=True, exist_ok=True)
    85	    with path.open("w", encoding="utf-8", newline="\n") as stream:
    86	        for record in records:
    87	            payload = _json_safe(record)
    88	            stream.write(
    89	                json.dumps(
    90	                    payload,
    91	                    allow_nan=False,
    92	                    sort_keys=True,
    93	                    separators=(",", ":"),
    94	                )
    95	            )
    96	            stream.write("\n")
    97	
    98	
    99	def iter_jsonl(path: Path) -> Iterator[DecisionRecord]:
   100	    """Read DecisionRecords from JSONL. Skips blank lines."""
   101	    path = Path(path)
   102	    with path.open("r", encoding="utf-8") as stream:
   103	        for line_number, line in enumerate(stream, 1):
   104	            if not line.strip():
   105	                continue
   106	            try:
   107	                yield DecisionRecord(**json.loads(line))
   108	            except Exception as exc:
   109	                raise ValueError(
   110	                    f"{path}:{line_number}: invalid DecisionRecord"
   111	                ) from exc
   112	
   113	
   114	def read_jsonl(
   115	    path: Path, *, version_policy: str = "allow"
   116	) -> list[DecisionRecord]:
   117	    """Materialize records from JSONL, enforcing a version-pooling policy.
   118	
   119	    The version policy (guide 4.5/6.6) is the explicit pooling decision at
   120	    the loading boundary: "allow" (default, historical behavior), "warn"
   121	    (summarize legacy, warn on unrecognized stamps), or "strict" (raise on
   122	    unrecognized stamps). See opt_agent.dataset.versioning for semantics.
   123	    """
   124	    from opt_agent.dataset.versioning import enforce_record_versions
   125	
   126	    records = list(iter_jsonl(path))
   127	    if version_policy != "allow":
   128	        for record in records:
   129	            enforce_record_versions(
   130	                record.metadata,
   131	                version_policy,
   132	                record_id=record.id,
   133	                source=str(path),
   134	            )
   135	    return records

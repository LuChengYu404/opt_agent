   235	def _cost_units(records: list) -> int:
   236	    """Backend cost proxy: total new samples + GP fits across rolled branches."""
   237	    total = 0
   238	    for rec in records:
   239	        for r in rec.rollout_results.values():
   240	            total += int(r.get("n_new_samples", 0)) + int(r.get("n_model_fits", 0))
   241	    return total

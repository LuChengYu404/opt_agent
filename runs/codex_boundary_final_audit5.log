   102	def test_partial_record_metadata_and_subset_gold_probs() -> None:
   103	    full = _records(_quick_spec(horizon=2))
   104	    part = _records(_quick_spec(horizon=2, rollout_action_subsample=3))
   105	
   106	    assert full and part
   107	    full_by_id = {r.id: r for r in full}
   108	    for rec in part:
   109	        meta = rec.metadata["partial_rollout"]
   110	        assert meta["k"] == 3
   111	        rolled_ids = set(meta["action_ids"])
   112	        assert len(rolled_ids) == 3
   113	        # gold_probs / rollout_results cover exactly the rolled subset.
   114	        assert set(rec.gold_probs) == rolled_ids
   115	        assert set(rec.rollout_results) == rolled_ids
   116	        # Subset distribution still normalizes.
   117	        assert sum(rec.gold_probs.values()) == pytest.approx(1.0, abs=1e-9)
   118	        # candidate_actions still describe the FULL vocabulary.

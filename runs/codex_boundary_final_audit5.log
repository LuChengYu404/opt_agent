   105	def _average_rollouts(outputs: list) -> "RolloutOutput":
   106	    """Merge replicate rollouts of the SAME candidate subset (P1b denoising).
   107	
   108	    Per action: utility/deltas/counts are means over the replicas where the
   109	    action was valid; the per-replica utilities and their std are stashed in
   110	    ``metrics['utility_replicas']`` / ``metrics['utility_std']``. An action
   111	    valid in no replica is emitted as-is from the first output (invalid).
   112	    T2: averaging leaves the expected ranking unchanged and shrinks utility
   113	    noise as 1/sqrt(R).
   114	    """
   115	    import statistics as _stats
   116	
   117	    from opt_agent.rollout import CounterfactualResult, RolloutOutput
   118	
   119	    base = outputs[0]
   120	    merged: list[CounterfactualResult] = []
   121	    for first in base.results:
   122	        replicas = [
   123	            r for out in outputs
   124	            for r in out.results
   125	            if r.action_id == first.action_id and r.status == "valid"
   126	        ]
   127	        if not replicas:
   128	            merged.append(first)
   129	            continue
   130	
   131	        def _mean(attr: str) -> float:
   132	            vals = [getattr(r, attr) for r in replicas]
   133	            return float(_stats.fmean(vals))
   134	
   135	        utilities = [r.utility for r in replicas]
   136	        metrics = dict(first.metrics)
   137	        metrics["utility_replicas"] = utilities
   138	        metrics["utility_std"] = (
   139	            float(_stats.pstdev(utilities)) if len(utilities) > 1 else 0.0
   140	        )
   141	        merged.append(CounterfactualResult(
   142	            action_id=first.action_id,
   143	            action=first.action,
   144	            status="valid",
   145	            n_new_samples=_mean("n_new_samples"),
   146	            n_model_fits=_mean("n_model_fits"),
   147	            delta_optimization=_mean("delta_optimization"),
   148	            delta_surrogate=_mean("delta_surrogate"),
   149	            delta_coverage=_mean("delta_coverage"),
   150	            utility=float(_stats.fmean(utilities)),
   151	            metrics=metrics,
   152	            trajectory_tail=first.trajectory_tail,
   153	            error=None,
   154	        ))
   155	    return RolloutOutput(s_t=base.s_t, results=tuple(merged))

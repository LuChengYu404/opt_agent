    68	def derive_seed(*parts: int) -> int:
    69	    """Deterministic 31-bit seed from multiple integers."""
    70	    h = hashlib.sha256()
    71	    for p in parts:
    72	        h.update(p.to_bytes(8, "little", signed=False))
    73	        h.update(b"|")
    74	    return int.from_bytes(h.digest()[:4], "little") & 0x7FFFFFFF

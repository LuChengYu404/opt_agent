   208	def _run_trajectory(task: dict) -> list:
   209	    """Worker: generate all records for one (problem, seed, trajectory_id).
   210	
   211	    Pin torch to a single thread: GP fitting is the bottleneck, and with
   212	    many process workers the default (all cores) oversubscribes the machine.
   213	    """
   214	    import torch
   215	
   216	    torch.set_num_threads(1)
   217	    from dataclasses import replace as _replace
   218	
   219	    base = _config_from_task(task["config"])
   220	    spec = _replace(
   221	        base,
   222	        problems=(task["family"],),
   223	        seeds=(task["seed"],),
   224	        trajectories_per_problem_seed=1,
   225	    )
   226	    return list(DatasetGenerator(spec).generate())

     4	
     5	JSONL schema (one record per decision point):
     6	
     7	    {
     8	      "id": "branin:0:0:3",
     9	      "problem": {"family": "branin", "dimension": 2, "seed": 0},
    10	      "state": {...dataclasses.asdict(OptimizationState)...},
    11	      "candidate_actions": [
    12	          {"action_id": "global_exploration", "type": "global_exploration", "params": {...}},
    13	          ...
    14	      ],
    15	      "gold_probs": {"action_id": probability, ...},
    16	      "rollout_results": {
    17	          "action_id": {
    18	              "status": "valid|invalid",
    19	              "utility": float,
    20	              "delta_optimization": float,
    21	              "delta_surrogate": float|null,
    22	              "delta_coverage": float,
    23	              "n_new_samples": int,
    24	              "n_model_fits": int,
    25	              "error": str|null
    26	          }, ...
    27	      },
    28	      "temperature": float,
    29	      "metadata": {...}
    30	    }
    31	
    32	Vocabulary invariant: keys in gold_probs and rollout_results are identical
    33	(set equality), and both are a subset of the candidate_actions ids. With
    34	partial rollouts (rollout_action_subsample < 8) only a deterministic
    35	k-subset of the candidates is rolled out and labeled —
    36	metadata["partial_rollout"] records which ids; full datasets are set-equal
    37	across all three fields. This is enforced by the generator and verified by
    38	tests.
    39	"""
    40	
    41	from __future__ import annotations
    42	
    43	import json
    44	import math
    45	from dataclasses import asdict, dataclass, field, is_dataclass
    46	from enum import Enum
    47	from pathlib import Path
    48	from typing import Any, Iterable, Iterator, Mapping
    49	
    50	
    51	@dataclass(frozen=True)
    52	class DecisionRecord:
    53	    """A single (state, candidate_actions, gold_probs) record for System-1 training."""
    54	    id: str
    55	    problem: dict[str, Any]
    56	    state: dict[str, Any]
    57	    candidate_actions: list[dict[str, Any]]
    58	    gold_probs: dict[str, float]
    59	    rollout_results: dict[str, dict[str, Any]]
    60	    temperature: float
    61	    metadata: dict[str, Any] = field(default_factory=dict)
    62	
    63	
    64	def _json_safe(value: Any) -> Any:
    65	    """Recursively convert dataclasses, Enums, NaN/Inf floats to JSON-safe types."""
    66	    if is_dataclass(value) and not isinstance(value, type):
    67	        return _json_safe(asdict(value))
    68	    if isinstance(value, Enum):
    69	        return value.value
    70	    if isinstance(value, float):
    71	        return value if math.isfinite(value) else None
    72	    if isinstance(value, Mapping):
    73	        return {str(k): _json_safe(v) for k, v in value.items()}
    74	    if isinstance(value, (list, tuple)):
    75	        return [_json_safe(v) for v in value]
    76	    if value is None or isinstance(value, (str, int, bool)):
    77	        return value
    78	    raise TypeError(f"Unsupported JSON value: {type(value).__name__}")
    79	
    80	
    81	def write_jsonl(records: Iterable[DecisionRecord], path: Path) -> None:
    82	    """Write DecisionRecords to JSONL. NaN/Inf are sanitized to None."""
    83	    path = Path(path)
    84	    path.parent.mkdir(parents=True, exist_ok=True)
    85	    with path.open("w", encoding="utf-8", newline="\n") as stream:
    86	        for record in records:
    87	            payload = _json_safe(record)
    88	            stream.write(
    89	                json.dumps(
    90	                    payload,
    91	                    allow_nan=False,
    92	                    sort_keys=True,
    93	                    separators=(",", ":"),
    94	                )
    95	            )
    96	            stream.write("\n")
    97	
    98	
    99	def iter_jsonl(path: Path) -> Iterator[DecisionRecord]:
   100	    """Read DecisionRecords from JSONL. Skips blank lines.
   101	
   102	    RAW ACCESS: no version enforcement. Replay/analysis scripts that walk a
   103	    single frozen artifact end-to-end may use this. Any consumer that POOLS
   104	    records (training, labeling, cross-dataset merging) must use
   105	    `read_jsonl` with an explicit `version_policy` (guide 4.5/6.6).
   106	    """
   107	    path = Path(path)
   108	    with path.open("r", encoding="utf-8") as stream:
   109	        for line_number, line in enumerate(stream, 1):
   110	            if not line.strip():
   111	                continue
   112	            try:
   113	                yield DecisionRecord(**json.loads(line))
   114	            except Exception as exc:
   115	                raise ValueError(
   116	                    f"{path}:{line_number}: invalid DecisionRecord"
   117	                ) from exc
   118	
   119	
   120	def read_jsonl(
   121	    path: Path, *, version_policy: str = "warn", pool_legacy: bool = False,
   122	    pooling_note: str = "",
   123	) -> list[DecisionRecord]:
   124	    """Materialize records from JSONL, enforcing a version-pooling policy.
   125	
   126	    The version policy (guide 4.5/6.6) is the explicit pooling decision at
   127	    the loading boundary. DEFAULT IS "warn" (codex round-5 B3: a pooling
   128	    boundary must not silently default to unchecked): legacy stamps are
   129	    summarized once with a do-not-pool reminder, unrecognized stamps and
   130	    cross-version mixes warn; "strict" raises on unrecognized stamps and
   131	    mixes (pool_legacy=True + pooling_note records the explicit opt-in,
   132	    persisted to the pooling audit log); "allow" is the explicit
   133	    unchecked escape hatch. See opt_agent.dataset.versioning.
   134	    """
   135	    from opt_agent.dataset.versioning import (
   136	        enforce_record_pooling,
   137	        enforce_record_versions,
   138	    )
   139	
   140	    records = list(iter_jsonl(path))
   141	    if version_policy == "allow":
   142	        return records
   143	    statuses = [
   144	        enforce_record_versions(
   145	            record.metadata,
   146	            version_policy,
   147	            record_id=record.id,
   148	            source=str(path),
   149	        )
   150	        for record in records
   151	    ]
   152	    enforce_record_pooling(
   153	        [record.metadata for record in records], version_policy,
   154	        source=str(path), pool_legacy=pool_legacy,
   155	        pooling_note=pooling_note)
   156	    return records


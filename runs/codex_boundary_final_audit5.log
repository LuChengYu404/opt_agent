   193	def _config_from_task(cfg: dict) -> "DatasetConfig":
   194	    """Rebuild DatasetConfig from its asdict() form (nested dataclasses back)."""
   195	    from opt_agent.rollout.specs import ContinuationPolicySpec
   196	    from opt_agent.rollout.utility import UtilityWeights
   197	
   198	    fixed = dict(cfg)
   199	    if isinstance(fixed.get("utility_weights"), dict):
   200	        fixed["utility_weights"] = UtilityWeights(**fixed["utility_weights"])
   201	    if isinstance(fixed.get("continuation_spec"), dict):
   202	        fixed["continuation_spec"] = ContinuationPolicySpec(
   203	            **fixed["continuation_spec"]
   204	        )
   205	    return DatasetConfig(**fixed)

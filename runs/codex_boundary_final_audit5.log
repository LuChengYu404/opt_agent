    44	def full_candidates(seed: int = 0) -> list[Candidate]:
    45	    """Return the unfiltered 8-action candidate set used by the dataset.
    46	
    47	    Per codex M1: this reads `actions.factory.ALL_CANDIDATE_SPECS` — the
    48	    SINGLE source of truth for the action vocabulary. The runtime factory

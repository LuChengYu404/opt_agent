    82	def subsample_candidates(
    83	    candidates: list[Candidate],
    84	    k: int,
    85	    seed: int,
    86	) -> list[Candidate]:
    87	    """Deterministically keep k of `candidates` (order-preserving).
    88	
    89	    The subset is drawn with `random.Random(seed)` so the same
    90	    (run_seed, step, salt) triple always yields the same subset — this keeps
    91	    partial records replayable and keeps affine-transform pairs aligned
    92	    (Gate 5 compares records by id with the same run_seed/step).
    93	    """
    94	    if not 1 <= k <= len(candidates):
    95	        raise ValueError(
    96	            f"subsample size must be in [1, {len(candidates)}]; got k={k}"
    97	        )
    98	    if k == len(candidates):
    99	        return list(candidates)
   100	    rng = random.Random(seed)
   101	    chosen = set(rng.sample(range(len(candidates)), k))
   102	    return [c for i, c in enumerate(candidates) if i in chosen]

   732	def _candidates_from_record(record: DecisionRecord) -> list:
   733	    """Reconstruct the candidate list from `record.candidate_actions`."""
   734	    from opt_agent.rollout.rollout import Candidate
   735	    return [
   736	        Candidate(
   737	            action_id=ca["action_id"],
   738	            action=OptimizationAction(ActionType(ca["type"]), dict(ca["params"])),
   739	        )
   740	        for ca in record.candidate_actions
   741	    ]

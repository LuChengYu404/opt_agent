   687	def _weights_from_metadata(meta: dict) -> UtilityWeights:
   688	    """Reconstruct `UtilityWeights` from `metadata["utility_weights"]`.
   689	
   690	    Falls back to Phase 8.6B single-key format (`w_stop_opportunity` only)
   691	    for backward compatibility with records generated before Sprint 0.
   692	    """
   693	    uw = meta.get("utility_weights")
   694	    if isinstance(uw, dict) and uw:
   695	        return UtilityWeights.from_dict(uw)
   696	    # Legacy fallback (Phase 8.6B and earlier): only w_stop_opportunity
   697	    # was persisted; everything else uses the dataclass defaults.
   698	    return UtilityWeights(w_stop_opportunity=float(meta.get("w_stop_opportunity", 0.75)))
   699	
   700	
   701	def _affine_kwargs_from_metadata(meta: dict) -> dict:
   702	    """Return `objective_scale` / `objective_shift` kwargs for backend ctor.
   703	
   704	    Phase 9 Gate 5 — records generated by `DatasetGenerator` with a non-identity
   705	    affine transform carry the two values in `metadata["objective_scale"]` and
   706	    `metadata["objective_shift"]`. Records from before Track B (no fields) and
   707	    from identity-transform runs both fall back to (1.0, 0.0).
   708	
   709	    Used by `oracle_test_from_record` and `replay_with_config` so that future
   710	    `evaluate()` calls append transformed values to the (already-transformed)
   711	    checkpoint history. Without this thread, a replayed trajectory would mix
   712	    raw and transformed objectives — silent corruption.
   713	
   714	    The function validates `scale > 0` and finite `shift` so that a corrupted
   715	    record raises immediately rather than silently corrupting the replay.
   716	    """
   717	    scale = float(meta.get("objective_scale", 1.0))
   718	    shift = float(meta.get("objective_shift", 0.0))
   719	    if not math.isfinite(scale) or scale <= 0:
   720	        raise ValueError(
   721	            f"record metadata has invalid objective_scale={scale!r} "
   722	            "(must be finite and > 0); record may be corrupted"
   723	        )
   724	    if not math.isfinite(shift):
   725	        raise ValueError(
   726	            f"record metadata has invalid objective_shift={shift!r} "
   727	            "(must be finite); record may be corrupted"
   728	        )
   729	    return {"objective_scale": scale, "objective_shift": shift}

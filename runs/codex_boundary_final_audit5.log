    19	
    20	
    21	def _phase(ratio: float) -> str:
    22	    """Classify a BO trajectory point by remaining-budget ratio. The
    23	    canonical version lives in ``dataset.validation.phase_of_ratio``;
    24	    this stub is a deferred-import indirection so ``dataset.analysis``
    25	    doesn't pull in the full validation module (which transitively
    26	    imports the rollout machinery) at import time.
    27	    """
    28	    from opt_agent.dataset.validation import phase_of_ratio
    29	    return phase_of_ratio(ratio)
    30	
    31	
    32	def validate_record(record: DecisionRecord) -> None:
    33	    """Enforce vocabulary and probability invariants.
    34	
    35	    ``gold_probs`` and ``rollout_results`` must cover the same action ids,
    36	    and those ids must be a subset of the candidate vocabulary: with
    37	    ``rollout_action_subsample < 8`` (partial rollout) only a k-subset of
    38	    the candidates is rolled out and labeled. Full datasets remain
    39	    set-equal across all three fields.
    40	    """
    41	    ids = [a["action_id"] for a in record.candidate_actions]
    42	    if len(ids) != len(set(ids)):
    43	        raise ValueError(f"{record.id}: duplicate candidate IDs")
    44	    if set(record.gold_probs) != set(record.rollout_results):
    45	        raise ValueError(f"{record.id}: unaligned action vocabulary")
    46	    if not set(record.gold_probs) <= set(ids):
    47	        raise ValueError(f"{record.id}: labeled ids outside candidate vocabulary")
    48	
    49	    probs = record.gold_probs
    50	    if any(not math.isfinite(p) or p < 0 for p in probs.values()):
    51	        raise ValueError(f"{record.id}: invalid probability")
    52	    if not math.isclose(sum(probs.values()), 1.0, abs_tol=1e-9):
    53	        raise ValueError(
    54	            f"{record.id}: probabilities do not sum to one (got {sum(probs.values())})"
    55	        )
    56	
    57	    for action_id, result in record.rollout_results.items():
    58	        if result["status"] == "invalid" and probs[action_id] != 0:
    59	            raise ValueError(
    60	                f"{record.id}: invalid action {action_id!r} has nonzero probability"
    61	            )
    62	
    63	
    64	@dataclass(frozen=True)
    65	class DatasetStats:
    66	    n_records: int
    67	    problems: dict[str, int]
    68	    phase_counts: dict[str, dict[str, int]]
    69	    avg_entropy: dict[str, float]
    70	    early_phase_top_action: dict[str, str]
    71	    late_phase_top_action: dict[str, str]
    72	    invalid_rate: dict[str, float]
    73	
    74	
    75	def analyze_dataset(path: Path) -> DatasetStats:
    76	    """Walk a JSONL dataset and compute summary stats.
    77	
    78	    Raises
    79	    ------
    80	    ValueError
    81	        If any record violates the aligned-vocabulary / probability invariants.
    82	    """
    83	    problem_counts: Counter = Counter()
    84	    phase_counts: dict[str, Counter] = defaultdict(Counter)
    85	    entropy_sum: Counter = Counter()
    86	    entropy_count: Counter = Counter()
    87	    invalid_sum: Counter = Counter()
    88	    candidate_sum: Counter = Counter()
    89	    phase_probs: dict[tuple[str, str], Counter] = defaultdict(Counter)
    90	    n_records = 0
    91	
    92	    for record in iter_jsonl(path):
    93	        validate_record(record)
    94	        n_records += 1
    95	        family = record.problem["family"]
    96	        ratio = float(record.state["resource"]["remaining_budget_ratio"])
    97	        phase = _phase(ratio)
    98	
    99	        problem_counts[family] += 1
   100	        phase_counts[family][phase] += 1
   101	
   102	        valid = [
   103	            aid
   104	            for aid, r in record.rollout_results.items()
   105	            if r["status"] == "valid"
   106	        ]
   107	        if valid:
   108	            entropy = -sum(
   109	                p * math.log(p)
   110	                for p in record.gold_probs.values()
   111	                if p > 0
   112	            )
   113	            entropy /= math.log(len(valid))  # normalized to [0, 1]
   114	        else:
   115	            entropy = 0.0
   116	
   117	        if phase != "terminal":
   118	            entropy_sum[family] += entropy
   119	            entropy_count[family] += 1
   120	
   121	        invalid_sum[family] += len(record.gold_probs) - len(valid)
   122	        candidate_sum[family] += len(record.gold_probs)
   123	
   124	        phase_probs[(family, phase)].update(record.gold_probs)
   125	
   126	    def top(family: str, phase: str) -> str:
   127	        totals = phase_probs[(family, phase)]
   128	        return max(totals, key=totals.get) if totals else ""
   129	
   130	    families = sorted(problem_counts)
   131	    return DatasetStats(
   132	        n_records=n_records,
   133	        problems=dict(problem_counts),
   134	        phase_counts={f: dict(phase_counts[f]) for f in families},
   135	        avg_entropy={
   136	            f: entropy_sum[f] / entropy_count[f] if entropy_count[f] else math.nan
   137	            for f in families
   138	        },
   139	        early_phase_top_action={f: top(f, "early") for f in families},
   140	        late_phase_top_action={f: top(f, "late") for f in families},
   141	        invalid_rate={
   142	            f: invalid_sum[f] / candidate_sum[f] if candidate_sum[f] else 0.0
   143	            for f in families
   144	        },
   145	    )


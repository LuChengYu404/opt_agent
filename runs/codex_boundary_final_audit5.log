   158	def derive_run_seed(problem: str, problem_seed: int, trajectory_id: int) -> int:
   159	    """Process-stable seed combining (problem_name, problem_seed, trajectory_id).
   160	
   161	    Uses SHA-256 of the problem name to avoid Python's built-in `hash()`
   162	    which depends on PYTHONHASHSEED and varies across processes.
   163	    """
   164	    digest = hashlib.sha256(problem.encode("utf-8")).digest()
   165	    problem_key = int.from_bytes(digest[:8], "little")
   166	    return derive_seed(problem_seed, trajectory_id, problem_key)

   744	def replay_with_config(
   745	    record: DecisionRecord,
   746	    *,
   747	    continuation_spec: ContinuationPolicySpec | None = None,
   748	    utility_weights: UtilityWeights | None = None,
   749	    horizon: int | None = None,
   750	    temperature: float | None = None,
   751	    backend_factory: Callable | None = None,
   752	) -> RolloutOutput:
   753	    """Replay a `DecisionRecord` with a new (or original) rollout config.
   754	
   755	    Loads the record's base checkpoint into a fresh backend, then runs
   756	    `CounterfactualRollout` with the supplied (or original) config on the
   757	    same candidate list. This is the Sprint 0 mechanism for the Q-S5
   758	    diagnostic matrix: re-run any record with different
   759	    {continuation_spec × utility_weights × horizon} without re-running
   760	    the trajectory that produced the record.
   761	
   762	    Parameters
   763	    ----------
   764	    record : DecisionRecord
   765	        Must contain Sprint 0 / Phase 8.6B replay metadata
   766	        (`backend_X`, ..., `backend_model_state_b64`, `backend_rng_state_b64`).
   767	    continuation_spec : ContinuationPolicySpec | None
   768	        Override for the continuation policy. Defaults to the spec recorded
   769	        in `record.metadata["continuation_policy"]`.
   770	    utility_weights : UtilityWeights | None
   771	        Override for utility weights. Defaults to the weights recorded in
   772	        `record.metadata["utility_weights"]` (or Phase 8.6B legacy fallback).
   773	    horizon : int | None
   774	        Override for rollout horizon. Defaults to `record.metadata["horizon"]`.
   775	    temperature : float | None
   776	        Recorded alongside the output for convenience (not used in this
   777	        function — `gold_probs` are computed by the caller via `to_gold_probs`
   778	        from the returned `RolloutOutput`).
   779	    backend_factory : Callable | None
   780	        Optional factory returning a fresh `UnifiedBackend`. Defaults to a
   781	        `BocodeBotorchBackend` initialized with the problem from the record.
   782	
   783	    Returns
   784	    -------
   785	    RolloutOutput
   786	        New rollout results from the supplied config. The original record is
   787	        not mutated. The backend is restored to its pre-call state.
   788	    """
   789	    from opt_agent.backend.bocode_botorch import BackendConfig, BocodeBotorchBackend
   790	    from opt_agent.rollout.rollout import CounterfactualRollout
   791	
   792	    meta = record.metadata
   793	    # Validate replay metadata FIRST so the user sees the missing-keys error
   794	    # before any other metadata access (e.g. `meta["horizon"]`).
   795	    base = _reconstruct_checkpoint(record)
   796	
   797	    spec = continuation_spec if continuation_spec is not None else spec_from_metadata(
   798	        meta.get("continuation_policy")
   799	    )
   800	    weights = utility_weights if utility_weights is not None else _weights_from_metadata(meta)
   801	    h = horizon if horizon is not None else int(meta["horizon"])
   802	
   803	    # Reconstruct backend.
   804	    problem_id = str(meta["backend_problem_id"])
   805	    if backend_factory is None:
   806	        # Phase 9 Gate 5 — same as oracle_test_from_record: read affine
   807	        # transform from metadata so evaluate() appends transformed values
   808	        # to the (already-transformed) checkpoint history.
   809	        affine = _affine_kwargs_from_metadata(meta)
   810	        backend = BocodeBotorchBackend(**affine)
   811	        backend.initialize(BackendConfig(
   812	            problem_id=problem_id,
   813	            seed=int(record.problem["seed"]),
   814	            n_init=1,
   815	        ))
   816	    else:
   817	        backend = backend_factory()
   818	    try:
   819	        backend.restore(base)
   820	        state = extract_state(
   821	            backend,
   822	            total_budget=int(record.state["resource"]["total_budget"]),
   823	            last_action=record.state["history"].get("last_action"),
   824	        )
   825	        if state.sampling.n_samples != int(record.state["sampling"]["n_samples"]):
   826	            raise ValueError(
   827	                f"record {record.id!r} replay sample count differs "
   828	                f"({state.sampling.n_samples} vs "
   829	                f"{record.state['sampling']['n_samples']})"
   830	            )
   831	        candidates = _candidates_from_record(record)
   832	        rollout = CounterfactualRollout(
   833	            backend,
   834	            horizon=h,
   835	            utility_weights=weights,
   836	            continuation_spec=spec,
   837	            optimization_scale=float(meta.get("optimization_scale", 1.0)),
   838	            evaluation_scale=float(meta.get("evaluation_scale", 1.0)),
   839	            fit_scale=float(meta.get("fit_scale", 1.0)),
   840	        )


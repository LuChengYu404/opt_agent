   279	    if args.output.exists() and not args.resume and not args.force:
   280	        print(f"error: {args.output} exists; pass --force or --resume", file=sys.stderr)
   281	        return 1
   282	
   283	    from opt_agent.rollout.specs import ContinuationPolicySpec
   284	    from opt_agent.rollout.utility import UtilityWeights
   285	
   286	    weights = UtilityWeights()
   287	    if args.terminal_utility:
   288	        weights = UtilityWeights(
   289	            w_optimization=1.0, w_surrogate=0.0, w_coverage=0.0,
   290	            w_evaluation=0.0, w_fit=0.0, w_stop_opportunity=0.0,
   291	        )
   292	    cont = ContinuationPolicySpec(
   293	        name=args.continuation, seed=0,
   294	        extras={"rule_weight": 0.8} if args.continuation == "on_policy" else {},
   295	    )
   296	    spec = replace(
   297	        DatasetConfig(),
   298	        problems=tuple(args.problems),
   299	        continuation_spec=cont,
   300	        utility_weights=weights,
   301	        seeds=tuple(range(args.seeds)),
   302	        total_budget=args.budget,
   303	        max_actions=args.max_actions,
   304	        decision_every_k_actions=args.decision_every_k,
   305	        horizon=horizon,
   306	        horizon_mode=horizon_mode,
   307	        rollout_action_subsample=args.subsample_k,
   308	        rollout_replicates=args.replicates,
   309	    )
   310	
   311	    done_keys = (_existing_trajectory_keys(args.output, spec)
   312	                 if args.resume else set())
   313	    tasks = [
   314	        {"family": p, "seed": s, "trajectory_id": t, "config": asdict(spec)}
   315	        for p in spec.problems
   316	        for s in spec.seeds
   317	        for t in range(spec.trajectories_per_problem_seed)
   318	        if (p.lower(), s, t) not in done_keys
   319	    ]
   320	    skipped = len(done_keys)
   321	
   322	    tmp = args.output.with_suffix(args.output.suffix + ".tmp")
   323	    collected: list = []
   324	    t0 = time.time()
   325	    n_tasks = len(tasks)
   326	    if tasks:
   327	        import multiprocessing
   328	
   329	        # spawn: workers import cleanly (no fork-safety issues with torch
   330	        # state); each worker pins itself to 1 torch thread.
   331	        ctx = multiprocessing.get_context("spawn")
   332	        # Serialise the already-present records into tmp first when resuming.
   333	        if args.resume and args.output.exists():
   334	            tmp.write_text(args.output.read_text(), encoding="utf-8")
   335	        else:
   336	            tmp.write_text("", encoding="utf-8")
   337	        with ProcessPoolExecutor(max_workers=args.workers, mp_context=ctx) as pool:
   338	            futures = {pool.submit(_run_trajectory, t): t for t in tasks}
   339	            for fut in as_completed(futures):
   340	                task = futures[fut]
   341	                recs = fut.result()
   342	                collected.extend(recs)
   343	                with tmp.open("a", encoding="utf-8") as fh:
   344	                    for rec in recs:
   345	                        fh.write(_record_line(rec))
   346	                done = sum(1 for f in futures if f.done())
   347	                print(
   348	                    f"[{done}/{n_tasks}] {task['family']} seed={task['seed']} "
   349	                    f"→ {len(recs)} records",
   350	                    flush=True,
   351	                )
   352	    else:
   353	        # Nothing to do (resume found everything). Do NOT write/replace the
   354	        # output — replacing with an empty temp file would destroy the
   355	        # completed dataset (codex final-audit-3 B2).
   356	        print(json.dumps({

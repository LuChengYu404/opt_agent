   176	        if missing_note:
   177	            raise VersionPolicyError(
   178	                f"source_notes missing/empty for {missing_note}; every "
   179	                f"pooled source needs its recorded opt-in note")
   180	        missing_source = sorted(set(stamps_by_source)
   181	                                 - set(source_notes))
   182	        extra_source = sorted(set(source_notes)
   183	                              - set(stamps_by_source))
   184	        if missing_source or extra_source:
   185	            raise VersionPolicyError(
   186	                f"source_notes keys must match the pooled sources exactly: "
   187	                f"missing={missing_source}, extra={extra_source}")

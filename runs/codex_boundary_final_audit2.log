   244	    for axis in ("harness", "utility"):
   245	        # An absent stamp counts as its own value: records that predate the
   246	        # stamp mechanism pool with stamped records only by explicit note.
   247	        values = sorted({str(s.get(f"{axis}_version")) for s in stamps})
   248	        if len(values) > 1:
   249	            msg = (f"{source}: mixes {axis} stamps {values}; pooling "
   250	                   f"across versions requires an explicit same-data A/B "
   251	                   f"note (guide 6.6 rule 1) — pass pool_legacy=True with "
   252	                   f"a pooling_note to record that decision")

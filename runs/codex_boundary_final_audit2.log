    64	def _existing_trajectory_keys(path: Path) -> set[tuple[str, int, int]]:
    65	    """(family, problem_seed, trajectory_id) triples already on disk.
    66	
    67	    Resume guard (codex final audit B2): the existing file's version stamps
    68	    must be exactly the CURRENT ones before new records are appended —
    69	    otherwise resuming after a version change would silently create a
    70	    mixed-version artifact. Raises SystemExit on incompatibility.
    71	    """
    72	    from opt_agent.dataset.versioning import (
    73	        HARNESS_VERSION, UTILITY_VERSION, check_record_versions)
    74	
    75	    keys: set[tuple[str, int, int]] = set()
    76	    if not path.exists():
    77	        return keys
    78	    stamps_seen: set[tuple] = set()
    79	    for rec in iter_jsonl(path):
    80	        meta = rec.metadata
    81	        stamps_seen.add((meta.get("harness_version"),
    82	                         meta.get("utility_version")))
    83	        keys.add((
    84	            rec.problem["family"],
    85	            int(rec.problem["seed"]),
    86	            int(meta.get("trajectory_id", 0)),
    87	        ))
    88	    if len(stamps_seen) > 1:
    89	        raise SystemExit(
    90	            f"{path} already mixes version stamps {sorted(stamps_seen)}; "
    91	            f"refusing to resume into a mixed-version artifact — write a "
    92	            f"new output file")
    93	    if stamps_seen and stamps_seen.pop() != (HARNESS_VERSION,
    94	                                             UTILITY_VERSION):
    95	        raise SystemExit(
    96	            f"{path} was written under different version stamps than the "
    97	            f"current code ({HARNESS_VERSION}/{UTILITY_VERSION}); refusing "
    98	            f"to append — write a new versioned output file")
    99	    return keys

   207	def enforce_record_pooling(
   208	    stamps: list[dict],
   209	    policy: str | VersionPolicy,
   210	    *,
   211	    source: str = "",
   212	    pool_legacy: bool = False,
   213	    pooling_note: str = "",
   214	) -> None:
   215	    """Enforce the guide 4.5 no-silent-mixing rule over a loaded source.
   216	
   217	    Compares RAW stamp values (not status classes), so two DIFFERENT
   218	    known-past stamps also count as a mix (codex round-4 B3). A mix of
   219	    distinct stamps on one axis is a cross-version pool; the guide
   220	    requires an explicit decision with a recorded same-data A/B note.
   221	    Under any non-ALLOW policy: pool_legacy=False -> WARN warns, STRICT
   222	    raises; pool_legacy=True REQUIRES a non-empty pooling_note, records
   223	    the decision in the audit trail (pooling_decisions()), and proceeds.
   224	
   225	    Boundary limitation (documented in guide 4.5): this checks ONE loaded
   226	    source; combining multiple separately loaded files must pass each
   227	    through read_jsonl and cite the same pooling note.
   228	    """
   229	    policy = VersionPolicy(policy)
   230	    if policy is VersionPolicy.ALLOW:
   231	        return
   232	    if pool_legacy:
   233	        if not pooling_note.strip():
   234	            raise VersionPolicyError(
   235	                f"{source}: pool_legacy=True requires a pooling_note "
   236	                f"describing the same-data A/B justification (guide 6.6 "
   237	                f"rule 1)")
   238	        entry = {"source": source, "note": pooling_note}
   239	        _persist_pooling_decision(entry)  # raises on failure — only then:
   240	        _recorded_pooling_decisions.append(entry)  # durable before visible
   241	        return
   242	    import warnings

   185	def test_read_jsonl_mixed_pooling_requires_opt_in(tmp_path, monkeypatch):
   186	    """A source mixing legacy and current stamps must not pool silently:
   187	    WARN warns, STRICT raises, pool_legacy=True records the opt-in."""
   188	    import warnings as _w
   189	
   190	    import opt_agent.dataset.versioning as ver
   191	    from opt_agent.dataset.decision_record import read_jsonl
   192	
   193	    monkeypatch.setattr(ver, "_legacy_warned", set())
   194	    path = tmp_path / "mixed_pool.jsonl"
   195	    lines = [
   196	        _make_record_line({"utility_version": ver.UTILITY_VERSION}),  # legacy
   197	        _make_record_line({"harness_version": ver.HARNESS_VERSION,
   198	                           "utility_version": ver.UTILITY_VERSION}),  # current
   199	    ]
   200	    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
   201	
   202	    with _w.catch_warnings(record=True) as caught:
   203	        _w.simplefilter("always")

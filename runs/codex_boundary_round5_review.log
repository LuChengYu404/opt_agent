   312	         for fam in args.families})
   313	    # SECONDARY on fresh seeds only (20-59): Delta_{.,12}
   314	    def subset_delta12(fam: str) -> tuple[float, float]:
   315	        d = [by_key[(fam, s, 12)]["best"] - by_key[(fam, s, REFERENCE)]["best"]
   316	             for s in conf_idx]
   317	        return statistics.fmean(d), statistics.stdev(d) ** 2 / len(d)
   318	    fresh12 = {fam: subset_delta12(fam) for fam in args.families}
   319	    fresh12_homog = homogeneity({f: m for f, (m, _) in fresh12.items()},
   320	                                {f: v for f, (_, v) in fresh12.items()})
   321	

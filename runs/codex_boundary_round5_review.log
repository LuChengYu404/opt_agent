   323	    agreement = {fam: (1 if (per_family[fam]["dose_slope"]["mean"] > 0) else -1)
   324	                 == MECH_SIGN.get(fam, 0) for fam in args.families if fam in MECH_SIGN}
   325	    k_ok = sum(agreement.values())
   326	    n_pred = len(agreement)
   327	    sign_p = sum(math.comb(n_pred, i)
   328	                 for i in range(k_ok, n_pred + 1)) / 2 ** n_pred
   329	
   330	    # Descriptive LOFO on best level (undefined for single-family runs)
   331	    lofo = []
   332	    if len(args.families) > 1:
   333	        for held in args.families:
   334	            others = [f for f in args.families if f != held]
   335	            counts: dict[int, int] = {}
   336	            for f in others:
   337	                counts[per_family[f]["best_level"]] = counts.get(
   338	                    per_family[f]["best_level"], 0) + 1
   339	            pred = max(counts, key=lambda L: (counts[L], -L))  # tie -> smaller level
   340	            lofo.append({"held_out": held, "predicted": pred,
   341	                         "actual": per_family[held]["best_level"],
   342	                         "correct": pred == per_family[held]["best_level"]})
   343	    lofo_acc = (sum(1 for r in lofo if r["correct"]) / len(lofo)) if lofo else None
   344	
   345	    # Predeclared rules (cross-family; single-family arms have no such rule)
   346	    detected = slope_homog["p_value"] < 0.05
   347	    # Futility requires the equivalence bound on EVERY level contrast vs
   348	    # the reference (not only the selected best; codex round-4 E2b) — a
   349	    # reference-winning family is futile only if all its contrasts are
   350	    # equivalence-bounded.
   351	    precise_null = all(
   352	        all(c["precise_enough_for_null"]
   353	            for c in row["contrasts_vs_reference"].values())
   354	        for row in per_family.values())
   355	    if len(args.families) < 2:
   356	        verdict = "SINGLE_FAMILY_ARM (cross-family rule undefined; evaluate " \
   357	                  "the predeclared per-family question directly)"
   358	    elif detected:

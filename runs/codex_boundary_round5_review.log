   127	    pooling_note: str = "",
   128	) -> None:
   129	    """Enforce the guide 4.5 no-silent-mixing rule over a loaded source.
   130	
   131	    Compares RAW stamp values (not status classes), so two DIFFERENT
   132	    known-past stamps also count as a mix (codex round-4 B3). A mix of
   133	    distinct stamps on one axis is a cross-version pool; the guide
   134	    requires an explicit decision with a recorded same-data A/B note.
   135	    Under any non-ALLOW policy: pool_legacy=False -> WARN warns, STRICT
   136	    raises; pool_legacy=True REQUIRES a non-empty pooling_note, records
   137	    the decision in the audit trail (pooling_decisions()), and proceeds.
   138	
   139	    Boundary limitation (documented in guide 4.5): this checks ONE loaded
   140	    source; combining multiple separately loaded files must pass each
   141	    through read_jsonl and cite the same pooling note.
   142	    """
   143	    policy = VersionPolicy(policy)
   144	    if policy is VersionPolicy.ALLOW:
   145	        return
   146	    if pool_legacy:
   147	        if not pooling_note.strip():
   148	            raise VersionPolicyError(
   149	                f"{source}: pool_legacy=True requires a pooling_note "
   150	                f"describing the same-data A/B justification (guide 6.6 "
   151	                f"rule 1)")
   152	        _recorded_pooling_decisions.append(
   153	            {"source": source, "note": pooling_note})
   154	        return
   155	    import warnings
   156	
   157	    for axis in ("harness", "utility"):
   158	        # An absent stamp counts as its own value: records that predate the
   159	        # stamp mechanism pool with stamped records only by explicit note.
   160	        values = sorted({str(s.get(f"{axis}_version")) for s in stamps})
   161	        if len(values) > 1:
   162	            msg = (f"{source}: mixes {axis} stamps {values}; pooling "
   163	                   f"across versions requires an explicit same-data A/B "
   164	                   f"note (guide 6.6 rule 1) — pass pool_legacy=True with "
   165	                   f"a pooling_note to record that decision")
   166	            if policy is VersionPolicy.STRICT:
   167	                raise VersionPolicyError(msg)
   168	            warnings.warn(msg, stacklevel=2)
   169	
   170	
   171	def stamp_metadata(
   172	    metadata: Mapping[str, Any] | None,
   173	    *,
   174	    harness_version: str = HARNESS_VERSION,
   175	    utility_version: str = UTILITY_VERSION,
   176	) -> dict[str, Any]:
   177	    """Return a copy of ``metadata`` with both version stamps applied.
   178	
   179	    Existing stamp keys are overwritten (the caller is generating records
   180	    with the current code, whose stamps ARE the current constants).
   181	    """
   182	    out = dict(metadata) if metadata else {}
   183	    out["harness_version"] = harness_version
   184	    out["utility_version"] = utility_version
   185	    return out
   186	
   187	
   188	def check_record_versions(
   189	    record_metadata: Mapping[str, Any],
   190	) -> dict[str, VersionStatus]:
   191	    """Classify a record's stamps against the current constants.
   192	
   193	    ``record_metadata`` is the ``metadata`` dict of a DecisionRecord (the
   194	    stamps live at its top level; see the generator).
   195	    """
   196	    return {
   197	        "harness": _status(record_metadata.get("harness_version"),
   198	                           HARNESS_VERSION, "harness"),
   199	        "utility": _status(record_metadata.get("utility_version"),
   200	                           UTILITY_VERSION, "utility"),
   201	    }
   202	
   203	
   204	def _status(stamp: Any, current: str, axis: str) -> VersionStatus:
   205	    if stamp == current:
   206	        return VersionStatus.OK
   207	    if stamp is None or stamp in _KNOWN_PAST.get(axis, set()):
   208	        return VersionStatus.LEGACY
   209	    return VersionStatus.MISMATCH
   100	    """Read DecisionRecords from JSONL. Skips blank lines.
   101	
   102	    RAW ACCESS: no version enforcement. Replay/analysis scripts that walk a
   103	    single frozen artifact end-to-end may use this. Any consumer that POOLS
   104	    records (training, labeling, cross-dataset merging) must use
   105	    `read_jsonl` with an explicit `version_policy` (guide 4.5/6.6).
   106	    """
   107	    path = Path(path)
   108	    with path.open("r", encoding="utf-8") as stream:
   109	        for line_number, line in enumerate(stream, 1):
   110	            if not line.strip():
   111	                continue
   112	            try:
   113	                yield DecisionRecord(**json.loads(line))
   114	            except Exception as exc:
   115	                raise ValueError(
   116	                    f"{path}:{line_number}: invalid DecisionRecord"
   117	                ) from exc
   118	
   119	
   120	def read_jsonl(
   121	    path: Path, *, version_policy: str = "allow", pool_legacy: bool = False,
   122	    pooling_note: str = "",
   123	) -> list[DecisionRecord]:
   124	    """Materialize records from JSONL, enforcing a version-pooling policy.
   125	
   126	    The version policy (guide 4.5/6.6) is the explicit pooling decision at
   127	    the loading boundary: "allow" (default, historical behavior), "warn"
   128	    (summarize legacy, warn on unrecognized stamps), or "strict" (raise on
   129	    unrecognized stamps). See opt_agent.dataset.versioning for semantics.
   130	    """
   131	    from opt_agent.dataset.versioning import (
   132	        enforce_record_pooling,
   133	        enforce_record_versions,
   134	    )
   135	
   136	    records = list(iter_jsonl(path))
   137	    if version_policy == "allow":
   138	        return records
   139	    statuses = [
   140	        enforce_record_versions(
   141	            record.metadata,
   142	            version_policy,
   143	            record_id=record.id,
   144	            source=str(path),
   145	        )
   146	        for record in records
   147	    ]
   148	    enforce_record_pooling(
   149	        [record.metadata for record in records], version_policy,
   150	        source=str(path), pool_legacy=pool_legacy,
   151	        pooling_note=pooling_note)
   152	    return records


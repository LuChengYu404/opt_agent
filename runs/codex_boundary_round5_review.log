   362	    else:
   363	        verdict = "INCONCLUSIVE"
   364	    confirmed = [f for f in args.families
   365	                 if per_family[f]["best_vs_reference"]
   366	                 and per_family[f]["best_vs_reference"]["confirmed"]]
   367	
   368	    payload = {

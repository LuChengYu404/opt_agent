     1	"""Boundary registry sync tests — enforce RESEARCH_BOUNDARY_GUIDE.md §2.4/§6.1.
     2	
     3	The point of these tests is that the action menu CANNOT drift from its
     4	boundary classification: adding/removing/reclassifying an action without
     5	touching both the registry and the guide §2.4 table turns the suite red.
     6	
     7	Verified columns (guide §2.4 schema): ActionType | 归类 | 子菜单 | 备注 —
     8	menu membership, boundary class, and submenu are compared strictly; the
     9	备注 column is free text and is only required to be non-empty. The parser
    10	fails closed on malformed tables (bad header, short rows, duplicate or
    11	unknown action rows).
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import sys
    17	from pathlib import Path
    18	
    19	import pytest
    20	
    21	sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    22	
    23	from opt_agent.actions.boundary_registry import (
    24	    BOUNDARY_CLASSES,
    25	    BOUNDARY_REGISTRY,
    26	    SUBMENUS,
    27	    RegistrySyncError,
    28	    boundary_class_of,
    29	    submenu_of,
    30	    verify_registry_sync,
    31	)
    32	from opt_agent.actions.models import ActionType
    33	
    34	GUIDE_PATH = (
    35	    Path(__file__).resolve().parents[1] / "docs" / "RESEARCH_BOUNDARY_GUIDE.md"
    36	)
    37	
    38	EXPECTED_HEADER = ("ActionType", "归类", "子菜单", "备注")
    39	
    40	
    41	def _parse_section_rows(section_text: str) -> dict[str, tuple[str, str, str]]:
    42	    """Strictly parse a §2.4-style markdown table.
    43	
    44	    Returns {action_value: (boundary_class, submenu, note)}. Raises
    45	    AssertionError on schema violations — the sync test must fail closed,
    46	    not skip quietly.
    47	    """
    48	    lines = section_text.splitlines()
    49	    header_hits = [i for i, ln in enumerate(lines)
    50	                   if ln.strip().startswith("| ActionType |")]
    51	    assert len(header_hits) == 1, (
    52	        f"expected exactly one §2.4 table, found {len(header_hits)}")
    53	    header_idx = header_hits[0]
    54	    header_cells = [c.strip() for c in lines[header_idx].strip().strip("|").split("|")]
    55	    assert len(header_cells) == 4 and tuple(header_cells) == EXPECTED_HEADER, (
    56	        f"unexpected §2.4 table header: {header_cells!r} "
    57	        f"(expected exactly {EXPECTED_HEADER})"
    58	    )
    59	    rows: dict[str, tuple[str, str, str]] = {}
    60	    table_ended = False
    61	    for line in lines[header_idx + 1:]:
    62	        stripped = line.strip()
    63	        if not stripped.startswith("|"):
    64	            if stripped:
    65	                table_ended = True
    66	            continue  # allow blank lines inside; any later '|' row is a
    67	            # SECOND table in the section -> fail closed
    68	        assert not table_ended, (
    69	            "found a second markdown table inside section 2.4 — the sync "
    70	            "check covers exactly one table")
    71	        cells = [c.strip() for c in stripped.strip("|").split("|")]
    72	        if cells and cells[0].startswith("-"):
    73	            continue  # separator row
    74	        assert len(cells) == 4, (
    75	            f"malformed §2.4 row (needs exactly 4 cells, got {len(cells)}): "
    76	            f"{line!r}")
    77	        name, cls, submenu, note = cells
    78	        try:
    79	            action_value = ActionType[name].value
    80	        except KeyError:
    81	            raise AssertionError(
    82	                f"§2.4 row names unknown action {name!r}: {line!r}")
    83	        assert action_value not in rows, (
    84	            f"duplicate §2.4 row for {action_value!r}")
    85	        assert note, f"§2.4 row for {name} has an empty 备注 cell"
    86	        rows[action_value] = (cls, submenu, note)
    87	    return rows
    88	
    89	
    90	def _guide_section_2_4_rows() -> dict[str, tuple[str, str, str]]:
    91	    """Parse the guide's §2.4 table (reads the rendered document, so a doc
    92	    edit alone cannot desynchronize code from spec)."""
    93	    text = GUIDE_PATH.read_text(encoding="utf-8")
    94	    start = text.index("### 2.4")
    95	    end = text.index("\n## ", start)
    96	    return _parse_section_rows(text[start:end])
    97	
    98	
    99	# ---------------------------------------------------------------------------
   100	# Registry <-> menu

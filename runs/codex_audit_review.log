294:     max_pairs_per_record: int | None = None
295:     weight_decay: float = 0.01
296:     warmup_frac: float = 0.1   # fraction of total steps for linear warmup
297:     seed: int = 0
298:     device: str = "cuda"
299:     amp_dtype: str = "bfloat16"
300:     max_len: int = 512
301:     head_max_len: int = 192
302:     min_lr_frac: float = 0.1   # cosine floor as a fraction of peak lr
303:     grad_clip: float = 1.0
304:     save: bool = True          # False for sweep runs (skip 1.6 GB writes)
305: 
390:             continue
391:         logits = _forward(model, [it for it, _ in kept], tok, device, cfg)
392:         for row, (item, rec) in zip(logits, kept):
393:             index_of = {a: i for i, a in enumerate(item["option_ids"])}
394:             gold_top = max(rec.gold_probs, key=lambda a: rec.gold_probs[a])
395:             model_top = max(
396:                 (a for a in rec.gold_probs if a in index_of),
397:                 key=lambda a: float(row[index_of[a]]),
398:             )
399:             n_records += 1
400:             n_top1 += int(model_top == gold_top)
401:             if item.get("target") is not None:
402:                 logq = torch.log_softmax(row, dim=-1).clamp_min(-9.21)
403:                 t = torch.tensor(item["target"], dtype=logq.dtype, device=logq.device)
404:                 log_scores.append(float((t * logq).sum()))
405:             for i_pos, i_neg, _m in item["pairs"]:
406:                 n_pairs += 1
407:                 n_correct += int(row[int(i_pos)] > row[int(i_neg)])
408:     if was_training:
409:         model.train()
410:     return {
411:         "pairs": n_pairs,
412:         "pairwise_accuracy": (n_correct / n_pairs) if n_pairs else 0.0,
413:         "top1_agreement": (n_top1 / n_records) if n_records else 0.0,
414:         "mean_log_score": (
415:             sum(log_scores) / len(log_scores) if log_scores else None
416:         ),
417:         "records": n_records,
418:     }

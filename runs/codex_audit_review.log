115: def _do_global_exploration(backend: UnifiedBackend, action: OptimizationAction) -> None:
116:     n_samples = int(action.params.get("n_samples", 1))
117:     seed = action.params.get("seed")
118:     bounds = backend.bounds
119:     assert bounds is not None, "Backend must expose bounds for GLOBAL_EXPLORATION"
120:     d = bounds.shape[1]
121:     sobol_seed = int(seed) if seed is not None else 0
122:     unit = SobolEngine(dimension=d, scramble=True, seed=sobol_seed).draw(n_samples).to(
123:         dtype=torch.double
124:     )
125:     X = bounds[0] + unit * (bounds[1] - bounds[0])
126:     backend.evaluate(X)
127: 
128: 
129: def _do_local_exploitation(backend: UnifiedBackend, action: OptimizationAction) -> None:
130:     step = float(action.params.get("step", 0.05))
131:     seed = action.params.get("seed")
132:     bounds = backend.bounds
133:     assert bounds is not None, "Backend must expose bounds for LOCAL_EXPLOITATION"
134:     history = backend.get_history()
135:     best_idx = int(history.objectives[:, 0].argmax().item())
136:     best_point = history.X[best_idx].clone()
137:     span = bounds[1] - bounds[0]
138:     rng = torch.Generator()
139:     rng.manual_seed(int(seed) if seed is not None else 0)
140:     delta = (torch.rand(best_point.shape, generator=rng, dtype=torch.double) * 2.0 - 1.0) * step * span
141:     candidate = (best_point + delta).clamp(min=bounds[0], max=bounds[1]).unsqueeze(0)
142:     backend.evaluate(candidate)
143: 
144: 
145: def _do_surrogate_acquisition(backend: UnifiedBackend) -> None:
146:     if not backend.is_fitted:
147:         backend.fit()
148:     X_new = backend.propose(n=1)
149:     backend.evaluate(X_new)
150: 
151: 
152: def _do_uncertainty_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
153:     """Sample where the GP posterior std is highest.
154: 
155:     Fits GP if needed. Uses a Sobol grid to evaluate std, then picks the
156:     top-n_samples points.
157:     """
158:     from torch.quasirandom import SobolEngine
159: 
160:     if not backend.is_fitted:
161:         backend.fit()
162:     n_samples = int(action.params.get("n_samples", 1))
163:     seed = action.params.get("seed")
164:     bounds = backend.bounds
165:     assert bounds is not None, "Backend must expose bounds for UNCERTAINTY_SAMPLING"
166:     d = bounds.shape[1]
167:     grid_unit = SobolEngine(dimension=d, scramble=True, seed=int(seed) if seed is not None else 0).draw(
168:         max(n_samples * 16, 64)
169:     ).to(dtype=torch.double)
170:     grid = bounds[0] + grid_unit * (bounds[1] - bounds[0])  # [G, d]
171:     _, std = backend.predict(grid)  # [G, 1]
172:     std_flat = std.flatten()
173:     top_idx = std_flat.argsort(descending=True)[:n_samples]  # top-n
174:     selected = grid[top_idx]  # [n, d]
175:     backend.evaluate(selected)
176: 
177: 
178: def _do_error_guided_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
179:     """Sample where the GP makes the largest prediction error on history.
180: 
181:     Phase 6 simplification: error = absolute residual (mean - observed objective)
182:     on training points. Sample near the top-error training point.
183:     """
184:     if not backend.is_fitted:
185:         backend.fit()
186:     n_samples = int(action.params.get("n_samples", 1))
187:     seed = action.params.get("seed")
188:     history = backend.get_history()
189:     mean, _ = backend.predict(history.X)
190:     err = (mean - history.objectives).abs().flatten()
191:     top_idx = int(err.argmax().item())
192:     top_point = history.X[top_idx]
193:     bounds = backend.bounds
194:     assert bounds is not None, "Backend must expose bounds for ERROR_GUIDED_SAMPLING"
195:     span = bounds[1] - bounds[0]
196:     rng = torch.Generator()
197:     rng.manual_seed(int(seed) if seed is not None else 0)
198:     delta = (torch.rand(top_point.shape, generator=rng, dtype=torch.double) * 2.0 - 1.0) * 0.05 * span
199:     candidates = (top_point + delta).clamp(min=bounds[0], max=bounds[1]).unsqueeze(0)
200:     if n_samples > 1:
201:         # repeat with different perturbations.
202:         candidates = candidates.repeat(n_samples, 1)
203:     backend.evaluate(candidates)
204: 
205: 
206: def _do_boundary_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
207:     """Sample points within `tol` of any bounds edge (Sobol candidates near edges).
208: 
209:     Does not require GP fit. Provides explicit boundary coverage signal.
210:     """
211:     from torch.quasirandom import SobolEngine
212: 
213:     n_samples = int(action.params.get("n_samples", 1))
214:     tol = float(action.params.get("tol", 0.05))
215:     seed = action.params.get("seed")


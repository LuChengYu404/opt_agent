60: def _rf_fold(train_records, test_records) -> dict:
61:     from sklearn.ensemble import RandomForestRegressor
62: 
63:     from _shared_rq_features import ACTIONS, extract_features
64:     from opt_agent.dataset import phase_of_ratio
65: 
66:     def feats(r):
67:         return extract_features(
68:             r.state, phase_of_ratio(
69:                 float(r.state["resource"]["remaining_budget_ratio"])
70:             )
71:         )
72: 
73:     # Train only on full-width records (all 8 actions valid) so the target
74:     # matrix is rectangular; test-side metrics are width-agnostic.
75:     X, Y = [], []
76:     n_train_skipped = 0
77:     for r in train_records:
78:         gold = _raw_gold(r)
79:         if gold is None:
80:             continue
81:         if set(gold) != set(ACTIONS):
82:             n_train_skipped += 1
83:             continue
84:         X.append(feats(r))
85:         Y.append([gold[a] for a in ACTIONS])
86:     rf = RandomForestRegressor(
87:         n_estimators=200, max_depth=8, min_samples_leaf=5,
88:         random_state=0, n_jobs=8,
89:     )
90:     rf.fit(X, Y)
91:     correct = total = top1 = n = 0
92:     for r in test_records:
93:         gold = _raw_gold(r)
94:         if gold is None:
95:             continue
96:         pred_vec = rf.predict([feats(r)])[0]
97:         pred = dict(zip(ACTIONS, pred_vec))
98:         c, t, m = _rf_pairwise_and_top1(pred, gold)
99:         correct += c
100:         total += t
101:         top1 += m
102:         n += 1
103:     return {
104:         "pairwise_accuracy": correct / total if total else 0.0,
105:         "top1_agreement": top1 / n if n else 0.0,
106:         "records": n,
107:         "train_records_full_width": len(X),
108:         "train_records_skipped_partial": n_train_skipped,
109:     }
110: 

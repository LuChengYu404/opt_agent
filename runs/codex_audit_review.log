36:     """Uniformly samples one of the 5 action types with valid params.
37: 
38:     GLOBAL_EXPLORATION's n_samples is bounded by `state.resource.remaining_budget`.
39:     RulePolicy mirrors the same logic (no point in proposing more than that).
40:     """
41: 
42:     def __init__(self, seed: int = 0) -> None:
43:         self._rng = random.Random(seed)
44:         self._initial_seed = seed
45: 
46:     def reset(self) -> None:
47:         self._rng = random.Random(self._initial_seed)
48: 
49:     def select_action(
50:         self, state: OptimizationState, backend: UnifiedBackend | None = None
51:     ) -> OptimizationAction:
52:         remaining = state.resource.remaining_budget
53:         if remaining <= 0:
54:             return OptimizationAction(ActionType.STOP)
55: 
56:         action_type = self._rng.choice(list(ActionType))
57:         params = sample_params(action_type, remaining, self._rng)
58:         if not params:
59:             return OptimizationAction(action_type)
60:         return OptimizationAction(action_type, params)
61: 

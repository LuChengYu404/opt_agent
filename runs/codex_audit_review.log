65:         float(resource.get("remaining_budget_ratio", 0.0) or 0.0),
66:         1.0 if surrogate.get("is_current", False) else 0.0,
67:         1.0 if phase == "early" else 0.0,
68:         1.0 if phase == "mid" else 0.0,
69:         1.0 if phase == "late" else 0.0,
70:     ]
71:     # Sanitize non-finite to 0.0 (training will skip if all 0).
72:     feat = [0.0 if not math.isfinite(v) else v for v in feat]
73:     return feat

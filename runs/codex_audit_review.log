    36	
    37	def _policies():
    38	    """Lazy imports to keep this module importable without torch."""
    39	    from opt_agent.actions import candidate_actions_for_state
    40	    from opt_agent.loop.policies import RulePolicy
    41	
    42	    class RuleFullBudget(RulePolicy):
    43	        LOW_BUDGET_THRESHOLD = 0
    44	
    45	    class AlwaysSurrogatePolicy:
    46	        """Always pick SURROGATE_ACQUISITION — the 'smart BO baseline'."""
    47	
    48	        def __init__(self, seed: int = 0) -> None:
    49	            self.seed = seed
    50	
    51	        def select_action(self, state, backend=None):
    52	            choices = candidate_actions_for_state(state, seed=self.seed)
    53	            if "surrogate_acquisition" in choices:
    54	                return choices["surrogate_acquisition"]
    55	            return next(iter(choices.values()))
    56	
    57	    return RuleFullBudget, AlwaysSurrogatePolicy
    58	
    59	
    60	def make_rule_full_budget(seed: int = 0):
    61	    RuleFullBudget, _ = _policies()
    62	    return RuleFullBudget(seed=seed)
    63	
    64	
    65	def make_always_surrogate(seed: int = 0):

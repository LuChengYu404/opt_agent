63: class RulePolicy:
64:     """Simple rule-based policy (Phase 4 baseline).
65: 
66:     Default action: SURROGATE_ACQUISITION.
67:     Switch to GLOBAL_EXPLORATION with n_samples=2 after 3 stagnant steps.
68:     Return STOP when remaining budget <= 4.
69:     """
70: 
71:     STAGNATION_THRESHOLD = 3
72:     LOW_BUDGET_THRESHOLD = 4
73: 
74:     def __init__(self, seed: int = 0) -> None:
75:         self._seed = seed
76: 
77:     def reset(self) -> None:
78:         # Stateless — no RNG.
79:         pass
80: 
81:     def select_action(
82:         self, state: OptimizationState, backend: UnifiedBackend | None = None
83:     ) -> OptimizationAction:
84:         if state.resource.remaining_budget <= self.LOW_BUDGET_THRESHOLD:
85:             return OptimizationAction(ActionType.STOP)
86:         if (
87:             state.optimization.stagnation_steps >= self.STAGNATION_THRESHOLD
88:             and state.resource.remaining_budget >= 2
89:         ):
90:             return OptimizationAction(
91:                 ActionType.GLOBAL_EXPLORATION,
92:                 {"n_samples": 2, "seed": self._seed + state.sampling.n_samples},
93:             )
94:         return OptimizationAction(ActionType.SURROGATE_ACQUISITION)
95: 

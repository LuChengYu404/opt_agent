113: def per_record_laya(model, tok, records, device_str: str) -> dict[str, tuple]:
114:     """record_id → (correct, total, top1, log_score) for a Laya model.
115: 
116:     Single-record batches; CPU or CUDA per `device_str`. Uses the same
117:     prompt/item builder as training (`rlcd.build_item`) and the
118:     proper_reward log floor for comparability with training rewards.
119:     """
120:     import torch
121: 
122:     from opt_agent.system1.rlcd import _collate, build_item
123: 
124:     device = torch.device(device_str)
125:     was_training = model.training
126:     model.to(device).eval()
127:     out: dict[str, tuple] = {}
128:     with torch.no_grad():
129:         for r in records:
130:             item = build_item(r, tok, max_len=512, head_max_len=192)
131:             gold = raw_gold(r)
132:             if item is None or gold is None:
133:                 continue
134:             batch = _collate([item], tok.pad_token_id)
135:             tensors = {k: v.to(device) for k, v in batch.items()
136:                        if torch.is_tensor(v)}
137:             with torch.autocast(device_type=device.type,
138:                                 dtype=torch.bfloat16,
139:                                 enabled=device.type == "cuda"):
140:                 logits, _ = model(
141:                     tensors["input_ids"], tensors["attention_mask"],
142:                     tensors["marker_pos"], tensors["marker_mask"],
143:                     tensors["qtype"],
144:                 )
145:             row = logits[0].float().cpu()
146:             index_of = {a: i for i, a in enumerate(item["option_ids"])}
147:             correct = sum(int(row[i] > row[j]) for i, j, _ in item["pairs"])
148:             log_score = None
149:             if item.get("target") is not None:
150:                 logq = torch.log_softmax(row, -1).clamp_min(FLOOR)
151:                 t = torch.tensor(item["target"], dtype=logq.dtype)
152:                 log_score = float((t * logq).sum())
153:             out[r.id] = (
154:                 correct, len(item["pairs"]),
155:                 int(max(gold, key=lambda a: float(row[index_of[a]]))
156:                     == max(gold, key=lambda a: gold[a])),
157:                 log_score,
158:             )
159:     if not was_training:
160:         model.eval()
161:     model.to("cpu")
162:     return out

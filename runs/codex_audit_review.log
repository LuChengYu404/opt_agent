64: def sample_params(
65:     action_type: ActionType,
66:     remaining_budget: int,
67:     rng: "random.Random",
68: ) -> dict:
69:     """Generate a random parameter dict for an action that requires one.
70: 
71:     Used by ``RandomPolicy`` and ``UniformPolicy`` (and any other
72:     ablation policy that needs a budget-feasible random action). The
73:     candidate vocabulary and per-action defaults are in
74:     ``ALL_CANDIDATE_SPECS``; this function handles the four
75:     parameterised sampling actions plus LOCAL_EXPLOITATION.
76: 
77:     Param-free actions (``SURROGATE_ACQUISITION``, ``RETRAIN_SURROGATE``,
78:     ``STOP``) return an empty dict — the caller should then ``_make`` it
79:     directly without a ``sample_params`` step.
80:     """
81:     import random
82:     if action_type == ActionType.GLOBAL_EXPLORATION:
83:         n = rng.randint(1, min(3, remaining_budget))
84:         return {"n_samples": n, "seed": rng.randint(0, 10_000)}
85:     if action_type == ActionType.LOCAL_EXPLOITATION:
86:         return {
87:             "step": round(rng.uniform(0.01, 0.2), 4),
88:             "seed": rng.randint(0, 10_000),

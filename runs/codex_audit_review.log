38: def paired_bootstrap(
39:     per_rec_a: dict[str, tuple[int, int, int, float]],
40:     per_rec_b: dict[str, tuple[int, int, int, float]],
41:     *,
42:     repetitions: int = 2000,
43:     seed: int = 0,
44: ) -> tuple[float, float, float]:
45:     """Bootstrap CI for accuracy(A) − accuracy(B), clustered by record."""
46:     ids = sorted(set(per_rec_a) & set(per_rec_b))
47:     rng = random.Random(seed)
48:     n = len(ids)
49:     tot_pairs = sum(per_rec_a[i][1] for i in ids)
50:     diffs = []
51:     for _ in range(repetitions):
52:         ca = cb = 0
53:         for _ in range(n):
54:             rid = ids[rng.randrange(n)]
55:             ca += per_rec_a[rid][0]
56:             cb += per_rec_b[rid][0]
57:         diffs.append(ca / max(1, tot_pairs) - cb / max(1, tot_pairs))
58:     diffs.sort()
59:     return diffs[int(0.025 * repetitions)], diffs[int(0.975 * repetitions)], (
60:         sum(d > 0 for d in diffs) / repetitions
61:     )

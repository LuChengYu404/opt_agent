164: 
165: def paired_accuracy_diffs(a: Mapping[str, tuple],
166:                           b: Mapping[str, tuple]) -> list[float]:
167:     """Record-clustered per-record accuracy differences (a − b)."""
168:     ids = sorted(set(a) & set(b))
169:     out = []
170:     for i in ids:
171:         ca, ta = a[i][0], a[i][1]
172:         cb, tb = b[i][0], b[i][1]
173:         if ta == 0 or tb == 0:
174:             continue
175:         out.append(ca / ta - cb / tb)
176:     return out


76: def extract_utilities(record_dict: dict, family_scales: dict) -> dict[str, float] | None:
77:     """Extract U(s, a) under family_median scale normalization."""
78:     fam = record_dict["problem"]["family"]
79:     new_scale = family_scales[fam]["median"]
80:     md = record_dict.get("metadata", {}) or {}
81:     old_scale = float(md.get("optimization_scale", 1.0))
82:     w_opt = float(md.get("utility_weights", {}).get("w_optimization", 1.0))
83:     if new_scale <= 0 or old_scale <= 0:
84:         return None
85:     rr = record_dict.get("rollout_results") or {}
86:     out = {}
87:     for action in ACTIONS:
88:         cell = rr.get(action, {})
89:         if not isinstance(cell, dict):
90:             continue
91:         u_orig = cell.get("utility")
92:         d_opt = cell.get("delta_optimization")
93:         if u_orig is None or d_opt is None:
94:             continue
95:         try:
96:             u_orig = float(u_orig)
97:             d_opt = float(d_opt)
98:         except (TypeError, ValueError):
99:             continue
100:         if not (math.isfinite(u_orig) and math.isfinite(d_opt)):
101:             continue
102:         u_new = u_orig + w_opt * d_opt * (1.0 / new_scale - 1.0 / old_scale)
103:         out[action] = u_new
104:     return out if len(out) >= 2 else None
105: 
106: 
107: def compute_family_scales(records: list[dict]) -> dict[str, dict[str, float]]:
108:     by_fam = defaultdict(list)
109:     for r in records:

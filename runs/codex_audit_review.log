    70	def bootstrap_ci(values: list[float], repetitions: int = 2000,
    71	                 seed: int = 0) -> tuple[float, float]:
    72	    """Percentile-bootstrap 95% CI for the mean of `values`."""
    73	    if not values:
    74	        return (0.0, 0.0)
    75	    rng = random.Random(seed)

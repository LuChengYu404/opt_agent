   239	    mask = nearest < tol
   240	    qualifying = mask.nonzero(as_tuple=False).flatten()
   241	    if qualifying.numel() >= n_samples:
   242	        # Take the qualifying indices, sorted by distance to edge (closest first).
   243	        top_idx = qualifying[nearest[qualifying].argsort()[:n_samples]]
   244	    else:
   245	        # Fallback: not enough near-boundary points — take the n closest overall.
   246	        top_idx = nearest.argsort()[:n_samples]
   247	    selected = grid[top_idx]
   248	    backend.evaluate(selected)


   119	def _do_global_exploration(backend: UnifiedBackend, action: OptimizationAction) -> None:
   120	    n_samples = int(action.params.get("n_samples", 1))
   121	    seed = action.params.get("seed")
   122	    bounds = backend.bounds
   123	    assert bounds is not None, "Backend must expose bounds for GLOBAL_EXPLORATION"
   124	    d = bounds.shape[1]
   125	    sobol_seed = int(seed) if seed is not None else 0
   126	    unit = SobolEngine(dimension=d, scramble=True, seed=sobol_seed).draw(n_samples).to(
   127	        dtype=torch.double
   128	    )
   129	    X = bounds[0] + unit * (bounds[1] - bounds[0])
   130	    backend.evaluate(X)
   131	
   132	
   133	def _do_local_exploitation(backend: UnifiedBackend, action: OptimizationAction) -> None:
   134	    # Fallback step 0.1 matches the factory's canonical LOCAL_EXPLOITATION
   135	    # spec (actions.factory.ALL_CANDIDATE_SPECS).
   136	    step = float(action.params.get("step", 0.1))
   137	    seed = action.params.get("seed")
   138	    bounds = backend.bounds
   139	    assert bounds is not None, "Backend must expose bounds for LOCAL_EXPLOITATION"
   140	    history = backend.get_history()
   141	    best_idx = int(history.objectives[:, 0].argmax().item())
   142	    best_point = history.X[best_idx].clone()
   143	    span = bounds[1] - bounds[0]
   144	    rng = torch.Generator()
   145	    rng.manual_seed(int(seed) if seed is not None else 0)
   146	    delta = (torch.rand(best_point.shape, generator=rng, dtype=torch.double) * 2.0 - 1.0) * step * span
   147	    candidate = (best_point + delta).clamp(min=bounds[0], max=bounds[1]).unsqueeze(0)
   148	    backend.evaluate(candidate)
   149	
   150	
   151	def _do_surrogate_acquisition(backend: UnifiedBackend) -> None:
   152	    if not backend.is_fitted:
   153	        backend.fit()

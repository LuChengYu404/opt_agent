    48	    # actions in early phase; rises above them in late phase. Set to 0 to
    49	    # disable the STOP opportunity penalty.
    50	    w_stop_opportunity: float = 0.75
    51	
    52	    def to_dict(self) -> dict[str, float]:
    53	        """Single-source-of-truth dict form used by JSONL metadata."""
    54	        return {
    55	            "w_optimization": self.w_optimization,
    56	            "w_surrogate": self.w_surrogate,
    57	            "w_coverage": self.w_coverage,
    58	            "w_evaluation": self.w_evaluation,
    59	            "w_fit": self.w_fit,
    60	            "w_stop_opportunity": self.w_stop_opportunity,
    61	        }
    62	
    63	    @classmethod
    64	    def from_dict(cls, data: dict[str, Any]) -> "UtilityWeights":
    65	        """Reverse of ``to_dict``. Missing fields fall back to defaults."""
    66	        return cls(
    67	            w_optimization=float(data.get("w_optimization", 1.0)),
    68	            w_surrogate=float(data.get("w_surrogate", 0.0)),
    69	            w_coverage=float(data.get("w_coverage", 0.0)),
    70	            w_evaluation=float(data.get("w_evaluation", 1.0)),
    71	            w_fit=float(data.get("w_fit", 0.5)),
    72	            w_stop_opportunity=float(data.get("w_stop_opportunity", 0.75)),
    73	        )
    74	

    38	      - w_stop_opportunity = 0: disables the optional linear STOP penalty
    39	        (proportional to remaining_budget_ratio). The DEFAULT is 0.75
    40	        (Phase 8.5, codex-empirical), not 0.
    41	    """
    42	    w_optimization: float = 1.0
    43	    w_surrogate: float = 0.0
    44	    w_coverage: float = 0.0
    45	    w_evaluation: float = 1.0
    46	    w_fit: float = 0.5

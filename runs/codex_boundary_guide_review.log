   158	def _do_uncertainty_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
   159	    """Sample where the GP posterior std is highest.
   160	
   161	    Fits GP if needed. Uses a Sobol grid to evaluate std, then picks the
   162	    top-n_samples points.
   163	    """
   164	    from torch.quasirandom import SobolEngine
   165	
   166	    if not backend.is_fitted:
   167	        backend.fit()
   168	    n_samples = int(action.params.get("n_samples", 1))
   169	    seed = action.params.get("seed")
   170	    bounds = backend.bounds
   171	    assert bounds is not None, "Backend must expose bounds for UNCERTAINTY_SAMPLING"
   172	    d = bounds.shape[1]
   173	    grid_unit = SobolEngine(dimension=d, scramble=True, seed=int(seed) if seed is not None else 0).draw(
   174	        max(n_samples * 16, 64)
   175	    ).to(dtype=torch.double)
   176	    grid = bounds[0] + grid_unit * (bounds[1] - bounds[0])  # [G, d]
   177	    _, std = backend.predict(grid)  # [G, 1]
   178	    std_flat = std.flatten()
   179	    top_idx = std_flat.argsort(descending=True)[:n_samples]  # top-n
   180	    selected = grid[top_idx]  # [n, d]
   181	    backend.evaluate(selected)
   182	
   183	
   184	def _do_error_guided_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
   185	    """Sample where the GP makes the largest prediction error on history.
   186	
   187	    Phase 6 simplification: error = absolute residual (mean - observed objective)
   188	    on training points. Sample near the top-error training point.
   189	    """
   190	    if not backend.is_fitted:
   191	        backend.fit()
   192	    n_samples = int(action.params.get("n_samples", 1))
   193	    seed = action.params.get("seed")
   194	    history = backend.get_history()
   195	    mean, _ = backend.predict(history.X)
   196	    err = (mean - history.objectives).abs().flatten()
   197	    top_idx = int(err.argmax().item())
   198	    top_point = history.X[top_idx]
   199	    bounds = backend.bounds
   200	    assert bounds is not None, "Backend must expose bounds for ERROR_GUIDED_SAMPLING"
   201	    span = bounds[1] - bounds[0]
   202	    rng = torch.Generator()
   203	    rng.manual_seed(int(seed) if seed is not None else 0)
   204	    n = max(1, int(n_samples))
   205	    delta = (
   206	        torch.rand((n, top_point.shape[0]), generator=rng, dtype=torch.double) * 2.0 - 1.0
   207	    ) * 0.05 * span
   208	    candidates = (top_point.unsqueeze(0) + delta).clamp(
   209	        min=bounds[0], max=bounds[1]
   210	    )
   211	    backend.evaluate(candidates)
   212	
   213	
   214	def _do_boundary_sampling(backend: UnifiedBackend, action: OptimizationAction) -> None:
   215	    """Sample points within `tol` of any bounds edge (Sobol candidates near edges).
   216	
   217	    Does not require GP fit. Provides explicit boundary coverage signal.
   218	    """
   219	    from torch.quasirandom import SobolEngine
   220	
   221	    n_samples = int(action.params.get("n_samples", 1))
   222	    tol = float(action.params.get("tol", 0.05))
   223	    seed = action.params.get("seed")
   224	    bounds = backend.bounds
   225	    assert bounds is not None, "Backend must expose bounds for BOUNDARY_SAMPLING"
   226	    d = bounds.shape[1]
   227	    grid_unit = SobolEngine(dimension=d, scramble=True, seed=int(seed) if seed is not None else 0).draw(
   228	        max(n_samples * 32, 128)
   229	    ).to(dtype=torch.double)
   230	    grid = bounds[0] + grid_unit * (bounds[1] - bounds[0])
   231	    # Pick points closest to any bounds edge.
   232	    span = (bounds[1] - bounds[0]).clamp(min=1e-12)
   233	    dist_to_edge = torch.minimum(grid - bounds[0], bounds[1] - grid) / span
   234	    nearest = dist_to_edge.min(dim=-1).values
   235	    # Phase 8.5 fix: select points whose `nearest < tol`, not "first n non-zero".
   236	    # Previously `nearest.argwhere()[:n_samples]` returned the first n indices of
   237	    # the Sobol grid regardless of their actual distance to the edge — making

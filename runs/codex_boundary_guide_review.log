    96	        delta_optimization is non-finite (programmer error).
    97	    """
    98	    if not math.isfinite(delta_optimization):
    99	        raise ValueError("delta_optimization must be finite")
   100	    scales = (optimization_scale, evaluation_scale, fit_scale)
   101	    if not all(math.isfinite(x) and x > 0 for x in scales):
   102	        raise ValueError(
   103	            f"utility scales must be finite and positive; got {scales}"
   104	        )
   105	    if n_new_samples < 0 or n_model_fits < 0:
   106	        raise ValueError("resource counts must be non-negative")

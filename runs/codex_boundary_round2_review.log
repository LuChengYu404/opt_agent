   225	        "predeclared_rule": (
   226	            "POSITIVE iff (>=2 families CI-significant in opposite directions) "
   227	            "or (meta-D bootstrap CI excludes zero); else NEGATIVE"
   228	        ),
   229	        "families": args.families,
   230	        "seeds": args.seeds,
   231	        "budget": args.budget,
   232	        "configs": CONFIGS,
   233	        "policy": "AlwaysSurrogate (pinned)",
   234	        "n_evals_observed": sorted(n_evals),
   235	        "per_family": {
   236	            fam: {k: v for k, v in row.items() if k != "per_seed_diffs"}
   237	            for fam, row in per_family.items()
   238	        },
   239	        "meta_d": {
   240	            "point": d_meta_point,
   241	            "ci95": d_meta_ci,
   242	            "ci_excludes_zero": d_meta_sig,
   243	            "per_family_u": fam_stats,
   244	            "note": "D_meta = E_f[max_a u_af] - max_a E_f[u_af] on "
   245	                    "family-standardized terminal best; >0 iff per-family "
   246	                    "config advantage varies beyond its cross-family mean",
   247	        },
   248	        "significant_families": sig,
   249	        "opposite_direction_families": {"large_wins": pos, "small_wins": neg},
   250	        "verdict": verdict,
   251	        "wall_seconds": elapsed,
   252	    }
   253	    args.output.parent.mkdir(parents=True, exist_ok=True)
   254	    args.output.write_text(json.dumps(payload, indent=2), encoding="utf-8")
   255	    print(json.dumps({k: payload[k] for k in

   108	        f"guide §2.4 rows {sorted(rows)} != menu {sorted(a.value for a in ActionType)}"
   109	    )
   110	    for action, entry in BOUNDARY_REGISTRY.items():
   111	        guide_class, _, line = rows[action.value]
   112	        assert guide_class == entry.boundary_class, (
   113	            f"{action.value}: guide says {guide_class!r}, registry says "
   114	            f"{entry.boundary_class!r} (row: {line!r})"

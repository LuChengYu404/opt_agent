     1	"""Dataset / harness version stamps — code-side half of guide §4.5 + §6.6.
     2	
     3	Discipline (RESEARCH_BOUNDARY_GUIDE.md):
     4	
     5	- ``HARNESS_VERSION`` freezes the measurement system: observation format
     6	  (state features), action menu, and label pipeline. Any change to state
     7	  features, the ActionType menu, or any S-class supervision-defining
     8	  component (§6.6) REQUIRES a bump.
     9	- ``UTILITY_VERSION`` is the finer stamp: it tracks the S-class label
    10	  definition only (utility weights/scales, continuation policy, rollout
    11	  horizon, gold temperature, action-subset quota, replicate count).
    12	
    13	Reading rule (:func:`check_record_versions`):
    14	
    15	- ``OK``       — record carries the current stamps; poolable.
    16	- ``LEGACY``   — stamp missing (records predate the mechanism) or holds a
    17	  known-past value: readable, but must not be pooled with current-version
    18	  records without an explicit same-data A/B note (§6.6 rule 1).
    19	- ``MISMATCH`` — stamp is not a recognized value (e.g. a future version
    20	  read by older code): refuse to pool.
    21	
    22	Known-past values are listed in ``_KNOWN_PAST``; extend it when bumping
    23	either constant so old data reads as LEGACY rather than MISMATCH.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	from enum import Enum
    29	from typing import Any, Mapping
    30	
    31	HARNESS_VERSION = "h1"
    32	UTILITY_VERSION = "phase8.6b"
    33	
    34	# Stamps that may appear in historical records. "phase8.6b" doubles as the
    35	# current UTILITY_VERSION; harness_version was simply absent before h1.
    36	_KNOWN_PAST: dict[str, set[str]] = {
    37	    "harness": set(),  # h1 is the first stamped harness version
    38	    "utility": set(),  # phase8.6b is the first formalized utility version
    39	}
    40	
    41	
    42	class VersionStatus(str, Enum):
    43	    OK = "ok"
    44	    LEGACY = "legacy"
    45	    MISMATCH = "mismatch"
    46	
    47	
    48	def stamp_metadata(
    49	    metadata: Mapping[str, Any] | None,
    50	    *,
    51	    harness_version: str = HARNESS_VERSION,
    52	    utility_version: str = UTILITY_VERSION,
    53	) -> dict[str, Any]:
    54	    """Return a copy of ``metadata`` with both version stamps applied.
    55	
    56	    Existing stamp keys are overwritten (the caller is generating records
    57	    with the current code, whose stamps ARE the current constants).
    58	    """
    59	    out = dict(metadata) if metadata else {}
    60	    out["harness_version"] = harness_version
    61	    out["utility_version"] = utility_version
    62	    return out
    63	
    64	
    65	def check_record_versions(
    66	    record_metadata: Mapping[str, Any],
    67	) -> dict[str, VersionStatus]:
    68	    """Classify a record's stamps against the current constants.
    69	
    70	    ``record_metadata`` is the ``metadata`` dict of a DecisionRecord (the
    71	    stamps live at its top level; see the generator).
    72	    """
    73	    return {
    74	        "harness": _status(record_metadata.get("harness_version"),
    75	                           HARNESS_VERSION, "harness"),
    76	        "utility": _status(record_metadata.get("utility_version"),
    77	                           UTILITY_VERSION, "utility"),
    78	    }
    79	
    80	
    81	def _status(stamp: Any, current: str, axis: str) -> VersionStatus:
    82	    if stamp == current:
    83	        return VersionStatus.OK
    84	    if stamp is None or stamp in _KNOWN_PAST.get(axis, set()):
    85	        return VersionStatus.LEGACY
    86	    return VersionStatus.MISMATCH
     1	"""Version-stamp tests — enforce RESEARCH_BOUNDARY_GUIDE.md §4.5 + §6.6.
     2	
     3	Covers: stamp_metadata wiring, status classification (ok/legacy/mismatch),
     4	and that the dataset generator actually stamps newly produced records.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import sys
    10	from pathlib import Path
    11	
    12	sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    13	
    14	from opt_agent.dataset.versioning import (
    15	    HARNESS_VERSION,
    16	    UTILITY_VERSION,
    17	    VersionStatus,
    18	    check_record_versions,
    19	    stamp_metadata,
    20	)
    21	
    22	
    23	def test_stamp_metadata_adds_and_preserves():
    24	    out = stamp_metadata({"trajectory_id": 3})
    25	    assert out["trajectory_id"] == 3
    26	    assert out["harness_version"] == HARNESS_VERSION
    27	    assert out["utility_version"] == UTILITY_VERSION
    28	
    29	
    30	def test_stamp_metadata_overwrites_stale_stamps_and_handles_none():
    31	    out = stamp_metadata({"harness_version": "old", "utility_version": "x"})
    32	    assert out["harness_version"] == HARNESS_VERSION
    33	    assert out["utility_version"] == UTILITY_VERSION
    34	    assert stamp_metadata(None) == {
    35	        "harness_version": HARNESS_VERSION,
    36	        "utility_version": UTILITY_VERSION,
    37	    }
    38	
    39	
    40	def test_check_current_stamps_ok():
    41	    status = check_record_versions(stamp_metadata({}))
    42	    assert status["harness"] is VersionStatus.OK
    43	    assert status["utility"] is VersionStatus.OK
    44	
    45	
    46	def test_check_legacy_missing_harness_stamp():
    47	    """Pre-h1 records (utility stamped, harness absent) read as legacy."""
    48	    status = check_record_versions({"utility_version": UTILITY_VERSION})
    49	    assert status["harness"] is VersionStatus.LEGACY
    50	    assert status["utility"] is VersionStatus.OK
    51	
    52	
    53	def test_check_mismatch_future_stamp():
    54	    status = check_record_versions(
    55	        {"harness_version": "h99", "utility_version": UTILITY_VERSION}
    56	    )
    57	    assert status["harness"] is VersionStatus.MISMATCH
    58	    status = check_record_versions(
    59	        {"harness_version": HARNESS_VERSION, "utility_version": "phase9.z"}
    60	    )
    61	    assert status["utility"] is VersionStatus.MISMATCH
    62	
    63	
    64	def test_generator_wiring_uses_stamp_metadata():
    65	    """The generator module must route its metadata through stamp_metadata."""
    66	    import inspect
    67	
    68	    from opt_agent.dataset import generator
    69	
    70	    src = inspect.getsource(generator)
    71	    assert "stamp_metadata(" in src, (
    72	        "dataset/generator.py no longer wires version stamps via "
    73	        "stamp_metadata; restore the call or bump versions deliberately"
    74	    )
    75	    assert f'"utility_version":' not in src, (
    76	        "generator hardcodes utility_version; use the versioning constants"
    77	    )

   221	        if not pooling_note.strip():
   222	            raise VersionPolicyError(
   223	                f"{source}: pool_legacy=True requires a pooling_note "
   224	                f"describing the same-data A/B justification (guide 6.6 "
   225	                f"rule 1)")
   226	        entry = {"source": source, "note": pooling_note}
   227	        _recorded_pooling_decisions.append(entry)
   228	        _persist_pooling_decision(entry)
   229	        return
   230	    import warnings
   231	
   232	    for axis in ("harness", "utility"):
   233	        # An absent stamp counts as its own value: records that predate the
   234	        # stamp mechanism pool with stamped records only by explicit note.
   235	        values = sorted({str(s.get(f"{axis}_version")) for s in stamps})
   236	        if len(values) > 1:
   237	            msg = (f"{source}: mixes {axis} stamps {values}; pooling "
   238	                   f"across versions requires an explicit same-data A/B "
   239	                   f"note (guide 6.6 rule 1) — pass pool_legacy=True with "
   240	                   f"a pooling_note to record that decision")
   241	            if policy is VersionPolicy.STRICT:
   242	                raise VersionPolicyError(msg)
   243	            warnings.warn(msg, stacklevel=2)
   244	
   245	
   246	def stamp_metadata(
   247	    metadata: Mapping[str, Any] | None,
   248	    *,
   249	    harness_version: str = HARNESS_VERSION,
   250	    utility_version: str = UTILITY_VERSION,
   251	) -> dict[str, Any]:
   252	    """Return a copy of ``metadata`` with both version stamps applied.
   253	
   254	    Existing stamp keys are overwritten (the caller is generating records
   255	    with the current code, whose stamps ARE the current constants).
   256	    """
   257	    out = dict(metadata) if metadata else {}
   258	    out["harness_version"] = harness_version
   259	    out["utility_version"] = utility_version
   260	    return out
   261	
   262	
   263	def check_record_versions(
   264	    record_metadata: Mapping[str, Any],
   265	) -> dict[str, VersionStatus]:
   266	    """Classify a record's stamps against the current constants.
   267	
   268	    ``record_metadata`` is the ``metadata`` dict of a DecisionRecord (the
   269	    stamps live at its top level; see the generator).
   270	    """
   271	    return {
   272	        "harness": _status(record_metadata.get("harness_version"),
   273	                           HARNESS_VERSION, "harness"),
   274	        "utility": _status(record_metadata.get("utility_version"),
   275	                           UTILITY_VERSION, "utility"),
   276	    }
   277	
   278	
   279	def _status(stamp: Any, current: str, axis: str) -> VersionStatus:
   280	    if stamp == current:
   281	        return VersionStatus.OK
   282	    if stamp is None or stamp in _KNOWN_PAST.get(axis, set()):
   283	        return VersionStatus.LEGACY
   284	    return VersionStatus.MISMATCH


               f"| ECE {result['arms'][name]['raw']['ece15_argmax']:.4f} "
               f"-> {result['arms'][name]['tempered']['ece15_argmax']:.4f}",
               flush=True)
 
     Path("runs/exp_rlcd_calibration_ablation.json").write_text(

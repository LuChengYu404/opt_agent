     calib_ids = {r.id for r in calib}
     calib_n = sum(1 for item, _ in arms["bt"] if item["record_id"] in calib_ids)
 
     result = {"n_calib": calib_n, "n_held": len(arms["bt"]) - calib_n,
               "arms": {}}
     for name in ("bt", "proper"):

    41	def _parse_section_rows(section_text: str) -> dict[str, tuple[str, str, str]]:
    42	    """Strictly parse a §2.4-style markdown table.
    43	
    44	    Returns {action_value: (boundary_class, submenu, note)}. Raises
    45	    AssertionError on schema violations — the sync test must fail closed,
    46	    not skip quietly.
    47	    """
    48	    lines = section_text.splitlines()
    49	    header_hits = [i for i, ln in enumerate(lines)
    50	                   if ln.strip().startswith("| ActionType |")]
    51	    assert len(header_hits) == 1, (
    52	        f"expected exactly one §2.4 table, found {len(header_hits)}")
    53	    header_idx = header_hits[0]
    54	    header_cells = [c.strip() for c in lines[header_idx].strip().strip("|").split("|")]
    55	    assert len(header_cells) == 4 and tuple(header_cells) == EXPECTED_HEADER, (
    56	        f"unexpected §2.4 table header: {header_cells!r} "
    57	        f"(expected exactly {EXPECTED_HEADER})"
    58	    )
    59	    rows: dict[str, tuple[str, str, str]] = {}
    60	    table_ended = False
    61	    saw_row = False
    62	    for line in lines[header_idx + 1:]:
    63	        stripped = line.strip()
    64	        if not stripped.startswith("|"):
    65	            # ANY non-table line — blank included — ends the first table
    66	            # once a data row was seen; later '|' rows are a second table.
    67	            if saw_row:
    68	                table_ended = True
    69	            continue
    70	        assert not table_ended, (
    71	            "found a second markdown table inside section 2.4 — the sync "
    72	            "check covers exactly one table")
    73	        cells = [c.strip() for c in stripped.strip("|").split("|")]
    74	        if not (cells and cells[0].startswith("-")):
    75	            saw_row = True
    76	        if cells and cells[0].startswith("-"):
    77	            continue  # separator row
    78	        assert len(cells) == 4, (
    79	            f"malformed §2.4 row (needs exactly 4 cells, got {len(cells)}): "
    80	            f"{line!r}")
    81	        name, cls, submenu, note = cells
    82	        try:
    83	            action_value = ActionType[name].value
    84	        except KeyError:
    85	            raise AssertionError(
    86	                f"§2.4 row names unknown action {name!r}: {line!r}")
    87	        assert action_value not in rows, (
    88	            f"duplicate §2.4 row for {action_value!r}")
    89	        assert note, f"§2.4 row for {name} has an empty 备注 cell"
    90	        rows[action_value] = (cls, submenu, note)
    91	    return rows

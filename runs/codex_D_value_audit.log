     1	"""Shared RF probe feature/target extraction for RQ1.3 / RQ2.1.
     2	
     3	Both `exp_rq1_3_rf_probe.py` (Hartmann state-conditionality, leave-one-seed-out)
     4	and `exp_rq2_1_cross_family_transfer.py` (RQ2.1, leave-one-family-out) need
     5	the same feature extractor and utility recomputer under family_median
     6	normalization. Factoring them here prevents silent divergence if the
     7	schema changes.
     8	
     9	Used by:
    10	- scripts/exp_rq2_1_cross_family_transfer.py (RQ2 cross-family transfer)
    11	- scripts/exp_rlcd_loo_transfer.py / exp_rlcd_loo_confirmatory.py (RF
    12	  baseline arms, via local imports)
    13	
    14	Note: `exp_rq1_3_rf_probe.py` is an ARCHIVED script and intentionally keeps
    15	a frozen local copy of this logic (archive policy: archived scripts don't
    16	import shared modules); do not list it as a live consumer.
    17	
    18	Public API:
    19	    ACTIONS          : 8-tuple of action IDs (canonical order)
    20	    FAMILIES         : 5-tuple of family names (canonical order)
    21	    PHASE_VALUES     : 3-tuple of phase values (early, mid, late)
    22	    extract_features(state, phase) -> list[float]
    23	    extract_utilities(record_dict, family_scales) -> dict[str, float] | None
    24	    compute_family_scales(records) -> dict[str, dict[str, float]]
    25	"""
    26	from __future__ import annotations
    27	
    28	import math
    29	import statistics
    30	from collections import defaultdict
    31	from typing import Iterable
    32	
    33	ACTIONS = (
    34	    "global_exploration", "local_exploitation", "uncertainty_sampling",
    35	    "error_guided_sampling", "boundary_sampling", "surrogate_acquisition",
    36	    "retrain_surrogate", "stop",
    37	)
    38	
    39	FAMILIES = ("branin", "hartmann", "ackley", "sixhumpcamel", "rastrigin")
    40	
    41	PHASE_VALUES = ("early", "mid", "late")
    42	
    43	
    44	def extract_features(state: dict, phase: str) -> list[float]:
    45	    """15-dim state vector: 12 numeric + 3 phase one-hot.
    46	
    47	    Mirrors the original `exp_rq1_3_rf_probe.extract_features` so the two
    48	    scripts produce identical feature matrices for the same record.
    49	    """
    50	    sampling = state.get("sampling", {})
    51	    surrogate = state.get("surrogate", {})
    52	    optimization = state.get("optimization", {})
    53	    resource = state.get("resource", {})
    54	    feat = [
    55	        float(sampling.get("n_samples", 0) or 0),
    56	        float(sampling.get("dimension", 0) or 0),
    57	        float(sampling.get("min_pairwise_distance", 0.0) or 0.0),
    58	        float(sampling.get("boundary_coverage", 0.0) or 0.0),
    59	        float(surrogate.get("validation_rmse", 0.0) or 0.0),
    60	        float(surrogate.get("mean_uncertainty", 0.0) or 0.0),
    61	        float(surrogate.get("max_uncertainty", 0.0) or 0.0),
    62	        float(optimization.get("best_value", 0.0) or 0.0),
    63	        float(optimization.get("recent_improvement", 0.0) or 0.0),
    64	        float(optimization.get("stagnation_steps", 0) or 0),
    65	        float(resource.get("remaining_budget_ratio", 0.0) or 0.0),
    66	        1.0 if surrogate.get("is_current", False) else 0.0,
    67	        1.0 if phase == "early" else 0.0,
    68	        1.0 if phase == "mid" else 0.0,
    69	        1.0 if phase == "late" else 0.0,
    70	    ]
    71	    return [0.0 if not math.isfinite(v) else v for v in feat]
    72	
    73	
    74	def extract_utilities(
    75	    record_dict: dict, family_scales: dict
    76	) -> dict[str, float] | None:
    77	    """Recompute U(s, a) under family_median scale normalization.
    78	
    79	    Same math as the original `exp_rq1_3_rf_probe.extract_utilities`: rescale
    80	    from the record's `optimization_scale` to the family median so utilities
    81	    are comparable across families.
    82	
    83	    Returns None if any scale is non-positive or fewer than 2 actions have
    84	    finite utilities (record is unusable for training).
    85	    """
    86	    fam = record_dict["problem"]["family"]
    87	    new_scale = family_scales[fam]["median"]
    88	    md = record_dict.get("metadata", {}) or {}
    89	    old_scale = float(md.get("optimization_scale", 1.0))
    90	    w_opt = float(md.get("utility_weights", {}).get("w_optimization", 1.0))
    91	    if new_scale <= 0 or old_scale <= 0:
    92	        return None
    93	    rr = record_dict.get("rollout_results") or {}
    94	    out: dict[str, float] = {}
    95	    for action in ACTIONS:
    96	        cell = rr.get(action, {})
    97	        if not isinstance(cell, dict):
    98	            continue
    99	        u_orig = cell.get("utility")
   100	        d_opt = cell.get("delta_optimization")
   101	        if u_orig is None or d_opt is None:
   102	            continue
   103	        try:
   104	            u_orig = float(u_orig)
   105	            d_opt = float(d_opt)
   106	        except (TypeError, ValueError):
   107	            continue
   108	        if not (math.isfinite(u_orig) and math.isfinite(d_opt)):
   109	            continue
   110	        u_new = u_orig + w_opt * d_opt * (1.0 / new_scale - 1.0 / old_scale)
   111	        out[action] = u_new
   112	    return out if len(out) >= 2 else None
   113	
   114	
   115	def compute_family_scales(records: Iterable[dict]) -> dict[str, dict[str, float]]:
   116	    """Compute per-family median `optimization_scale` across records."""
   117	    by_fam: dict[str, list[float]] = defaultdict(list)
   118	    for r in records:
   119	        s = float((r.get("metadata") or {}).get("optimization_scale", 0.0))
   120	        if s > 0:
   121	            by_fam[r["problem"]["family"]].append(s)
   122	    return {fam: {"median": statistics.median(vals)} for fam, vals in by_fam.items()}


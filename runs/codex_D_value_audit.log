     1	"""EXP-RQ1.3 — Decision Landscape Analysis.
     2	
     3	Per the reframing proposed 2026-09-26: before arguing that a learned policy
     4	is valuable, we need to establish whether the benchmark contains
     5	"decision opportunity" — i.e., whether the utility difference between
     6	the best and second-best action is real and state-dependent.
     7	
     8	For each (problem, phase, seed) record in the 5-family dataset, compute:
     9	
    10	  - U(s, a): utility of action a in state s (already in rollout_results)
    11	  - ΔU(s): max_a U(s, a) - second_max_a U(s, a)
    12	  - R_sur(s): U(s, a*) - U(s, surrogate_acquisition)
    13	  - R_stop(s): U(s, a*) - U(s, stop)
    14	  - H(U)(s): Shannon entropy of the softmax-normalized utility vector
    15	
    16	Hypothesis (to test, NOT to assume):
    17	  - ΔU is small on Branin/Hartmann/SixHumpCamel/Ackley — utility landscape is
    18	    flat → no decision opportunity → no policy can add much value.
    19	  - ΔU is large on Rastrigin — utility landscape is peaked → decision
    20	    opportunity exists → explains why LLM beats AlwaysSurrogate there.
    21	
    22	Output: per-family distribution of these metrics, plus a CSV for the
    23	optional RandomForest probe in the next experiment.
    24	"""
    25	from __future__ import annotations
    26	
    27	import argparse
    28	import json
    29	import math
    30	import statistics
    31	import sys
    32	from collections import defaultdict
    33	from pathlib import Path
    34	
    35	ROOT = Path(__file__).resolve().parents[1]
    36	sys.path.insert(0, str(ROOT / "src"))
    37	
    38	from opt_agent.dataset import iter_jsonl, phase_of
    39	
    40	ACTIONS = (
    41	    "global_exploration", "local_exploitation", "uncertainty_sampling",
    42	    "error_guided_sampling", "boundary_sampling", "surrogate_acquisition",
    43	    "retrain_surrogate", "stop",
    44	)
    45	
    46	
    47	def utility_vector(record: dict) -> dict[str, float]:
    48	    """Extract U(s, a) for all 8 actions from a DecisionRecord."""
    49	    rr = record.get("rollout_results") or {}
    50	    out = {}
    51	    for action in ACTIONS:
    52	        cell = rr.get(action, {})
    53	        u = cell.get("utility") if isinstance(cell, dict) else None
    54	        if u is None or not math.isfinite(float(u)):
    55	            u = float("nan")
    56	        out[action] = float(u)
    57	    return out
    58	
    59	
    60	def metrics_for_state(u: dict[str, float]) -> dict:
    61	    """Compute ΔU, R_sur, R_stop, H(U) from a utility vector."""
    62	    vals = [(a, v) for a, v in u.items() if math.isfinite(v)]
    63	    if not vals:
    64	        return {"ΔU": float("nan"), "R_sur": float("nan"),
    65	                "R_stop": float("nan"), "H_U": float("nan"),
    66	                "a_star": None, "u_star": float("nan")}
    67	    vals.sort(key=lambda x: x[1], reverse=True)
    68	    a_star, u_star = vals[0]
    69	    second_u = vals[1][1] if len(vals) > 1 else u_star
    70	    u_sur = u.get("surrogate_acquisition", float("nan"))
    71	    u_stop = u.get("stop", float("nan"))
    72	    # Entropy over softmax-normalized utilities.
    73	    if u_star == vals[-1][1]:  # all equal
    74	        H = math.log(len(vals))
    75	    else:
    76	        shifted = [v - u_star for _, v in vals]
    77	        exps = [math.exp(s) for s in shifted]
    78	        Z = sum(exps)
    79	        ps = [e / Z for e in exps]
    80	        H = -sum(p * math.log(p) for p in ps if p > 0)
    81	    return {
    82	        "ΔU": u_star - second_u,
    83	        "R_sur": u_star - u_sur,
    84	        "R_stop": u_star - u_stop,
    85	        "H_U": H,
    86	        "a_star": a_star,
    87	        "u_star": u_star,
    88	    }
    89	
    90	
    91	def main() -> int:
    92	    parser = argparse.ArgumentParser()
    93	    parser.add_argument("dataset", type=Path)
    94	    parser.add_argument("--output", type=Path,
    95	                        default=ROOT / "runs" / "exp_rq1_3_landscape.json")
    96	    args = parser.parse_args()
    97	
    98	    records = list(iter_jsonl(args.dataset))
    99	    print(f"Loaded {len(records)} records from {args.dataset}")
   100	
   101	    # Aggregate per (family, phase).
   102	    by_fam_phase: dict[tuple[str, str], list[dict]] = defaultdict(list)
   103	    all_rows: list[dict] = []
   104	    for r in records:
   105	        u = utility_vector(r.__dict__)
   106	        m = metrics_for_state(u)
   107	        family = r.problem["family"]
   108	        # Use shared phase_of from validation.py (budget-ratio based).
   109	        phase = phase_of(r)
   110	        row = {"family": family, "phase": phase,
   111	               "record_id": r.id, "seed": int(r.problem["seed"])}
   112	        row.update(m)
   113	        all_rows.append(row)
   114	        by_fam_phase[(family, phase)].append(row)
   115	
   116	    summary = {}
   117	    for (fam, phase), rows in sorted(by_fam_phase.items()):
   118	        def stats(key):
   119	            vals = [r[key] for r in rows if math.isfinite(r[key])]
   120	            if not vals:
   121	                return None
   122	            return {
   123	                "n": len(vals),
   124	                "mean": statistics.fmean(vals),
   125	                "median": statistics.median(vals),
   126	                "min": min(vals),
   127	                "max": max(vals),
   128	            }
   129	        summary[f"{fam}/{phase}"] = {
   130	            "n_records": len(rows),
   131	            "ΔU": stats("ΔU"),
   132	            "R_sur": stats("R_sur"),
   133	            "R_stop": stats("R_stop"),
   134	            "H_U": stats("H_U"),
   135	        }
   136	
   137	    # Print per-family aggregates (collapsed across phases).
   138	    print()
   139	    print("=== Per-family aggregates (across phases) ===")
   140	    print(f"{'family':14s} {'n':>4s} "
   141	          f"{'ΔU mean':>10s} {'ΔU med':>10s} "
   142	          f"{'R_sur mean':>11s} {'R_stop mean':>12s} "
   143	          f"{'H_U mean':>10s}")
   144	    by_fam: dict[str, list[dict]] = defaultdict(list)
   145	    for r in all_rows:
   146	        by_fam[r["family"]].append(r)
   147	    for fam in sorted(by_fam):
   148	        rows = by_fam[fam]
   149	        n = len(rows)
   150	        dUs = [r["ΔU"] for r in rows if math.isfinite(r["ΔU"])]
   151	        Rs = [r["R_sur"] for r in rows if math.isfinite(r["R_sur"])]
   152	        Rst = [r["R_stop"] for r in rows if math.isfinite(r["R_stop"])]
   153	        Hs = [r["H_U"] for r in rows if math.isfinite(r["H_U"])]
   154	        print(f"{fam:14s} {n:>4d} "
   155	              f"{statistics.fmean(dUs):>10.4f} {statistics.median(dUs):>10.4f} "
   156	              f"{statistics.fmean(Rs):>11.4f} {statistics.fmean(Rst):>12.4f} "
   157	              f"{statistics.fmean(Hs):>10.4f}")
   158	
   159	    print()
   160	    print("=== Per (family, phase) ===")
   161	    for key in sorted(summary):
   162	        s = summary[key]
   163	        dU = s["ΔU"] or {}
   164	        Rs = s["R_sur"] or {}
   165	        Rst = s["R_stop"] or {}
   166	        Hu = s["H_U"] or {}
   167	        print(f"  {key:30s} n={s['n_records']:>3d} "
   168	              f"ΔU_mean={dU.get('mean', float('nan')):.4f} "
   169	              f"R_sur_mean={Rs.get('mean', float('nan')):.4f} "
   170	              f"R_stop_mean={Rst.get('mean', float('nan')):.4f} "
   171	              f"H_U_mean={Hu.get('mean', float('nan')):.4f}")
   172	
   173	    args.output.parent.mkdir(parents=True, exist_ok=True)
   174	    args.output.write_text(json.dumps({
   175	        "dataset": str(args.dataset),
   176	        "n_records": len(records),
   177	        "summary": summary,
   178	        "per_record": all_rows[:200],  # sample; full too big for json
   179	    }, indent=2, default=str) + "\n")
   180	    print(f"\nSaved: {args.output}")
   181	    return 0
   182	

     1	"""Numerical verification of the THEORY.md propositions on real data.
     2	
     3	P1 (affine invariance): for every rollout branch in the canonical 20-seed
     4	dataset, recompute `compute_utility` with an affinely transformed
     5	optimization delta and matching transformed scale, and assert the utility
     6	is unchanged — verifying the proposition through the actual code path.
     7	
     8	P2 (adaptive-value bound): recompute `D = E[max_a U] - max_a E[U]` per
     9	family from the same dataset under family-median normalization, verify
    10	D >= 0, and report D with the best constant action per family.
    11	
    12	Example:
    13	  uv run python scripts/verify_theory_propositions.py
    14	"""
    15	from __future__ import annotations
    16	
    17	import math
    18	import random
    19	import statistics
    20	import sys
    21	from collections import defaultdict
    22	from pathlib import Path
    23	
    24	ROOT = Path(__file__).resolve().parents[1]
    25	sys.path.insert(0, str(ROOT / "src"))
    26	sys.path.insert(0, str(ROOT / "scripts"))
    27	
    28	from _shared_rq_features import (  # noqa: E402
    29	    ACTIONS, FAMILIES, compute_family_scales, extract_utilities,
    30	)
    31	from opt_agent.dataset import iter_jsonl  # noqa: E402
    32	from opt_agent.rollout.utility import UtilityWeights, compute_utility  # noqa: E402
    33	
    34	DATASET = ROOT / "runs/phase8_6d_h3_20seed_5family.jsonl"
    35	
    36	
    37	def verify_p1(records: list[dict], rng: random.Random) -> dict:
    38	    checked, max_rel_err = 0, 0.0
    39	    weights = UtilityWeights()
    40	    for record in records:
    41	        md = record.get("metadata") or {}
    42	        scale = float(md.get("optimization_scale", 1.0))
    43	        if not (math.isfinite(scale) and scale > 0):
    44	            continue
    45	        for cell in (record.get("rollout_results") or {}).values():
    46	            if not isinstance(cell, dict):
    47	                continue
    48	            delta = cell.get("delta_optimization")
    49	            if delta is None or not math.isfinite(float(delta)):
    50	                continue
    51	            alpha = rng.uniform(0.05, 20.0)
    52	            beta = rng.uniform(-50.0, 50.0)
    53	            base = compute_utility(
    54	                delta_optimization=float(delta),
    55	                n_new_samples=int(cell.get("n_new_samples", 1)),
    56	                n_model_fits=int(cell.get("n_model_fits", 0)),
    57	                weights=weights, optimization_scale=scale,
    58	                evaluation_scale=float(md.get("evaluation_scale", 30.0)),
    59	                fit_scale=float(md.get("fit_scale", 30.0)),
    60	                is_stop=cell.get("action_id") == "stop",
    61	                remaining_budget_ratio=float(
    62	                    (record.get("state") or {}).get("resource", {})
    63	                    .get("remaining_budget_ratio", 0.0)),
    64	            )
    65	            # affine transform of the objective axis: delta and scale both
    66	            # scale by alpha (beta cancels in the difference by construction)
    67	            transformed = compute_utility(
    68	                delta_optimization=alpha * float(delta),
    69	                n_new_samples=int(cell.get("n_new_samples", 1)),
    70	                n_model_fits=int(cell.get("n_model_fits", 0)),
    71	                weights=weights, optimization_scale=alpha * scale,
    72	                evaluation_scale=float(md.get("evaluation_scale", 30.0)),
    73	                fit_scale=float(md.get("fit_scale", 30.0)),
    74	                is_stop=cell.get("action_id") == "stop",
    75	                remaining_budget_ratio=float(
    76	                    (record.get("state") or {}).get("resource", {})
    77	                    .get("remaining_budget_ratio", 0.0)),
    78	            )
    79	            if not (math.isfinite(base) and math.isfinite(transformed)):
    80	                continue
    81	            rel = (abs(transformed - base)
    82	                   / max(1e-12, abs(base), abs(alpha * float(delta)) * 1e-9))
    83	            max_rel_err = max(max_rel_err, rel)
    84	            checked += 1
    85	    return {"n_branches_checked": checked, "max_relative_error": max_rel_err}
    86	
    87	
    88	def verify_p2(records: list[dict]) -> dict:
    89	    scales = compute_family_scales(records)
    90	    per_family: dict[str, list[dict[str, float]]] = defaultdict(list)
    91	    for record in records:
    92	        utilities = extract_utilities(record, scales)
    93	        if utilities:
    94	            per_family[record["problem"]["family"]].append(utilities)
    95	    out = {}
    96	    for family in FAMILIES:
    97	        rows = per_family.get(family) or []
    98	        if not rows:
    99	            continue
   100	        oracle_mean = statistics.fmean(max(u[a] for a in u) for u in rows)
   101	        mean_by_action = {
   102	            action: statistics.fmean(u[action] for u in rows if action in u)
   103	            for action in ACTIONS
   104	        }
   105	        best_constant = max(mean_by_action, key=mean_by_action.get)
   106	        gap = oracle_mean - mean_by_action[best_constant]
   107	        out[family] = {
   108	            "n_records": len(rows),
   109	            "adaptive_value_D": gap,
   110	            "nonnegative": gap >= -1e-12,
   111	            "oracle_mean_utility": oracle_mean,
   112	            "best_constant_action": best_constant,
   113	            "best_constant_mean_utility": mean_by_action[best_constant],
   114	        }
   115	    return out
   116	
   117	
   118	def main() -> None:
   119	    records = [r.__dict__ for r in iter_jsonl(DATASET)]
   120	    rng = random.Random(20260927)
   121	    p1 = verify_p1(records, rng)
   122	    p2 = verify_p2(records)
   123	    report = {
   124	        "dataset": str(DATASET.relative_to(ROOT)),
   125	        "n_records": len(records),
   126	        "p1_affine_invariance": p1,
   127	        "p2_adaptive_value": p2,
   128	    }
   129	    print(f"dataset: {report['dataset']} ({len(records)} records)")
   130	    print(f"P1 affine invariance: {p1['n_branches_checked']} branches "
   131	          f"re-checked through compute_utility, "
   132	          f"max relative error {p1['max_relative_error']:.2e}")
   133	    print("P2 adaptive-value per family (family-median normalization):")
   134	    for family, row in p2.items():
   135	        print(f"  {family:14s} D={row['adaptive_value_D']:+.4f} "
   136	              f"(n={row['n_records']}) best constant action = "
   137	              f"{row['best_constant_action']} "
   138	              f"mean {row['best_constant_mean_utility']:+.4f} vs oracle "
   139	              f"{row['oracle_mean_utility']:+.4f} nonneg={row['nonnegative']}")
   140	    output = ROOT / "runs/verify_theory_propositions.json"
   141	    output.write_text(
   142	        __import__("json").dumps(report, indent=2, allow_nan=False) + "\n")
   143	    print(f"wrote {output}")
   144	    if p1["max_relative_error"] > 1e-9:
   145	        raise SystemExit("P1 FAILED: utility changed under affine transform")
   146	    if not all(row["nonnegative"] for row in p2.values()):
   147	        raise SystemExit("P2 FAILED: negative adaptive-value (Jensen violation)")
   148	
   149	
   150	if __name__ == "__main__":
   151	    main()


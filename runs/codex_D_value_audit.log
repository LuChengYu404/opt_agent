   302	def to_gold_probs(
   303	    results: tuple[CounterfactualResult, ...],
   304	    *,
   305	    temperature: float = 1.0,
   306	    include_invalid_as_zero: bool = False,
   307	) -> dict[str, float]:
   308	    """Convert CounterfactualResult utilities into softmax probabilities.
   309	
   310	    Parameters
   311	    ----------
   312	    include_invalid_as_zero : bool
   313	        If True, invalid candidates are included in the output dict with
   314	        probability 0.0 (preserves aligned vocabulary). Default False: only
   315	        valid candidates are returned (vocabulary may shrink).
   316	    """
   317	    if not results:
   318	        raise ValueError("results must not be empty")
   319	    if not math.isfinite(temperature) or temperature <= 0:
   320	        raise ValueError(
   321	            f"temperature must be finite and > 0; got {temperature}"
   322	        )
   323	    valid = [r for r in results if r.status == "valid"]
   324	    if not valid:
   325	        if not include_invalid_as_zero:
   326	            raise ValueError("no valid candidate actions")
   327	        # All invalid; emit zeros so vocabulary is preserved.
   328	        return {r.action_id: 0.0 for r in results}
   329	    utilities = np.asarray([r.utility for r in valid], dtype=np.float64)
   330	    if not np.isfinite(utilities).all():
   331	        raise ValueError("valid utilities must be finite")
   332	    z = utilities / temperature
   333	    z -= z.max()
   334	    probabilities = np.exp(z)
   335	    probabilities /= probabilities.sum()
   336	    valid_probs = {
   337	        r.action_id: float(p)
   338	        for r, p in zip(valid, probabilities, strict=True)
   339	    }
   340	    if include_invalid_as_zero:
   341	        for r in results:
   342	            if r.status != "valid":
   343	                valid_probs[r.action_id] = 0.0
   344	    return valid_probs


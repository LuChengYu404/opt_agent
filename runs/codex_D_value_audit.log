/bin/bash -lc "python - <<'PY'
import json,math,statistics,collections
from pathlib import Path
A=['global_exploration','local_exploitation','uncertainty_sampling','error_guided_sampling','boundary_sampling','surrogate_acquisition','retrain_surrogate','stop']
for path in [Path('runs/phase8_6d_h3_20seed_5family.jsonl'),Path('runs/phase8_6d_h3_20seed_5family_s100_119.jsonl'),Path('runs/phase8_6d_h3_10seed_5family.jsonl')]:
 rows=[json.loads(s) for s in path.open()]
 scales={f:statistics.median([r['metadata']['optimization_scale'] for r in rows if r['problem']['family']==f]) for f in {r['problem']['family'] for r in rows}}
 print('\\nDATA',path,len(rows),'scales',scales)
 for fam in sorted(scales):
  rs=[r for r in rows if r['problem']['family']==fam]
  statuses=collections.Counter(c.get('status') for r in rs for c in r['rollout_results'].values())
  counts=collections.Counter(len(r['rollout_results']) for r in rs)
  partial=sum('partial_rollout' in r.get('metadata',{}) for r in rs)
  horizons=collections.Counter((r['metadata'].get('horizon'),r['metadata'].get('horizon_mode')) for r in rs)
  seeds=collections.Counter(r['problem']['seed'] for r in rs)
  def calc(norm='orig',stop=True):
   uu=[]
   for r in rs:
    row={}
    for a in A:
     if a=='stop' and not stop:continue
     c=r['rollout_results'].get(a,{})
     if c.get('utility') is None or c.get('delta_optimization') is None:continue
     u=c['utility'];d=c['delta_optimization']
     if not(math.isfinite(u) and math.isfinite(d)):continue
     if norm=='median':u+=r['metadata']['utility_weights'].get('w_optimization',1)*d*(1/scales[fam]-1/r['metadata']['optimization_scale'])
     row[a]=u
    uu.append(row)
   oracle=statistics.fmean(max(v.values()) for v in uu)
   means={a:statistics.fmean(v[a] for v in uu if a in v) for a in A if a"'!='"'stop' or stop}
   best=max(means,key=means.get)
   return (oracle-means[best],oracle,means[best],best)
  print(fam,'n',len(rs),'seeds',len(seeds), 'seed_n',sorted(set(seeds.values())),'statuses',statuses,'actions',counts,'partial',partial,'h',horizons)
  print('  raw',calc(),'median',calc('median'),'median_no_stop',calc('median',False))

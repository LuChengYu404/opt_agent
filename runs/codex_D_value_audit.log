     1	"""Utility function for counterfactual rollouts (Phase 8.5 fix).
     2	
     3	Per MASTER_PLAN.md §10 and codex (gpt-5.6-sol) review 2025-09-23 + Phase 8.5
     4	empirical finding (STOP dominance):
     5	
     6	  U(a|s) = w_optimization * ΔQ_optimization / optimization_scale
     7	        + w_surrogate * ΔQ_surrogate
     8	        + w_coverage * ΔQ_coverage
     9	        − w_evaluation * n_new_samples / evaluation_scale
    10	        − w_fit * n_model_fits / fit_scale
    11	        − w_stop_opportunity * remaining_budget_ratio   (if is_stop)
    12	
    13	Scales (default 1.0) decouple problem units from weights: objective scale
    14	estimated per problem family, evaluation/fit scale = total_budget. Defaults
    15	preserve backward compatibility for tests that don't supply scales.
    16	
    17	NaN / Inf handling: non-finite delta_surrogate / delta_coverage are treated
    18	as 0; non-finite delta_optimization / scales raise ValueError (programmer
    19	error, not data uncertainty).
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import math
    25	from dataclasses import dataclass
    26	from typing import Any
    27	
    28	
    29	@dataclass(frozen=True)
    30	class UtilityWeights:
    31	    """Weights for the 5-term utility function.
    32	
    33	    Phase 8.5 defaults (per codex review):
    34	      - w_surrogate = 0: validation_rmse is in-sample training RMSE, not
    35	        leave-one-out; cannot be trusted until surrogate metric is fixed.
    36	      - w_coverage = 0: `boundary_coverage` is fraction near edge, not a
    37	        proper coverage metric; needs a grid/fill-distance version.
    38	      - w_stop_opportunity = 0: disables the optional linear STOP penalty
    39	        (proportional to remaining_budget_ratio). The DEFAULT is 0.75
    40	        (Phase 8.5, codex-empirical), not 0.
    41	    """
    42	    w_optimization: float = 1.0
    43	    w_surrogate: float = 0.0
    44	    w_coverage: float = 0.0
    45	    w_evaluation: float = 1.0
    46	    w_fit: float = 0.5
    47	    # Phase 8.5 default: 0.75 (codex-empirical) keeps STOP below non-STOP
    48	    # actions in early phase; rises above them in late phase. Set to 0 to
    49	    # disable the STOP opportunity penalty.
    50	    w_stop_opportunity: float = 0.75
    51	
    52	    def to_dict(self) -> dict[str, float]:
    53	        """Single-source-of-truth dict form used by JSONL metadata."""
    54	        return {
    55	            "w_optimization": self.w_optimization,
    56	            "w_surrogate": self.w_surrogate,
    57	            "w_coverage": self.w_coverage,
    58	            "w_evaluation": self.w_evaluation,
    59	            "w_fit": self.w_fit,
    60	            "w_stop_opportunity": self.w_stop_opportunity,
    61	        }
    62	
    63	    @classmethod
    64	    def from_dict(cls, data: dict[str, Any]) -> "UtilityWeights":
    65	        """Reverse of ``to_dict``. Missing fields fall back to defaults."""
    66	        return cls(
    67	            w_optimization=float(data.get("w_optimization", 1.0)),
    68	            w_surrogate=float(data.get("w_surrogate", 0.0)),
    69	            w_coverage=float(data.get("w_coverage", 0.0)),
    70	            w_evaluation=float(data.get("w_evaluation", 1.0)),
    71	            w_fit=float(data.get("w_fit", 0.5)),
    72	            w_stop_opportunity=float(data.get("w_stop_opportunity", 0.75)),
    73	        )
    74	
    75	
    76	def compute_utility(
    77	    *,
    78	    delta_optimization: float,
    79	    delta_surrogate: float = 0.0,
    80	    delta_coverage: float = 0.0,
    81	    n_new_samples: int,
    82	    n_model_fits: int,
    83	    weights: UtilityWeights,
    84	    optimization_scale: float = 1.0,
    85	    evaluation_scale: float = 1.0,
    86	    fit_scale: float = 1.0,
    87	    is_stop: bool = False,
    88	    remaining_budget_ratio: float = 0.0,
    89	) -> float:
    90	    """Scalar utility of a counterfactual branch.
    91	
    92	    Raises
    93	    ------
    94	    ValueError
    95	        If any scale is non-positive, counts are negative, or
    96	        delta_optimization is non-finite (programmer error).
    97	    """
    98	    if not math.isfinite(delta_optimization):
    99	        raise ValueError("delta_optimization must be finite")
   100	    scales = (optimization_scale, evaluation_scale, fit_scale)
   101	    if not all(math.isfinite(x) and x > 0 for x in scales):
   102	        raise ValueError(
   103	            f"utility scales must be finite and positive; got {scales}"
   104	        )
   105	    if n_new_samples < 0 or n_model_fits < 0:
   106	        raise ValueError("resource counts must be non-negative")
   107	
   108	    ds = 0.0 if not math.isfinite(delta_surrogate) else float(delta_surrogate)
   109	    dc = 0.0 if not math.isfinite(delta_coverage) else float(delta_coverage)
   110	    stop_penalty = (
   111	        weights.w_stop_opportunity * float(remaining_budget_ratio)
   112	        if is_stop else 0.0
   113	    )
   114	    return (
   115	        weights.w_optimization * float(delta_optimization) / optimization_scale
   116	        + weights.w_surrogate * ds
   117	        + weights.w_coverage * dc
   118	        - weights.w_evaluation * int(n_new_samples) / evaluation_scale
   119	        - weights.w_fit * int(n_model_fits) / fit_scale
   120	        - stop_penalty
   121	    )


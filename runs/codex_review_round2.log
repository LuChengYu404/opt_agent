def _restore_backend(backend, base) -> None:
    """Restore backend to base state. Caller-supplied to make arm semantics explicit."""
    backend.restore(base)


def oracle_test(
    backend,
    state,
    record: DecisionRecord,
    *,
    objective_scale: float = 1.0,
    random_replicates: int = 5,
    max_actions: int = 50,
) -> OracleResult:
    """Compare first actions with the same RulePolicy continuation.

    The backend is restored to its pre-call state at the end (try/finally).
    """
    if not math.isfinite(objective_scale) or objective_scale <= 0:
        raise ValueError("objective_scale must be finite and positive")
    if random_replicates < 1:
        raise ValueError("random_replicates must be positive")
    base = backend.checkpoint()
    total_budget = int(state.resource.total_budget)
    specs = {x["action_id"]: x for x in record.candidate_actions}
    gold_id = max(record.gold_probs, key=record.gold_probs.get)

    def action_from_id(action_id: str) -> OptimizationAction:
        spec = specs[action_id]
        return OptimizationAction(ActionType(spec["type"]), dict(spec["params"]))

    continuation_seed = derive_seed(int(record.metadata["run_seed"]), 1)
    continuation_policy = RulePolicy(seed=continuation_seed)
    def choose_continuation(s, b):
        return continuation_policy.select_action(s, b)

    try:
        # Gold: gold top action, then RulePolicy continuation.
        _restore_backend(backend, base)
        gold = _run_arm(
            backend,
            initial_state=state,
            first_action=action_from_id(gold_id),
            choose_next=choose_continuation,
            total_budget=total_budget,
            max_actions=max_actions,
        )
        # STOP: STOP, then STOP.
        stop_action = OptimizationAction(ActionType.STOP)
        _restore_backend(backend, base)
        stopped = _run_arm(
            backend,
            initial_state=state,
            first_action=stop_action,
            choose_next=lambda s, b: stop_action,
            total_budget=total_budget,
            max_actions=max_actions,
        )
        # Baselines differ only in their first action; all non-STOP arms then
        # use the same continuation, isolating the decision being evaluated.
        uniform_results: list[float] = []
        behavior_results: list[float] = []
        for rep in range(random_replicates):
            u_seed = derive_seed(int(record.metadata["run_seed"]), 1000, rep)
            u_policy = RandomPolicy(seed=u_seed)
            _restore_backend(backend, base)
            u = _run_arm(
                backend,
                initial_state=state,
                first_action=u_policy.select_action(state, backend),
                choose_next=choose_continuation,
                total_budget=total_budget,
                max_actions=max_actions,
            )
            uniform_results.append(u[0])

            b_rng = random.Random(derive_seed(u_seed, 1))
            b_rule = RulePolicy(seed=derive_seed(u_seed, 2))
            b_random = RandomPolicy(seed=derive_seed(u_seed, 3))

            def choose_behavior(s, b):
                return (
                    b_random.select_action(s, b)
                    if b_rng.random() < 0.2
                    else b_rule.select_action(s, b)
                )

            _restore_backend(backend, base)
            behavior_results.append(_run_arm(
                backend,
                initial_state=state,
                first_action=choose_behavior(state, backend),
                choose_next=choose_continuation,
                total_budget=total_budget,
                max_actions=max_actions,
            )[0])

        terminal = {
            "gold": gold[0],
            "stop": stopped[0],
            "uniform": statistics.fmean(uniform_results),
            "behavior": statistics.fmean(behavior_results),
        }
        gains = {
            arm: (terminal["gold"] - value) / objective_scale
            for arm, value in terminal.items()
            if arm != "gold"
        }
        return OracleResult(
            gold_action=gold_id, terminal=terminal, gains=gains
        )
    finally:
        backend.restore(base)


# ---------------------------------------------------------------------------
# Gate 4 — replayable oracle test (Phase 8.6B)
# ---------------------------------------------------------------------------


def oracle_test_from_record(
    record: DecisionRecord,
    *,
    random_replicates: int = 5,
    max_actions: int = 200,
    backend_factory: Callable | None = None,
) -> OracleResult:
    """Replay a DecisionRecord's backend state and run the oracle test.

    The record must contain a complete backend checkpoint. A fresh backend
    restores that checkpoint before the paired oracle arms are run.

    Parameters
    ----------
    backend_factory : Callable | None
        Optional factory returning a fresh backend. Defaults to a
        BocodeBotorchBackend reconstructed with the problem id from the record.
    """
    from opt_agent.backend.bocode_botorch import BackendConfig, BocodeBotorchBackend

    cp = _reconstruct_checkpoint(record)
    if backend_factory is None:
        # Phase 9 Gate 5 — thread the affine objective transform from record
        # metadata so that future evaluate() calls append transformed values
        # to the (already-transformed) history loaded from the checkpoint.
        affine = _affine_kwargs_from_metadata(record.metadata)
        backend = BocodeBotorchBackend(**affine)
        backend.initialize(BackendConfig(
            problem_id=cp.problem_id,
            seed=int(record.problem["seed"]),
            n_init=1,
        ))
    else:
        backend = backend_factory()
    backend.restore(cp)

    state = extract_state(
        backend,
        total_budget=int(record.state["resource"]["total_budget"]),
        last_action=record.state["history"].get("last_action"),
    )
    if state.sampling.n_samples != int(record.state["sampling"]["n_samples"]):
def mine_pairs(
    record: DecisionRecord,
    *,
    margin: float = 0.0,
    max_pairs: int | None = None,
    rng: random.Random | None = None,
) -> list[ContrastivePair]:
    """All (or sampled) strict utility-order pairs among valid rolled branches.

    Works identically on full-vocabulary and partial (quota-subsampled)
    records — pairs are mined from whatever `rollout_results` contains.
    Invalid branches and non-finite utilities are skipped. Ties within
    1e-12 produce no pair (a tie carries no ordering information).
    """
    valid: list[tuple[str, float]] = []
    for action_id, res in record.rollout_results.items():
        if res.get("status") != "valid":
            continue
        u = float(res.get("utility", float("nan")))
        if math.isfinite(u):
            valid.append((action_id, u))
    valid.sort(key=lambda kv: (-kv[1], kv[0]))
    pairs: list[ContrastivePair] = []
    for i, (a_hi, u_hi) in enumerate(valid):
        for a_lo, u_lo in valid[i + 1:]:
            m = u_hi - u_lo
            if m <= 1e-12 or m < margin:
                continue
            pairs.append(ContrastivePair(record.id, a_hi, a_lo, m))
    if max_pairs is not None and len(pairs) > max_pairs:
        rng = rng or random.Random(0)
        pairs = rng.sample(pairs, max_pairs)
        pairs.sort(key=lambda p: -p.margin)
    return pairs


# ---------------------------------------------------------------------------
# Sequence / loss plumbing (Laya-side)
# ---------------------------------------------------------------------------


def _record_choice_parts(record: DecisionRecord) -> tuple[dict, dict]:
    """(state_arg, internal question dict) using the deployment prompt shape.

    Goes through the same `build_choice_request` helper the deployed
    LayaPolicy uses (structured state, legacy criteria — the prompt shape
    behind `runs/phase9_5_laya_zero_shot_5x5.json`), so the fine-tuned model
    is trained on its deployment input distribution. Option order follows
    `record.candidate_actions` (criteria dict insertion order).
    """
    from opt_agent.actions import ActionType, OptimizationAction

    choices = {
        spec["action_id"]: OptimizationAction(
            ActionType(spec["type"]), dict(spec["params"])
        )
        for spec in record.candidate_actions
    }
    state_arg, question = build_choice_request(
        record.state,  # type: ignore[arg-type]
        choices,
        state_format="structured",
        criteria_format="legacy",
    )
    inner = question["next_action"]
    return state_arg, {"t": inner["type"], "ins": inner["instructions"],
                       "crit": inner["criteria"]}


def build_item(
    record: DecisionRecord,
    tokenizer,
    *,
    max_len: int = 512,
    head_max_len: int = 192,
) -> dict | None:
    """Build one Laya training item for a record: ids/markers/qtype + target.

    The item carries both supervision forms:
      - ``pairs``: option-index pairs for the BT baseline arm (utility order);
      - ``target``: the teacher distribution ``gold_probs`` aligned to
        ``option_ids`` order (renormalized over the offered options), for the
        RLCD proper-score objective.

    Returns None when options truncate past `head_max_len` (indices could
    misalign) or when the record yields no supervision (no pair AND no
    nonzero-mass target).
    """
    from laya.common import QTYPES, build_sequence, render_options

    state_arg, q = _record_choice_parts(record)
    ids, markers = build_sequence(tokenizer, state_arg, q, max_len, head_max_len)
    option_ids = [opt.split(":")[0] for opt in render_options(q)]
    if len(markers) != len(option_ids):
        return None
    index_of = {a: i for i, a in enumerate(option_ids)}
    pairs = [
        (index_of[p.pos], index_of[p.neg], p.margin)
        for p in mine_pairs(record)
        if p.pos in index_of and p.neg in index_of
    ]
    offered = [a for a in option_ids if a in record.gold_probs]
    mass = sum(record.gold_probs[a] for a in offered)
    target = (
        [
            (record.gold_probs[a] / mass) if a in record.gold_probs else 0.0
            for a in option_ids
        ]
        if offered and mass > 0 else None
    )
    if not pairs and target is None:
        return None
    return {
        "ids": ids,
        "markers": markers,
        "qtype": QTYPES[q["t"]],
        "pairs": pairs,
        "record_id": record.id,
        "option_ids": option_ids,
        "target": target,
    }


def bradley_terry_loss(
    logits: torch.Tensor,
    items: Sequence[Mapping],
    chosen = set(rng.sample(range(len(candidates)), k))
    return [c for i, c in enumerate(candidates) if i in chosen]


def _average_rollouts(outputs: list) -> "RolloutOutput":
    """Merge replicate rollouts of the SAME candidate subset (P1b denoising).

    Per action: utility/deltas/counts are means over the replicas where the
    action was valid; the per-replica utilities and their std are stashed in
    ``metrics['utility_replicas']`` / ``metrics['utility_std']``. An action
    valid in no replica is emitted as-is from the first output (invalid).
    T2: averaging leaves the expected ranking unchanged and shrinks utility
    noise as 1/sqrt(R).
    """
    import statistics as _stats

    from opt_agent.rollout import CounterfactualResult, RolloutOutput

    base = outputs[0]
    merged: list[CounterfactualResult] = []
    for first in base.results:
        replicas = [
            r for out in outputs
            for r in out.results
            if r.action_id == first.action_id and r.status == "valid"
        ]
        if not replicas:
            merged.append(first)
            continue

        def _mean(attr: str) -> float:
            vals = [getattr(r, attr) for r in replicas]
            return float(_stats.fmean(vals))

        utilities = [r.utility for r in replicas]
        metrics = dict(first.metrics)
        metrics["utility_replicas"] = utilities
        metrics["utility_std"] = (
            float(_stats.pstdev(utilities)) if len(utilities) > 1 else 0.0
        )
        merged.append(CounterfactualResult(
            action_id=first.action_id,
            action=first.action,
            status="valid",
            n_new_samples=_mean("n_new_samples"),
            n_model_fits=_mean("n_model_fits"),
            delta_optimization=_mean("delta_optimization"),
            delta_surrogate=_mean("delta_surrogate"),
            delta_coverage=_mean("delta_coverage"),
            utility=float(_stats.fmean(utilities)),
            metrics=metrics,
            trajectory_tail=first.trajectory_tail,
            error=None,
        ))
    return RolloutOutput(s_t=base.s_t, results=tuple(merged))

class UtilityWeights:
    """Weights for the 5-term utility function.

    Phase 8.5 defaults (per codex review):
      - w_surrogate = 0: validation_rmse is in-sample training RMSE, not
        leave-one-out; cannot be trusted until surrogate metric is fixed.
      - w_coverage = 0: `boundary_coverage` is fraction near edge, not a
        proper coverage metric; needs a grid/fill-distance version.
      - w_stop_opportunity = 0: optional linear STOP penalty proportional
        to remaining_budget_ratio. Default 0 so backward-compatible.
    """
    w_optimization: float = 1.0
    w_surrogate: float = 0.0
    w_coverage: float = 0.0
    w_evaluation: float = 1.0
    w_fit: float = 0.5
    # Phase 8.5 default: 0.75 (codex-empirical) keeps STOP below non-STOP
    # actions in early phase; rises above them in late phase. Set to 0 to
    # disable the STOP opportunity penalty.
    w_stop_opportunity: float = 0.75

    def to_dict(self) -> dict[str, float]:
        """Single-source-of-truth dict form used by JSONL metadata."""
        return {
            "w_optimization": self.w_optimization,
            "w_surrogate": self.w_surrogate,
            "w_coverage": self.w_coverage,
            "w_evaluation": self.w_evaluation,
            "w_fit": self.w_fit,
            "w_stop_opportunity": self.w_stop_opportunity,
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> "UtilityWeights":
        """Reverse of ``to_dict``. Missing fields fall back to defaults."""
        return cls(
            w_optimization=float(data.get("w_optimization", 1.0)),
            w_surrogate=float(data.get("w_surrogate", 0.0)),
            w_coverage=float(data.get("w_coverage", 0.0)),
            w_evaluation=float(data.get("w_evaluation", 1.0)),
            w_fit=float(data.get("w_fit", 0.5)),
            w_stop_opportunity=float(data.get("w_stop_opportunity", 0.75)),
        )


def compute_utility(
    *,
    delta_optimization: float,
    delta_surrogate: float = 0.0,
    delta_coverage: float = 0.0,
    n_new_samples: int,
    n_model_fits: int,
    weights: UtilityWeights,
    optimization_scale: float = 1.0,
    evaluation_scale: float = 1.0,
    fit_scale: float = 1.0,
    is_stop: bool = False,
    remaining_budget_ratio: float = 0.0,
) -> float:
    """Scalar utility of a counterfactual branch.

    Raises
    ------
    ValueError
        If any scale is non-positive, counts are negative, or
        delta_optimization is non-finite (programmer error).
    """
    if not math.isfinite(delta_optimization):
        raise ValueError("delta_optimization must be finite")
    scales = (optimization_scale, evaluation_scale, fit_scale)
    if not all(math.isfinite(x) and x > 0 for x in scales):
        raise ValueError(
            f"utility scales must be finite and positive; got {scales}"
        )
    if n_new_samples < 0 or n_model_fits < 0:
        raise ValueError("resource counts must be non-negative")

    ds = 0.0 if not math.isfinite(delta_surrogate) else float(delta_surrogate)
    dc = 0.0 if not math.isfinite(delta_coverage) else float(delta_coverage)
    stop_penalty = (
        weights.w_stop_opportunity * float(remaining_budget_ratio)
        if is_stop else 0.0
    )
    return (
        weights.w_optimization * float(delta_optimization) / optimization_scale
        + weights.w_surrogate * ds
        + weights.w_coverage * dc
        - weights.w_evaluation * int(n_new_samples) / evaluation_scale
        - weights.w_fit * int(n_model_fits) / fit_scale
        - stop_penalty
    )


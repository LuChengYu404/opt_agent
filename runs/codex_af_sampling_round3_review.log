    97	class CounterfactualRollout:
    98	    """Run counterfactual rollouts from a state for a list of candidate actions.
    99	
   100	    Parameters
   101	    ----------
   102	    backend : UnifiedBackend
   103	    horizon : int
   104	        How many action steps to simulate per branch (≥1). Per codex Q-T1
   105	        (2026-09-25): horizon is a plain int. To simulate until the budget
   106	        is exhausted, the caller passes `state.resource.remaining_budget` as
   107	        the horizon value — this keeps `CounterfactualRollout` free of
   108	        special "until exhausted" semantics.
   109	    utility_weights : UtilityWeights
   110	    continuation_spec : ContinuationPolicySpec | None
   111	        Spec describing the policy used for follow-up steps when horizon > 1.
   112	        Defaults to `DEFAULT_CONTINUATION_SPEC` (rule). Per codex Q-T2, the
   113	        spec's name/seed/extras must be recorded in dataset metadata so that
   114	        any record can be replayed with a different continuation.
   115	    max_rollout_steps : int

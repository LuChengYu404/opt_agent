   164	def test_two_independent_checkpoints_at_different_states() -> None:
   165	    be = initialized_backend()
   166	    cp1 = be.checkpoint()
   167	    be.evaluate(torch.tensor([[0.0, 7.5]], dtype=torch.double))
   168	    cp2 = be.checkpoint()

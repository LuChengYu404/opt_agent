    97	class UniformPolicy:
    98	    """Samples uniformly over ALL 8 ActionTypes — behaviorally identical to
    99	    RandomPolicy (both use `choice(list(ActionType))` + `sample_params`).
   100	
   101	    Historical note (codex Q-T2 review): introduced as a state-aware uniform
   102	    ablation arm when RandomPolicy sampled only 5 action types; RandomPolicy
   103	    later converged to the full 8, so the two now coincide. Kept as the
   104	    named policy for the `uniform` continuation arm and ablation specs.
   105	    Params (n_samples, step, tol, seed) are filled in for parameterized
   106	    actions (GLOBAL_EXPLORATION, LOCAL_EXPLOITATION, UNCERTAINTY_SAMPLING,
   107	    ERROR_GUIDED_SAMPLING, BOUNDARY_SAMPLING) so the action is
   108	    budget-feasible.
   109	    """
   110	
   111	    def __init__(self, seed: int = 0) -> None:
   112	        self._rng = random.Random(seed)
   113	        self._initial_seed = seed
   114	
   115	    def reset(self) -> None:
   116	        self._rng = random.Random(self._initial_seed)
   117	
   118	    def select_action(
   119	        self, state: OptimizationState, backend: UnifiedBackend | None = None
   120	    ) -> OptimizationAction:
   121	        remaining = state.resource.remaining_budget
   122	        if remaining <= 0:
   123	            return OptimizationAction(ActionType.STOP)
   124	        action_type = self._rng.choice(list(ActionType))
   125	        params = sample_params(action_type, remaining, self._rng)
   126	        if not params:
   127	            return OptimizationAction(action_type)
   128	        return OptimizationAction(action_type, params)

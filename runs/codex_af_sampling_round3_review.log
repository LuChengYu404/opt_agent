   148	    def rollout(
   149	        self,
   150	        state: OptimizationState,
   151	        candidates: list[Candidate],
   152	    ) -> RolloutOutput:
   153	        if not candidates:
   154	            raise ValueError("candidates must not be empty")
   155	        # Reject duplicate action_ids — they would collide in results dict.
   156	        ids = [c.action_id for c in candidates]
   157	        duplicates = [i for i, c in Counter(ids).items() if c > 1]
   158	        if duplicates:
   159	            raise ValueError(
   160	                f"duplicate action_id in candidates: {duplicates}. "
   161	                f"Each candidate must have a unique id."
   162	            )
   163	        if len(candidates) * self.horizon > self.max_rollout_steps:
   164	            raise ValueError(
   165	                f"rollout step cap exceeded: {len(candidates)} candidates × "
   166	                f"{self.horizon} horizon = {len(candidates) * self.horizon} > "
   167	                f"{self.max_rollout_steps}"
   168	            )
   169	
   170	        base = self.backend.checkpoint()
   171	        observed = extract_state(
   172	            self.backend,
   173	            total_budget=state.resource.total_budget,
   174	            last_action=state.history.last_action,
   175	        )
   176	        # State sanity check: extract_state from current backend must match the
   177	        # passed state (otherwise caller passed stale state).
   178	        if observed.sampling.n_samples != state.sampling.n_samples:
   179	            raise ValueError(
   180	                f"State does not describe the checkpointed backend: "
   181	                f"state has n_samples={state.sampling.n_samples}, "
   182	                f"backend has {observed.sampling.n_samples}."
   183	            )
   184	
   185	        results: list[CounterfactualResult] = []
   186	        try:
   187	            for candidate in candidates:
   188	                results.append(self._run_one_branch(state, candidate, base))
   189	        finally:
   190	            self.backend.restore(base)
   191	
   192	        return RolloutOutput(s_t=state, results=tuple(results))
   193	
   194	    def _run_one_branch(
   195	        self,
   196	        state: OptimizationState,
   197	        candidate: Candidate,
   198	        base: Checkpoint,
   199	    ) -> CounterfactualResult:
   200	        self.backend.restore(base)

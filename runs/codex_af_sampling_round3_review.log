   147	def test_restore_atomic_on_shape_mismatch() -> None:
   148	    be = initialized_backend()
   149	    before = be.checkpoint()
   150	    bad_obj = torch.zeros((before.X.shape[0] + 1, 1), dtype=torch.double)
   151	    bad = replace(before, objectives=bad_obj)
   152	
   153	    with pytest.raises(ValueError, match="Checkpoint shape mismatch"):
   154	        be.restore(bad)

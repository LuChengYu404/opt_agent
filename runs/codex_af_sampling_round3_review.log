"""LMABO acquisition-function portfolio (AF registry).

Transplants the 12-AF candidate portfolio of LMABO ("Adaptive Acquisition
Selection for Bayesian Optimization", arxiv_2602.07904, Appendix A) onto this
project's backend `propose()` path. Per the repo's research boundary
(`docs/RESEARCH_BOUNDARY_GUIDE.md` §1.1 A_pt), "AF 选择" is the sanctioned
expansion slot this module implements; batch q remains reserved.

Portfolio (paper Appendix A, verified against the local PDF
`docs/ref_papers/pdfs/arxiv_2602.07904.pdf`):

    exploitative:  PI, LogPI, EI, LogEI, PosMean
    exploratory :  PosSTD, UCB, TS, qKG, qPES, qMES, qJES

Optimizer protocol (paper Appendix B.2): every AF is maximized with
multi-start L-BFGS-B *except* TS and PES, which are maximized discretely over
a finite set of randomly sampled candidates. LMABO itself only *selects*
among these names each iteration (zero-shot LLM, fixed menu, no AF parameter
tuning) — the selection agency here lives in the policy layer via the action
menu (`actions/executor.py`), not in this module.

Design-time constants the paper leaves unspecified:
  - ``UCB_KAPPA``: the paper fixes kappa but never states its value; we pin
    kappa = 2.0 (solidly exploratory per the paper's own grouping).
  - ``DISCRETE_CANDIDATES``: TS/PES candidate-set size (paper: "a finite set
    of randomly sampled candidates", no size given).
  - ``NUM_OPTIMAL_SAMPLES``: posterior sample count behind the qPES/qJES
    optimal-input draws (BoTorch >=0.18 requires explicit `optimal_inputs`).

Conventions: MAXIMIZATION frame (matches `bocode_botorch`), `best_f` is the
observed incumbent, candidates/points are double tensors in problem units.
Randomness (candidate scrambling, posterior draws) flows through the global
torch RNG so checkpoint/restore (`backend.checkpoint`) keeps rollouts
reproducible.

Cost note: qKG/qPES/qMES/qJES are one-to-two orders of magnitude more
expensive per proposal than the analytic AFs; they are exposed for
completeness of the LMABO menu but no executor default action selects them.
"""

from __future__ import annotations

import torch

AF_DEFAULT = "LogEI"

# Paper-fixed but paper-unstated values; see module docstring.
UCB_KAPPA = 2.0
DISCRETE_CANDIDATES = 512
NUM_OPTIMAL_SAMPLES = 8

# Optimizer budget, matching the existing LogEI propose() path exactly so the
# default trajectory behaviour is unchanged.
NUM_RESTARTS = 4
RAW_SAMPLES = 16

ACQUISITION_NAMES: tuple[str, ...] = (
    "PI", "LogPI", "EI", "LogEI", "UCB", "PosMean", "PosSTD",
    "TS", "qKG", "qPES", "qMES", "qJES",
)
ACQUISITION_SET: frozenset[str] = frozenset(ACQUISITION_NAMES)

# Paper's own exploration/exploitation grouping (Appendix A).
EXPLORATORY_AFS: frozenset[str] = frozenset(
    {"PosSTD", "UCB", "TS", "qKG", "qPES", "qMES", "qJES"}
)
EXPLOITATIVE_AFS: frozenset[str] = frozenset(
    {"PI", "LogPI", "EI", "LogEI", "PosMean"}
)


def _candidate_set(bounds: torch.Tensor, size: int) -> torch.Tensor:
    """Scrambled Sobol candidates scaled to `bounds` [2, d].

    The scramble seed is drawn from the global torch RNG (not fixed) so
    checkpoint-restored rollouts replay identically.
    """
    from torch.quasirandom import SobolEngine

    seed = int(torch.randint(0, 2**31 - 1, (1,)).item())
    unit = SobolEngine(dimension=bounds.shape[1], scramble=True, seed=seed).draw(
        size
    ).to(dtype=torch.double)
    return bounds[0] + unit * (bounds[1] - bounds[0])


def _draw_optimal_samples(
    model, bounds: torch.Tensor, n: int
) -> tuple[torch.Tensor, torch.Tensor]:
    """Draw `n` optimal-input samples (Thompson-style argmax draws).

    Returns (optimal_inputs [n, d], optimal_outputs [n, 1]) where the output
    is the same posterior sample evaluated at its argmax. Used to construct
    qPES/qJES, which in BoTorch >=0.18 require explicit optimal-input draws.
    """
    X = _candidate_set(bounds, DISCRETE_CANDIDATES)
    with torch.no_grad():
        posterior = model.posterior(X)
        samples = posterior.rsample(torch.Size([n]))  # [n, C, 1]
    flat = samples.reshape(n, -1)
    idx = flat.argmax(dim=-1)  # [n]
    optimal_inputs = X[idx]  # [n, d]
    optimal_outputs = flat.gather(1, idx.unsqueeze(-1))  # [n, 1]
    return optimal_inputs, optimal_outputs


def _entropy_workspace(model, bounds: torch.Tensor):
    """Consistent-coordinate workspace for the entropy AFs (qPES/qMES/qJES).

    BoTorch 0.18's qPES/qJES build their expectation-propagation system from
    ``model.train_inputs`` — which are stored ALREADY TRANSFORMED when an
    input transform is active — and then feed that concatenation back through
    ``model.posterior``, which applies the transform a second time. No input
    space the caller can pass makes both parts consistent, so for a
    transformed model we run the AF on a transform-stripped deepcopy in the
    model's internal (normalized) space and map the selected point back
    (codex round-1 review, finding A). Untransformed models take the identity
    path. Returns (af_model, af_bounds, to_physical_fn).
    """
    tf = getattr(model, "input_transform", None)
    if tf is None:
        return model, bounds, lambda x: x
    import copy

    af_model = copy.deepcopy(model)
    # ORDER MATTERS (codex round-2 review, MAJOR-1): a restored GP sits in
    # train mode holding PHYSICAL train inputs; botorch normalizes them in
    # `eval()` via `_set_transformed_inputs`, which only runs while the
    # transform attribute still exists. eval() FIRST (train inputs become
    # normalized), strip the transform SECOND — otherwise the EP system is
    # built on physical train inputs against normalized candidates.
    af_model.eval()
    del af_model.input_transform
    # transform_inputs falls back to identity via AttributeError, so deleting
    # the attribute disables the transform on the copy.
    af_bounds = tf(bounds)
    return af_model, af_bounds, lambda x: tf.untransform(x)


def _maximize_discrete(acqf, bounds: torch.Tensor) -> torch.Tensor:
    """Discrete argmax of a q-acquisition over the random candidate set."""
    X = _candidate_set(bounds, DISCRETE_CANDIDATES).unsqueeze(1)  # [C, 1, d]
    with torch.no_grad():
        values = acqf(X).reshape(-1)  # [C]
    idx = int(values.argmax().item())
    return X[idx, 0].unsqueeze(0)  # [1, d]


def _maximize_lbfgsb(acqf, bounds: torch.Tensor) -> torch.Tensor:
    from botorch.optim import optimize_acqf

    candidate, _ = optimize_acqf(
        acq_function=acqf,
        bounds=bounds,
        q=1,
        num_restarts=NUM_RESTARTS,
        raw_samples=RAW_SAMPLES,
    )
    return candidate.detach()


def _thompson_candidate(model, bounds: torch.Tensor) -> torch.Tensor:
    """TS: argmax over candidates of one posterior sample (paper: discrete)."""
    X = _candidate_set(bounds, DISCRETE_CANDIDATES)
    with torch.no_grad():
        posterior = model.posterior(X)
        sample = posterior.rsample(torch.Size([1])).reshape(-1)  # [C]
    idx = int(sample.argmax().item())
    return X[idx].unsqueeze(0)  # [1, d]


def propose_candidate(
    af: str,
    *,
    model,
    best_f: float,
    bounds: torch.Tensor,
) -> torch.Tensor:
    """Maximize the named portfolio AF; return one point [1, d].

    Parameters
    ----------
    af : str
        One of ``ACQUISITION_NAMES`` (case-sensitive, paper spellings).
    model : fitted BoTorch model (MAXIMIZATION frame).
    best_f : observed incumbent value.
    bounds : [2, d] search box (or trust region) in problem units.

    Raises
    ------
    ValueError
        If `af` is not in the portfolio.
    """
    if af not in ACQUISITION_SET:
        raise ValueError(
            f"Unknown acquisition function {af!r}; portfolio is "
            f"{ACQUISITION_NAMES}."
        )

    if af == "TS":
        return _thompson_candidate(model, bounds)

    if af == "PI":
        from botorch.acquisition.analytic import ProbabilityOfImprovement
        return _maximize_lbfgsb(
            ProbabilityOfImprovement(model=model, best_f=best_f), bounds)
    if af == "LogPI":
        from botorch.acquisition.analytic import LogProbabilityOfImprovement
        return _maximize_lbfgsb(
            LogProbabilityOfImprovement(model=model, best_f=best_f), bounds)
    if af == "EI":
        from botorch.acquisition.analytic import ExpectedImprovement
        return _maximize_lbfgsb(
            ExpectedImprovement(model=model, best_f=best_f), bounds)
    if af == "LogEI":
        from botorch.acquisition.analytic import LogExpectedImprovement
        # Byte-identical settings to the pre-portfolio propose(): LogEI,
        # optimize_acqf(num_restarts=4, raw_samples=16).
        return _maximize_lbfgsb(
            LogExpectedImprovement(model=model, best_f=best_f), bounds)
    if af == "UCB":
        from botorch.acquisition.analytic import UpperConfidenceBound
        # botorch parameterizes beta with acq = mu + sqrt(beta) * sigma,
        # so kappa = sqrt(beta).
        return _maximize_lbfgsb(
            UpperConfidenceBound(model=model, beta=UCB_KAPPA**2), bounds)
    if af == "PosMean":
        from botorch.acquisition.analytic import PosteriorMean
        return _maximize_lbfgsb(PosteriorMean(model=model), bounds)
    if af == "PosSTD":
        from botorch.acquisition.analytic import PosteriorStandardDeviation
        return _maximize_lbfgsb(PosteriorStandardDeviation(model=model), bounds)
    if af == "qKG":
        from botorch.acquisition.knowledge_gradient import qKnowledgeGradient
        return _maximize_lbfgsb(qKnowledgeGradient(model=model), bounds)
    if af == "qPES":
        from botorch.acquisition.predictive_entropy_search import (
            qPredictiveEntropySearch,
        )
        m_af, b_af, to_phys = _entropy_workspace(model, bounds)
        optimal_inputs, _ = _draw_optimal_samples(m_af, b_af, NUM_OPTIMAL_SAMPLES)
        acqf = qPredictiveEntropySearch(model=m_af, optimal_inputs=optimal_inputs)
        # Paper: PES is maximized discretely (Appendix B.2).
        return to_phys(_maximize_discrete(acqf, b_af))
    if af == "qMES":
        from botorch.acquisition.max_value_entropy_search import qMaxValueEntropy
        m_af, b_af, to_phys = _entropy_workspace(model, bounds)
        candidate_set = _candidate_set(b_af, DISCRETE_CANDIDATES)
        acqf = qMaxValueEntropy(model=m_af, candidate_set=candidate_set)
        return to_phys(_maximize_lbfgsb(acqf, b_af))
    if af == "qJES":
        from botorch.acquisition.joint_entropy_search import qJointEntropySearch
        m_af, b_af, to_phys = _entropy_workspace(model, bounds)
        optimal_inputs, optimal_outputs = _draw_optimal_samples(
            m_af, b_af, NUM_OPTIMAL_SAMPLES)
        acqf = qJointEntropySearch(
            model=m_af,
            optimal_inputs=optimal_inputs,
            optimal_outputs=optimal_outputs,
        )
        return to_phys(_maximize_lbfgsb(acqf, b_af))

    raise ValueError(f"Unhandled acquisition function {af!r}.")  # pragma: no cover


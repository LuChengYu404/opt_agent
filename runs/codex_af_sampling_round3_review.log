   271	class FantasizeMixin(ABC):
   272	    """
   273	    Mixin to add a ``fantasize`` method to a ``Model``.
   274	
   275	    Example:
   276	        class BaseModel:
   277	            def __init__(self, ...):
   278	            def condition_on_observations(self, ...):
   279	            def posterior(self, ...):
   280	            def transform_inputs(self, ...):
   281	
   282	        class ModelThatCanFantasize(BaseModel, FantasizeMixin):
   283	            def __init__(self, args):
   284	                super().__init__(args)
   285	
   286	        model = ModelThatCanFantasize(...)
   287	        model.fantasize(X)
   288	    """
   289	
   290	    @abstractmethod
   291	    def condition_on_observations(self, X: Tensor, Y: Tensor) -> Self:
   292	        """
   293	        Classes that inherit from ``FantasizeMixin`` must implement
   294	        a ``condition_on_observations`` method.
   295	        """
   100	            maximize: If True, consider the problem a maximization problem.
   101	            X_pending: A ``m x d``-dim Tensor of ``m`` design points that have been
   102	                submitted for function evaluation but have not yet been evaluated.
   103	            train_inputs: A ``n_train x d`` Tensor that the model has been fitted on.
   104	                Not required if the model is an instance of a GPyTorch ExactGP model.
   105	        """
   106	        super().__init__(model=model)
   107	
   108	        # NOTE The _init_model is used to create the fantasy model and draw max-value
   109	        # samples. The self.model is overwritten in qMaxValueEntropy.set_X_pending
   110	        # and its multi-fidelity version by a fantasy model with batch_size fantasies.
   111	        # For these acqfs, the fantasy model is used throughout the forward pass.
   112	        # qLowerBound methods do not do this.
   113	        self._init_model = model
   114	        if model.num_outputs > 1:
   115	            raise UnsupportedError(
   116	                f"Multi-output models are not supported by {self.__class__.__name__}."
   117	            )

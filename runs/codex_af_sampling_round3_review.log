   131	class OnPolicyMix:
   132	    """The behavior policy mix used by `DatasetGenerator`.
   133	
   134	    With probability `rule_weight` pick `RulePolicy`'s choice; otherwise pick
   135	    `RandomPolicy`'s choice. Default `rule_weight=0.8` matches the generator's
   136	    `random_action_rate=0.2` default.
   137	
   138	    Per codex (gpt-6-sol) Q-T2 review: this is the "behavior" continuation
   139	    used as a baseline in counterfactual rollout ablations — the original
   140	    policy that generated the trajectory.
   141	    """
   142	
   143	    def __init__(self, seed: int = 0, rule_weight: float = 0.8) -> None:
   144	        if not 0.0 <= rule_weight <= 1.0:
   145	            raise ValueError(f"rule_weight must be in [0, 1]; got {rule_weight}")
   146	        self._rng = random.Random(seed)
   147	        self._rule = RulePolicy(seed=seed)
   148	        self._random = RandomPolicy(seed=seed)
   149	        self._rule_weight = float(rule_weight)
   150	        self._initial_seed = seed
   151	
   152	    def reset(self) -> None:
   153	        self._rng = random.Random(self._initial_seed)
   154	        self._rule.reset()
   155	        self._random.reset()
   156	
   157	    def select_action(
   158	        self, state: OptimizationState, backend: UnifiedBackend | None = None
   159	    ) -> OptimizationAction:
   160	        if self._rng.random() < self._rule_weight:
   161	            return self._rule.select_action(state, backend)
   162	        return self._random.select_action(state, backend)

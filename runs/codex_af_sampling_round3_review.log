   495	def log_cdf_robust(x: Tensor) -> Tensor:
   496	    r"""Computes the logarithm of the normal cumulative density robustly. This uses
   497	    the approximation log(1-z) ~ -z when z is small:
   498	
   499	    if x > 5:
   500	        log(cdf(x)) = log(1-cdf(-x)) approx -cdf(-x)
   501	    else:
   502	        log(cdf(x)).
   503	
   504	    Args:
   505	        x: a ``x_shape``-dim Tensor.
   506	
   507	    Returns
   508	        A ``x_shape``-dim Tensor.
   509	    """
   510	    CLAMP_LB = torch.finfo(x.dtype).eps
   511	    NEG_INF = torch.finfo(x.dtype).min
   512	    normal = Normal(torch.zeros_like(x), torch.ones_like(x))
   513	    cdf_x = normal.cdf(x)
   514	    neg_cdf_neg_x = -normal.cdf(-x)
   515	    log_cdf_x = torch.where(x < 5, torch.log(cdf_x), neg_cdf_neg_x)
   516	
   517	    return log_cdf_x.clamp(NEG_INF, -CLAMP_LB)

   373	def test_global_exploration_failure_rolls_back_real_backend() -> None:
   374	    """Round-2 E regression: atomicity on the real backend restores history,
   375	    GP, and RNG (not just the stub's)."""
   376	
   377	    class FailSecondEvaluate(BocodeBotorchBackend):
   378	        def __init__(self, *a, **k):
   379	            super().__init__(*a, **k)
   380	            self._n_eval = 0
   381	
   382	        def evaluate(self, X):
   383	            self._n_eval += 1
   384	            if self._n_eval == 2:
   385	                raise RuntimeError("injected second evaluation failure")
   386	            return super().evaluate(X)
   387	
   388	    be = FailSecondEvaluate()
   389	    be.initialize(BackendConfig(problem_id="Branin", seed=1, n_init=5))
   390	    rng_before = torch.random.get_rng_state().clone()
   391	    with pytest.raises(RuntimeError, match="injected second evaluation"):
   392	        execute_action(
   393	            be,
   394	            state_for(be),
   395	            OptimizationAction(ActionType.GLOBAL_EXPLORATION, {"n_samples": 2}),
   396	        )
   397	    assert len(be.get_history()) == 5
   398	    assert torch.equal(torch.random.get_rng_state(), rng_before)

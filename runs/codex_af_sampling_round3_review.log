     1	"""Phase 5 acceptance tests for checkpoint / restore.
     2	
     3	Per codex (gpt-5.6-sol) review 2025-09-23:
     4	  - checkpoint() returns clone, not a view
     5	  - restore() reproduces history bit-for-bit
     6	  - restore() is atomic on backend_id / shape mismatch
     7	  - restore() invalidates fitted state (Phase 5: GP not pickled)
     8	  - restore+propose+evaluate reproduces BO step bit-for-bit
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import sys
    14	from dataclasses import replace
    15	from pathlib import Path
    16	
    17	import pytest
    18	import torch
    19	
    20	ROOT = Path(__file__).resolve().parents[1]
    21	sys.path.insert(0, str(ROOT / "src"))
    22	sys.path.insert(0, str(ROOT / "tests"))
    23	
    24	from conftest import RecordingBackend  # noqa: E402
    25	
    26	from opt_agent.backend.bocode_botorch import (  # noqa: E402
    27	    BackendConfig,
    28	    BocodeBotorchBackend,
    29	)
    30	
    31	
    32	def initialized_backend(seed: int = 0, n_init: int = 5) -> BocodeBotorchBackend:
    33	    be = BocodeBotorchBackend()
    34	    be.initialize(BackendConfig(problem_id="Branin", seed=seed, n_init=n_init))
    35	    return be
    36	

   129	def _thompson_candidate(model, bounds: torch.Tensor) -> torch.Tensor:
   130	    """TS: argmax over candidates of one posterior sample (paper: discrete)."""
   131	    X = _candidate_set(bounds, DISCRETE_CANDIDATES)
   132	    with torch.no_grad():
   133	        posterior = model.posterior(X)
   134	        sample = posterior.rsample(torch.Size([1])).reshape(-1)  # [C]
   135	    idx = int(sample.argmax().item())
   136	    return X[idx].unsqueeze(0)  # [1, d]

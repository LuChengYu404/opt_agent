    51	def execute_action(
    52	    backend: UnifiedBackend,
    53	    state: OptimizationState,
    54	    action: OptimizationAction,
    55	) -> ActionResult:
    56	    """Apply `action` on `backend`, return an ActionResult.
    57	
    58	    Raises
    59	    ------
    60	    ValueError
    61	        If action requests more samples than the remaining budget, or if the
    62	        passed `state` is stale (backend has been mutated since extract_state).
    63	    RuntimeError
    64	        If the backend reports an internal error (e.g. BOCoDe evaluation
    65	        failure). The exception propagates without partially mutating history.
    66	    """
    67	    if action.type == ActionType.STOP:
    68	        # STOP is allowed even on uninitialized backends.
    69	        return ActionResult(action=action, n_new_samples=0, n_model_fits=0, should_stop=True)
    70	
    71	    # Stale-state detection: if backend has grown past state, refuse.
    72	    current_n = len(backend.get_history())
    73	    if current_n != state.sampling.n_samples:
    74	        raise ValueError(
    75	            f"Stale state: state.sampling.n_samples={state.sampling.n_samples} "
    76	            f"but backend has {current_n} samples. Re-extract state first."
    77	        )
    78	
    79	    # Budget pre-check. Only n_samples is needed here; the number of GP fits
    80	    # is a dispatch-time property of AF-based samplers (lazy, per point).
    81	    # n_samples fallbacks are the budget-safe minimum (1). Canonical
    82	    # candidates from actions.factory always carry explicit params
    83	    # (n_samples=2 for GLOBAL_EXPLORATION / BOUNDARY_SAMPLING), so the
    84	    # fallback only fires for hand-constructed bare actions.
    85	    if action.type == ActionType.GLOBAL_EXPLORATION:
    86	        n_samples = int(action.params.get("n_samples", 1))
    87	    elif action.type == ActionType.LOCAL_EXPLOITATION:
    88	        n_samples = 1
    89	    elif action.type == ActionType.UNCERTAINTY_SAMPLING:
    90	        n_samples = int(action.params.get("n_samples", 1))
    91	    elif action.type == ActionType.ERROR_GUIDED_SAMPLING:
    92	        n_samples = int(action.params.get("n_samples", 1))
    93	    elif action.type == ActionType.BOUNDARY_SAMPLING:
    94	        n_samples = int(action.params.get("n_samples", 1))
    95	    elif action.type == ActionType.SURROGATE_ACQUISITION:
    96	        n_samples = 1
    97	    elif action.type == ActionType.RETRAIN_SURROGATE:
    98	        n_samples = 0
    99	    else:  # pragma: no cover
   100	        raise ValueError(f"Unhandled action type: {action.type!r}")
   101	
   102	    remaining = state.resource.remaining_budget
   103	    if n_samples > remaining:
   104	        raise ValueError(
   105	            f"Action requests {n_samples} sample(s) but only {remaining} remain "
   106	            f"in the budget. Rejecting without mutating backend."
   107	        )
   108	
   109	    # Dispatch. Each _do_* returns the number of GP fits it triggered.
   110	    if action.type == ActionType.GLOBAL_EXPLORATION:
   111	        n_fits = _do_global_exploration(backend, action)
   112	    elif action.type == ActionType.LOCAL_EXPLOITATION:
   113	        n_fits = _do_local_exploitation(backend, action)
   114	    elif action.type == ActionType.UNCERTAINTY_SAMPLING:
   115	        n_fits = _do_uncertainty_sampling(backend, action)
   116	    elif action.type == ActionType.ERROR_GUIDED_SAMPLING:
   117	        n_fits = _do_error_guided_sampling(backend, action)
   118	    elif action.type == ActionType.BOUNDARY_SAMPLING:
   119	        n_fits = _do_boundary_sampling(backend, action)
   120	    elif action.type == ActionType.SURROGATE_ACQUISITION:
   121	        n_fits = _do_surrogate_acquisition(backend, action)
   122	    elif action.type == ActionType.RETRAIN_SURROGATE:
   123	        backend.fit()
   124	        n_fits = 1
   125	    else:  # pragma: no cover
   126	        raise ValueError(f"Unhandled action type: {action.type!r}")
   127	
   128	    return ActionResult(
   129	        action=action,
   130	        n_new_samples=n_samples,
   131	        n_model_fits=n_fits,
   132	        should_stop=False,
   133	    )
   134	
   135	
   136	# ---------------------------------------------------------------------------
   137	# AF-based sampling helpers
   138	# ---------------------------------------------------------------------------
   139	
   140	
   141	def _trust_region_bounds(
   142	    backend: UnifiedBackend, step: float
   143	) -> torch.Tensor:
   144	    """[incumbent - step*span, incumbent + step*span] ∩ domain, as [2, d].
   145	
   146	    LOCAL_EXPLOITATION's `step` param is reinterpreted (h2) as the
   147	    trust-region radius: the PI maximizer is confined to this box, so the
   148	    action keeps its locality contract (same |x - best| <= step*span
   149	    guarantee as the pre-portfolio perturbation implementation).
   150	    """
   151	    history = backend.get_history()
   152	    best_idx = int(history.objectives[:, 0].argmax().item())
   153	    best = history.X[best_idx]
   154	    dom = backend.bounds
   155	    assert dom is not None, "Backend must expose bounds for LOCAL_EXPLOITATION"
   156	    span = dom[1] - dom[0]
   157	    lo = torch.maximum(dom[0], best - step * span)
   158	    hi = torch.minimum(dom[1], best + step * span)
   159	    return torch.stack([lo, hi])
   160	
   161	
   162	def _greedy_af_samples(
   163	    backend: UnifiedBackend,
   164	    n_samples: int,
   165	    af: str,
   166	    *,
   167	    trust_region_step: float | None = None,
   168	) -> int:
   169	    """Sequential greedy AF maximization: one point per round-trip.
   170	
   171	    Each evaluate() invalidates the GP, so the next point maximizes the same
   172	    AF on the refitted posterior — equivalent to running `n_samples` LMABO
   173	    iterations with `af` fixed. Fits are lazy (only when stale); returns the
   174	    number of fits triggered.
   175	    """
   176	    fits = 0
   177	    for _ in range(n_samples):
   178	        if not backend.is_fitted:
   179	            backend.fit()
   180	            fits += 1
   181	        bounds = None
   182	        if trust_region_step is not None:
   183	            bounds = _trust_region_bounds(backend, trust_region_step)
   184	        X_new = backend.propose(n=1, af=af, bounds=bounds)
   185	        backend.evaluate(X_new)
   186	    return fits
   187	
   188	
   189	# ---------------------------------------------------------------------------
   190	# Action implementations
   191	# ---------------------------------------------------------------------------
   192	
   193	
   194	def _do_global_exploration(backend: UnifiedBackend, action: OptimizationAction) -> int:
   195	    """TS (LMABO exploratory group): argmax of a posterior sample.
   196	
   197	    Replaces the pre-h2 Sobol space-filling draw; `seed` is accepted but
   198	    unused (see module docstring)."""
   199	    n_samples = int(action.params.get("n_samples", 1))
   200	    return _greedy_af_samples(backend, n_samples, AF_GLOBAL_EXPLORATION)
   201	
   202	
   203	def _do_local_exploitation(backend: UnifiedBackend, action: OptimizationAction) -> int:
   204	    """PI (LMABO exploitative group, tau = incumbent) inside the step trust region.
   205	
   206	    Replaces the pre-h2 uniform perturbation of the incumbent."""
   207	    step = float(action.params.get("step", 0.1))
   208	    return _greedy_af_samples(
   209	        backend, 1, AF_LOCAL_EXPLOITATION, trust_region_step=step
   210	    )
   211	
   212	
   213	def _do_surrogate_acquisition(backend: UnifiedBackend, action: OptimizationAction) -> int:
   214	    """Single point from the selected portfolio AF (default LogEI, h1 behaviour)."""
   215	    af = str(action.params.get("af", AF_DEFAULT))
   216	    fits = 0
   217	    if not backend.is_fitted:
   218	        backend.fit()
   219	        fits = 1
   220	    X_new = backend.propose(n=1, af=af)
   221	    backend.evaluate(X_new)
   222	    return fits
   223	
   224	
   225	def _do_uncertainty_sampling(backend: UnifiedBackend, action: OptimizationAction) -> int:
   226	    """PosSTD (LMABO exploratory group): maximize posterior std analytically.
   227	
   228	    Replaces the pre-h2 Sobol-grid std argmax with continuous AF
   229	    maximization; `seed` is accepted but unused."""
   230	    n_samples = int(action.params.get("n_samples", 1))
     1	"""Shared candidate-action factory used by System-1 and the dataset layer.
     2	
     3	Per codex gpt-6-sol review 2026-09-23 (major M1):
     4	  - Candidates come from a SINGLE source — `ALL_CANDIDATE_SPECS` below.
     5	    `candidate_actions_for_state` filters that source by state; the
     6	    dataset generator's `full_candidates` reads the same source for
     7	    its unfiltered vocabulary. There is no second 8-action list.
     8	  - action_id is the lowercase `ActionType.value` (matches the dataset's
     9	    `full_candidates` vocabulary).
    10	  - Factory filters by remaining_budget, sample count, and surrogate fit
    11	    state so callers never need to validate budget feasibility separately.
    12	
    13	The factory returns a `dict[action_id, OptimizationAction]` so the consumer
    14	can:
    15	  - Build the `criteria` payload for Laya's `choice` primitive.
    16	  - Verify a chosen action_id is among the offered candidates.
    17	  - Hand the OptimizationAction directly to DecisionLoop.step().
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	from opt_agent.actions.models import ActionType, OptimizationAction
    23	from opt_agent.state import OptimizationState
    24	
    25	
    26	# Single source of truth for the candidate vocabulary. The first element
    27	# of each tuple is the action_id (stable string), the second is the
    28	# ActionType, and the third is the default parameter dict (without
    29	# `seed`, which callers add per-trajectory).
    30	#
    31	# `full_candidates()` reads this list unfiltered; the runtime factory
    32	# filters it by state.
    33	#
    34	# `BOUNDARY_TOL` is the default `tol` parameter for BOUNDARY_SAMPLING and
    35	# the metric threshold used by `state.extractor._boundary_coverage` to
    36	# decide whether a sampled point lies "near" a domain edge. Both must
    37	# reference the same constant so the coverage metric stays aligned with
    38	# the action's default search margin.
    39	BOUNDARY_TOL: float = 0.05
    40	
    41	ALL_CANDIDATE_SPECS: tuple[tuple[str, ActionType, dict], ...] = (
    42	    ("global_exploration",  ActionType.GLOBAL_EXPLORATION,    {"n_samples": 2}),
    43	    ("local_exploitation",  ActionType.LOCAL_EXPLOITATION,    {"step": 0.1}),
    44	    ("uncertainty_sampling", ActionType.UNCERTAINTY_SAMPLING, {"n_samples": 1}),
    45	    ("error_guided_sampling", ActionType.ERROR_GUIDED_SAMPLING, {"n_samples": 1}),
    46	    ("boundary_sampling",   ActionType.BOUNDARY_SAMPLING,     {"n_samples": 2, "tol": BOUNDARY_TOL}),
    47	    ("surrogate_acquisition", ActionType.SURROGATE_ACQUISITION, {}),
    48	    ("retrain_surrogate",   ActionType.RETRAIN_SURROGATE,     {}),
    49	    ("stop",                ActionType.STOP,                  {}),
    50	)
    51	
    52	
    53	def _make(action_type: ActionType, params: dict, seed: int) -> OptimizationAction:
    54	    """Build an OptimizationAction, threading `seed` through if the
    55	    action type accepts it. Mirrors the legacy `_ALLOWED_PARAMS` test
    56	    in `actions.models`."""
    57	    from opt_agent.actions.models import _ALLOWED_PARAMS
    58	    merged = dict(params)
    59	    if "seed" in _ALLOWED_PARAMS[action_type]:
    60	        merged["seed"] = seed
    61	    return OptimizationAction(action_type, merged)
    62	
    63	
    64	def sample_params(
    65	    action_type: ActionType,
    66	    remaining_budget: int,
    67	    rng: "random.Random",
    68	) -> dict:
    69	    """Generate a random parameter dict for an action that requires one.
    70	
    71	    Used by ``RandomPolicy`` and ``UniformPolicy`` (and any other
    72	    ablation policy that needs a budget-feasible random action). The
    73	    candidate vocabulary and per-action defaults are in
    74	    ``ALL_CANDIDATE_SPECS``; this function handles the four
    75	    parameterised sampling actions plus LOCAL_EXPLOITATION.
    76	
    77	    Param-free actions (``SURROGATE_ACQUISITION``, ``RETRAIN_SURROGATE``,
    78	    ``STOP``) return an empty dict — the caller should then ``_make`` it
    79	    directly without a ``sample_params`` step.
    80	    """
    81	    import random
    82	    if action_type == ActionType.GLOBAL_EXPLORATION:
    83	        n = rng.randint(1, min(3, remaining_budget))
    84	        return {"n_samples": n, "seed": rng.randint(0, 10_000)}
    85	    if action_type == ActionType.LOCAL_EXPLOITATION:
    86	        return {
    87	            "step": round(rng.uniform(0.01, 0.2), 4),
    88	            "seed": rng.randint(0, 10_000),
    89	        }
    90	    if action_type in (
    91	        ActionType.UNCERTAINTY_SAMPLING,
    92	        ActionType.ERROR_GUIDED_SAMPLING,
    93	    ):
    94	        n = rng.randint(1, min(3, remaining_budget))
    95	        return {"n_samples": n, "seed": rng.randint(0, 10_000)}
    96	    if action_type == ActionType.BOUNDARY_SAMPLING:
    97	        n = rng.randint(1, min(3, remaining_budget))
    98	        return {
    99	            "n_samples": n,
   100	            "tol": round(rng.uniform(0.01, 0.10), 4),
   101	            "seed": rng.randint(0, 10_000),
   102	        }
   103	    return {}
   104	
   105	
   106	def candidate_actions_for_state(
   107	    state: OptimizationState, *, seed: int = 0,
   108	) -> dict[str, OptimizationAction]:
   109	    """Build budget-valid candidates as {action_id: OptimizationAction}.
   110	
   111	    Filtering rules
   112	    ---------------
   113	    - remaining_budget <= 0  → only `stop` (forced termination).
   114	    - remaining_budget > 0   → always include `stop` so the policy may
   115	      terminate early. Emit at least one sampling action.
   116	    - surrogate not yet fitted → include `retrain_surrogate`.
   117	    - n_samples > 0           → include `local_exploitation` /
   118	      `error_guided_sampling` (need at least one observed point).
   119	    """
   120	    remaining = state.resource.remaining_budget
   121	    if remaining <= 0:
   122	        return {"stop": OptimizationAction(ActionType.STOP)}
   123	
   124	    action_seed = seed + state.sampling.n_samples
   125	    out: dict[str, OptimizationAction] = {}
   126	
   127	    for action_id, action_type, params in ALL_CANDIDATE_SPECS:
   128	        if action_id == "stop":
   129	            out["stop"] = OptimizationAction(ActionType.STOP)
   130	            continue
   131	        if action_id == "retrain_surrogate":
   132	            if not state.surrogate.is_current:
   133	                out[action_id] = _make(action_type, params, action_seed)
   134	            continue
   135	        if action_id in ("local_exploitation", "error_guided_sampling"):
   136	            if state.sampling.n_samples:
   137	                out[action_id] = _make(action_type, params, action_seed)
   138	            continue
   139	        # Sampling + surrogate_acquisition: cap n_samples at remaining budget.
   140	        merged = dict(params)
   141	        if "n_samples" in merged:
   142	            merged["n_samples"] = min(merged["n_samples"], remaining)
   143	        out[action_id] = _make(action_type, merged, action_seed)
   144	
   145	    return out
     1	"""Counterfactual Rollout (Phase 6).
     2	
     3	Per MASTER_PLAN.md §9–§10 and codex (gpt-5.6-sol) review 2025-09-23.
     4	
     5	For each candidate action a_k, starting from the SAME state s_t:
     6	    1. restore(base)             — rewind to s_t
     7	    2. execute_action(a_k)
     8	    3. (if horizon > 1) loop:    — follow-up policy picks the next action
     9	         - branch_state = extract_state
    10	         - action' = policy.select_action(branch_state, backend)
    11	         - execute_action(action')
    12	         - if result.should_stop or budget exhausted: break
    13	    4. compute utility:  U(a|s) = w_opt · (best_after − best_before)
    14	                            − w_eval · n_evaluations − w_fit · n_fits
    15	
    16	Phase 6 specifics (per codex review):
    17	  - Invalid candidates (e.g. budget violation) become status="invalid" entries
    18	    instead of raising — they don't poison other candidates.
    19	  - Backend is always restored to base via try/finally.
    20	  - Candidates carry an `action_id` (string) so identical action types with
    21	    different params don't collide in the results dict.
    22	  - `to_gold_probs()` uses softmax; rejects empty / invalid-only / non-finite
    23	    temperature / utilities.
    24	"""
    25	
    26	from __future__ import annotations
    27	
    28	import math
    29	from collections import Counter
    30	from dataclasses import dataclass, field
    31	from typing import Callable, Optional
    32	
    33	import numpy as np
    34	
    35	from opt_agent.actions.executor import execute_action
    36	from opt_agent.actions.models import OptimizationAction
    37	from opt_agent.backend.bocode_botorch import UnifiedBackend
    38	from opt_agent.backend.checkpoint import Checkpoint
    39	from opt_agent.rollout.specs import (
    40	    ContinuationPolicySpec,
    41	    build_continuation_policy,
    42	)
    43	from opt_agent.rollout.utility import UtilityWeights, compute_utility
    44	from opt_agent.state import OptimizationState, extract_state
    45	
    46	
    47	# ---------------------------------------------------------------------------
    48	# Data containers
    49	# ---------------------------------------------------------------------------
    50	
    51	
    52	@dataclass(frozen=True)
    53	class Candidate:
    54	    """A candidate action tagged with a stable id (used as results dict key)."""
    55	    action_id: str
    56	    action: OptimizationAction
    57	
    58	
    59	@dataclass(frozen=True)
    60	class CounterfactualResult:
    61	    action_id: str
    62	    action: OptimizationAction
    63	    status: str  # "valid" | "invalid"
    64	    n_new_samples: int
    65	    n_model_fits: int
    66	    delta_optimization: float
    67	    delta_surrogate: float       # NaN if no surrogate metric before/after
    68	    delta_coverage: float        # NaN if no coverage delta computable
    69	    utility: float
    70	    metrics: dict[str, float] = field(default_factory=dict)
    71	    trajectory_tail: tuple = field(default_factory=tuple)
    72	    error: Optional[str] = None
    73	
    74	
    75	@dataclass(frozen=True)
    76	class RolloutOutput:
    77	    s_t: OptimizationState
    78	    results: tuple[CounterfactualResult, ...]
    79	
    80	
    81	# ---------------------------------------------------------------------------
    82	# Counterfactual rollout
    83	# ---------------------------------------------------------------------------
    84	
    85	
    86	class PolicyLike:
    87	    """Structural type — actual policies from opt_agent.loop.policies."""
    88	
    89	    def select_action(self, state, backend=None) -> OptimizationAction: ...
    90	
    91	
    92	# Default continuation policy: a fresh rule policy. Used when caller passes
    93	# None for `continuation_spec`.
    94	DEFAULT_CONTINUATION_SPEC = ContinuationPolicySpec(name="rule", seed=0)
    95	
    96	
    97	class CounterfactualRollout:
    98	    """Run counterfactual rollouts from a state for a list of candidate actions.
    99	
   100	    Parameters
   101	    ----------
   102	    backend : UnifiedBackend
   103	    horizon : int
   104	        How many action steps to simulate per branch (≥1). Per codex Q-T1
   105	        (2026-09-25): horizon is a plain int. To simulate until the budget
   106	        is exhausted, the caller passes `state.resource.remaining_budget` as
   107	        the horizon value — this keeps `CounterfactualRollout` free of
   108	        special "until exhausted" semantics.
   109	    utility_weights : UtilityWeights
   110	    continuation_spec : ContinuationPolicySpec | None
   111	        Spec describing the policy used for follow-up steps when horizon > 1.
   112	        Defaults to `DEFAULT_CONTINUATION_SPEC` (rule). Per codex Q-T2, the
   113	        spec's name/seed/extras must be recorded in dataset metadata so that
   114	        any record can be replayed with a different continuation.
   115	    max_rollout_steps : int
   116	        Hard cap on total (candidates × horizon) evaluations to prevent
   117	        runaway computation.
   118	    """
   119	
   120	    def __init__(
   121	        self,
   122	        backend: UnifiedBackend,
   123	        *,
   124	        horizon: int = 1,
   125	        utility_weights: UtilityWeights | None = None,
   126	        continuation_spec: ContinuationPolicySpec | None = None,
   127	        max_rollout_steps: int = 200,
   128	        optimization_scale: float = 1.0,
   129	        evaluation_scale: float = 1.0,
   130	        fit_scale: float = 1.0,
   131	    ) -> None:
   132	        if horizon < 1:
   133	            raise ValueError(f"horizon must be >= 1; got {horizon}")
   134	        scales = (optimization_scale, evaluation_scale, fit_scale)
   135	        if not all(math.isfinite(s) and s > 0 for s in scales):
   136	            raise ValueError(
   137	                f"utility scales must be finite and positive; got {scales}"
   138	            )
   139	        self.backend = backend
   140	        self.horizon = horizon
   141	        self.weights = utility_weights or UtilityWeights()
   142	        self.continuation_spec = continuation_spec or DEFAULT_CONTINUATION_SPEC
   143	        self.max_rollout_steps = max_rollout_steps
   144	        self.optimization_scale = optimization_scale
   145	        self.evaluation_scale = evaluation_scale
   146	        self.fit_scale = fit_scale
   147	
   148	    def rollout(
   149	        self,
   150	        state: OptimizationState,
   151	        candidates: list[Candidate],
   152	    ) -> RolloutOutput:
   153	        if not candidates:
   154	            raise ValueError("candidates must not be empty")
   155	        # Reject duplicate action_ids — they would collide in results dict.
   156	        ids = [c.action_id for c in candidates]
   157	        duplicates = [i for i, c in Counter(ids).items() if c > 1]
   158	        if duplicates:
   159	            raise ValueError(
   160	                f"duplicate action_id in candidates: {duplicates}. "
   161	                f"Each candidate must have a unique id."
   162	            )
   163	        if len(candidates) * self.horizon > self.max_rollout_steps:
   164	            raise ValueError(
   165	                f"rollout step cap exceeded: {len(candidates)} candidates × "
   166	                f"{self.horizon} horizon = {len(candidates) * self.horizon} > "
   167	                f"{self.max_rollout_steps}"
   168	            )
   169	
   170	        base = self.backend.checkpoint()
   171	        observed = extract_state(
   172	            self.backend,
   173	            total_budget=state.resource.total_budget,
   174	            last_action=state.history.last_action,
   175	        )
   176	        # State sanity check: extract_state from current backend must match the
   177	        # passed state (otherwise caller passed stale state).
   178	        if observed.sampling.n_samples != state.sampling.n_samples:
   179	            raise ValueError(
   180	                f"State does not describe the checkpointed backend: "
   181	                f"state has n_samples={state.sampling.n_samples}, "
   182	                f"backend has {observed.sampling.n_samples}."
   183	            )
   184	
   185	        results: list[CounterfactualResult] = []
   186	        try:
   187	            for candidate in candidates:
   188	                results.append(self._run_one_branch(state, candidate, base))
   189	        finally:
   190	            self.backend.restore(base)
   191	
   192	        return RolloutOutput(s_t=state, results=tuple(results))
   193	
   194	    def _run_one_branch(
   195	        self,
   196	        state: OptimizationState,
   197	        candidate: Candidate,
   198	        base: Checkpoint,
   199	    ) -> CounterfactualResult:
   200	        self.backend.restore(base)
   201	        # Re-extract branch's starting state from the restored backend.
   202	        branch_state = extract_state(
   203	            self.backend,
   204	            total_budget=state.resource.total_budget,
   205	            last_action=state.history.last_action,
   206	        )
   207	        steps: list = []
   208	        n_new = 0
   209	        n_fits = 0
   210	        status = "valid"
   211	        error: Optional[str] = None
   212	        policy = (
   213	            build_continuation_policy(self.continuation_spec)
   214	            if self.horizon > 1 else None
   215	        )
   216	        try:
   217	            action = candidate.action
   218	            for step_index in range(self.horizon):
   219	                if step_index > 0:
   220	                    if branch_state.resource.remaining_budget <= 0:
   221	                        break
   222	                    assert policy is not None
   223	                    action = policy.select_action(branch_state, self.backend)
   224	
   225	                result = execute_action(self.backend, branch_state, action)
   226	                n_new += result.n_new_samples
   227	                n_fits += result.n_model_fits
   228	
   229	                next_state = extract_state(
   230	                    self.backend,
   231	                    total_budget=state.resource.total_budget,
   232	                    last_action=action.type.value,
   233	                )
   234	                steps.append((branch_state, action, result, next_state))
   235	                branch_state = next_state
   236	
   237	                if result.should_stop:
   238	                    break
   239	        except ValueError as exc:
   240	            status, error = "invalid", str(exc)
   241	
   242	        # Phase 7: Δopt = best_after − best_before (positive = improvement).
   243	        delta_opt = branch_state.optimization.best_value - state.optimization.best_value
   244	
   245	        # Phase 7: Δsurrogate = validation_rmse_before − validation_rmse_after
   246	        # (positive = surrogate improved). NaN if either side is NaN.
   247	        rs_before = state.surrogate.validation_rmse
   248	        rs_after = branch_state.surrogate.validation_rmse
   249	        if math.isfinite(rs_before) and math.isfinite(rs_after):
   250	            delta_surrogate = float(rs_before - rs_after)
   251	        else:
   252	            delta_surrogate = float("nan")
   253	
   254	        # Phase 7: Δcoverage = boundary_coverage_after − boundary_coverage_before
   255	        # (positive = more boundary coverage).
   256	        delta_coverage = float(
   257	            branch_state.sampling.boundary_coverage
   258	            - state.sampling.boundary_coverage
   259	        )
   260	
   261	        utility = compute_utility(
   262	            delta_optimization=delta_opt,
   263	            delta_surrogate=delta_surrogate,
   264	            delta_coverage=delta_coverage,
   265	            n_new_samples=n_new,
   266	            n_model_fits=n_fits,
   267	            weights=self.weights,
   268	            optimization_scale=self.optimization_scale,
   269	            evaluation_scale=self.evaluation_scale,
   270	            fit_scale=self.fit_scale,
   271	            is_stop=(candidate.action.type.name == "STOP"),
   272	            remaining_budget_ratio=branch_state.resource.remaining_budget_ratio,
   273	        )
   274	        return CounterfactualResult(
   275	            action_id=candidate.action_id,
   276	            action=candidate.action,
   277	            status=status,
   278	            n_new_samples=n_new,
   279	            n_model_fits=n_fits,
   280	            delta_optimization=float(delta_opt),
   281	            delta_surrogate=float(delta_surrogate),
   282	            delta_coverage=float(delta_coverage),
   283	            utility=float(utility),
   284	            metrics={
   285	                "best_before": float(state.optimization.best_value),
   286	                "best_after": float(branch_state.optimization.best_value),
   287	                "rmse_before": float(rs_before),
   288	                "rmse_after": float(rs_after),

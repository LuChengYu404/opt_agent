    84	def test_enforce_warn_on_legacy(tmp_path, monkeypatch):
    85	    import warnings as _w
    86	
    87	    from opt_agent.dataset import decision_record as dr
    88	    from opt_agent.dataset.versioning import (
    89	        VersionPolicy, enforce_record_versions,
    90	    )
    91	    # Reset the once-per-source warning memo for a clean check.
    92	    import opt_agent.dataset.versioning as ver
    93	    monkeypatch.setattr(ver, "_legacy_warned", set())
    94	    with _w.catch_warnings(record=True) as caught:

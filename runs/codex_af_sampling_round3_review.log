   132	def composite(delta, n_new, n_fits, scale, budget, is_stop, remaining):
   133	    return delta / scale - n_new / budget - 0.5 * n_fits / budget - (0.75 * remaining / budget if is_stop else 0.0)
   134	
   135	
   136	def branch(be, base, first, *, budget, scale, kind, stream, max_steps=None):
   137	    """Identical branch prefixes; actual evaluation count controls termination."""
   138	    be.restore(base)
   139	    start = extract_state(be, total_budget=budget)
   140	    before, n0 = start.optimization.best_value, start.sampling.n_samples
   141	    state = start
   142	    n_fits = steps = 0
   143	    prefix = None
   144	    legacy = OnPolicyMix(seed=stream) if kind == "legacy" else None
   145	    action = first
   146	    for j in range(budget + 10):
   147	        if state.resource.remaining_budget <= 0:
   148	            break
   149	        if max_steps is not None and j >= max_steps:
   150	            break
   151	        step_seed = seed_for(stream, state.sampling.n_samples, j)
   152	        torch.manual_seed(step_seed)
   153	        if j:
   154	            action = (legacy.select_action(state, be) if legacy is not None
   155	                      else continuation_action(state, kind, step_seed))
   156	        result = execute_action(be, state, action)
   157	        n_fits += result.n_model_fits
   158	        steps += 1
   159	        state = extract_state(be, total_budget=budget, last_action=action.type.value)
   160	        snapshot = {
   161	            "delta": state.optimization.best_value - before,
   162	            "n_new": state.sampling.n_samples - n0, "n_fits": n_fits,
   163	            "n_evaluations": state.sampling.n_samples, "steps": steps,
   164	            "stopped": result.should_stop,
   165	        }
   166	        snapshot["composite"] = composite(snapshot["delta"], snapshot["n_new"], n_fits,
   167	                                           scale, budget, first.type == ActionType.STOP,
   168	                                           state.resource.remaining_budget)
   169	        if steps == 3 or result.should_stop or state.resource.remaining_budget == 0:
   170	            if prefix is None:
   171	                prefix = dict(snapshot)
   172	        if result.should_stop:
   173	            break
   174	    if steps == 0:
   175	        raise ValueError("empty counterfactual branch")
   176	    if prefix is None:
   177	        prefix = dict(snapshot)
   178	    if kind != "legacy" and max_steps is None and first.type != ActionType.STOP:
   179	        if state.resource.remaining_budget:
   180	            raise ValueError("full-budget continuation did not exhaust evaluations")


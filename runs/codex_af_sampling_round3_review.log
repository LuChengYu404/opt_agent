   109	def _executable_criterion(action: OptimizationAction, state: OptimizationState) -> str:
   110	    """Describe the candidate that the executor will actually receive."""
   111	    kind = action.type
   112	    params = action.params
   113	    description = _DESCRIPTIONS[kind.value]
   114	    if kind == ActionType.STOP:
   115	        return f"{description} Uses 0 objective evaluations and ends the run with any remaining budget unused."
   116	    if kind == ActionType.RETRAIN_SURROGATE:
   117	        return (
   118	            f"{description} Uses 0 objective evaluations and fits the surrogate now. "
   119	            "It gives a new diagnostic state before choosing again, but no new observation. "
   120	            "Surrogate-based sampling actions already fit automatically when needed."
   121	        )
   122	
   123	    # Narrative fallback (1 evaluation) matches the executor's budget-safe
   124	    # n_samples default; factory-built candidates always carry explicit
   125	    # params, so this only narrates hand-constructed bare actions.
   126	    n_evaluations = int(params.get("n_samples", 1))
   127	    details = []
   128	    if "n_samples" in params:
   129	        details.append(f"n_samples={n_evaluations}")
   130	    if "step" in params:
   131	        details.append(f"step={params['step']:g} of the domain width around the best point")
   132	    if "tol" in params:
   133	        details.append(f"tol={params['tol']:g} of the domain width from a boundary")
   134	    if "seed" in params:
   135	        details.append(f"seed={params['seed']} (fixed for reproducibility)")
   136	    parameter_text = f" Fixed call parameters: {', '.join(details)}." if details else ""
   137	    fit_text = (
   138	        " Fits the surrogate first if it is not current."
   139	        if kind in (ActionType.UNCERTAINTY_SAMPLING,
   140	                    ActionType.ERROR_GUIDED_SAMPLING,
   141	                    ActionType.SURROGATE_ACQUISITION) and not state.surrogate.is_current
   142	        else " Uses the current surrogate without refitting."
   143	        if kind in (ActionType.UNCERTAINTY_SAMPLING,
   144	                    ActionType.ERROR_GUIDED_SAMPLING,
   145	                    ActionType.SURROGATE_ACQUISITION)
   146	        else " Does not fit the surrogate."
   147	    )
   148	    return (
   149	        f"{description}{parameter_text} Uses {n_evaluations} objective "
   150	        f"evaluation{'s' if n_evaluations != 1 else ''}.{fit_text}"
   151	    )

   117	        runaway computation.
   118	    """
   119	
   120	    def __init__(
   121	        self,
   122	        backend: UnifiedBackend,
   123	        *,
   124	        horizon: int = 1,
   125	        utility_weights: UtilityWeights | None = None,
   126	        continuation_spec: ContinuationPolicySpec | None = None,
   127	        max_rollout_steps: int = 200,
   128	        optimization_scale: float = 1.0,
   129	        evaluation_scale: float = 1.0,
   130	        fit_scale: float = 1.0,
   131	    ) -> None:
   132	        if horizon < 1:
   133	            raise ValueError(f"horizon must be >= 1; got {horizon}")
   134	        scales = (optimization_scale, evaluation_scale, fit_scale)
   135	        if not all(math.isfinite(s) and s > 0 for s in scales):
   136	            raise ValueError(
   137	                f"utility scales must be finite and positive; got {scales}"
   138	            )

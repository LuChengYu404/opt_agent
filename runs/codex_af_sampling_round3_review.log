   194	def _do_global_exploration(backend: UnifiedBackend, action: OptimizationAction) -> int:
   195	    """TS (LMABO exploratory group): argmax of a posterior sample.
   196	
   197	    Replaces the pre-h2 Sobol space-filling draw; `seed` is accepted but
   198	    unused (see module docstring)."""
   199	    n_samples = int(action.params.get("n_samples", 1))
   200	    return _greedy_af_samples(backend, n_samples, AF_GLOBAL_EXPLORATION)
   201	
   202	
   203	def _do_local_exploitation(backend: UnifiedBackend, action: OptimizationAction) -> int:
   204	    """PI (LMABO exploitative group, tau = incumbent) inside the step trust region.
   205	
   206	    Replaces the pre-h2 uniform perturbation of the incumbent."""
   207	    step = float(action.params.get("step", 0.1))
   208	    return _greedy_af_samples(
   209	        backend, 1, AF_LOCAL_EXPLOITATION, trust_region_step=step
   210	    )

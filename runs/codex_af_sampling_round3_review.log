   133	def test_restore_atomic_on_backend_id_mismatch() -> None:
   134	    be = initialized_backend()
   135	    before = be.checkpoint()
   136	    bad = replace(before, backend_id="wrong.Backend")
   137	
   138	    with pytest.raises(ValueError, match="backend_id mismatch"):
   139	        be.restore(bad)
   140	
   141	    # Backend state unchanged.
   142	    after = be.checkpoint()
   143	    assert torch.equal(after.X, before.X)
   144	    assert torch.equal(after.objectives, before.objectives)
   145	

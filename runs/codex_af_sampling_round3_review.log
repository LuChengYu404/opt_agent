   213	def _do_surrogate_acquisition(backend: UnifiedBackend, action: OptimizationAction) -> int:
   214	    """Single point from the selected portfolio AF (default LogEI, h1 behaviour)."""
   215	    af = str(action.params.get("af", AF_DEFAULT))
   216	    fits = 0
   217	    if not backend.is_fitted:
   218	        backend.fit()
   219	        fits = 1
   220	    X_new = backend.propose(n=1, af=af)
   221	    backend.evaluate(X_new)
   222	    return fits

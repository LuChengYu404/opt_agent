    96	        enforce_record_versions({"utility_version": ver.UTILITY_VERSION},
    97	                                VersionPolicy.WARN, record_id="r1",
    98	                                source="legacy.jsonl")
    99	    assert any("legacy" in str(w.message) for w in caught)

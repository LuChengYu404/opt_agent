   109	def test_logei_default_path_matches_inline_reference(fitted_branin) -> None:
   110	    """The registry's LogEI path is byte-identical to the pre-portfolio
   111	    inline propose(): same acquisition, same optimizer settings, same RNG
   112	    consumption."""
   113	    from botorch.acquisition.analytic import LogExpectedImprovement
   114	    from botorch.optim import optimize_acqf
   115	
   116	    best_f = float(fitted_branin.get_history().objectives.max())
   117	
   118	    def reference() -> torch.Tensor:
   119	        ei = LogExpectedImprovement(model=fitted_branin._model, best_f=best_f)
   120	        candidate, _ = optimize_acqf(
   121	            acq_function=ei,
   122	            bounds=fitted_branin.bounds,
   123	            q=1,
   124	            num_restarts=4,
   125	            raw_samples=16,
   126	        )
   127	        return candidate.detach()
   128	
   129	    rng = torch.random.get_rng_state().clone()
   130	    x_ref = reference()
   131	    torch.random.set_rng_state(rng)
   132	    x_new = fitted_branin.propose(n=1)  # default af="LogEI"
   133	    assert torch.equal(x_ref, x_new)

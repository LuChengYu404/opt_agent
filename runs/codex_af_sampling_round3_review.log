    80	    # is a dispatch-time property of AF-based samplers (lazy, per point).
    81	    # n_samples fallbacks are the budget-safe minimum (1). Canonical
    82	    # candidates from actions.factory always carry explicit params
    83	    # (n_samples=2 for GLOBAL_EXPLORATION / BOUNDARY_SAMPLING), so the
    84	    # fallback only fires for hand-constructed bare actions.
    85	    if action.type == ActionType.GLOBAL_EXPLORATION:
    86	        n_samples = int(action.params.get("n_samples", 1))
    87	    elif action.type == ActionType.LOCAL_EXPLOITATION:
    88	        n_samples = 1
    89	    elif action.type == ActionType.UNCERTAINTY_SAMPLING:
    90	        n_samples = int(action.params.get("n_samples", 1))
    91	    elif action.type == ActionType.ERROR_GUIDED_SAMPLING:
    92	        n_samples = int(action.params.get("n_samples", 1))
    93	    elif action.type == ActionType.BOUNDARY_SAMPLING:
    94	        n_samples = int(action.params.get("n_samples", 1))
    95	    elif action.type == ActionType.SURROGATE_ACQUISITION:

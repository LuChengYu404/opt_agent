   106	def test_two_restores_produce_same_history_after_one_more_step() -> None:
   107	    """BoTorch GP fit is non-deterministic across calls (scipy_minimize
   108	    non-reproducible); we test history equivalence instead of step equivalence.
   109	
   110	    With Phase 6 correction, GP state IS preserved across restores — so the
   111	    new candidate should be bit-identical.
   112	    """
   113	    be = initialized_backend()
   114	    be.fit()
   115	    cp = be.checkpoint()
   116	
   117	    # First restore + step (no explicit refit needed; GP state restored).
   118	    be.restore(cp)
   119	    be.evaluate(be.propose())
   120	    h1 = be.get_history()
   121	
   122	    # Second restore + step.
   123	    be.restore(cp)
   124	    be.evaluate(be.propose())
   125	    h2 = be.get_history()
   126	
   127	    # With GP state preserved across restore, the proposed candidate should
   128	    # be bit-identical.
   129	    assert torch.equal(h1.X[-1:], h2.X[-1:])
   130	    assert torch.equal(h1.objectives[-1:], h2.objectives[-1:])

    51	def run_one(fid: int, dim: int, instance: int, seed: int, budget: int,
    52	            policy_name: str, models: dict) -> dict:
    53	    problem = ioh.get_problem(fid=fid, dimension=dim, instance=instance,
    54	                              problem_class=ioh.ProblemClass.BBOB)
    55	    backend = IOHBackend()
    56	    backend.initialize(problem, n_init=5, seed=seed)
    57	    initial = backend.get_history().objectives[:, 0].tolist()
    58	    if policy_name == "rf_all":
    59	        policy = RFPolicy(models, seed)
    60	    elif policy_name == "rule_full":
    61	        policy = RuleFullBudget(seed=seed)
    62	    elif policy_name == "global_then_local":
    63	        policy = GlobalThenLocal(seed)
    64	    else:
    65	        policy = FixedPolicy({"surrogate": "surrogate_acquisition",
    66	                              "local": "local_exploitation"}[policy_name], seed)
    67	    trajectory = DecisionLoop(backend, total_budget=budget).run(
    68	        policy, max_rounds=budget + 5,
    69	    )
    70	    values = backend.get_history().objectives[:, 0].tolist()
    71	    initial_best = max(initial)
    72	    best = max(values)
    73	    optimum = -float(problem.optimum.y) if problem.optimum is not None else None
    74	    denom = optimum - initial_best if optimum is not None else None
    75	    regret = ((optimum - best) / denom if denom and denom > 0 else None)
    76	    anytime = []
    77	    incumbent = initial_best
    78	    for value in values[5:]:
    79	        incumbent = max(incumbent, value)
    80	        anytime.append(incumbent)
    81	    anytime.extend([incumbent] * (budget - 5 - len(anytime)))
    82	    return {
    83	        "fid": fid, "function": problem.meta_data.name, "dim": dim,
    84	        "instance": instance, "seed": seed, "budget": budget,
    85	        "policy": policy_name, "initial_values": initial,
    86	        "initial_best_max": initial_best, "terminal_best_max": best,
    87	        "optimum_max": optimum, "normalized_regret": regret,
    88	        "anytime_auc_gain": statistics.fmean(anytime) - initial_best,
    89	        "n_evaluations": len(values), "n_steps": len(trajectory.steps),
    90	        "termination": trajectory.termination_reason.value,
    91	        "actions": [step.action.type.value for step in trajectory.steps],
    92	    }
    93	

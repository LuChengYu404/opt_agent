   111	def choices(state, menu, seed):
   112	    out = candidate_actions_for_state(state, seed=0)
   113	    if menu in ("unit", "batch"):
   114	        out = {a: v for a, v in out.items() if a in SAMPLING}
   115	    for a, action in list(out.items()):
   116	        params = dict(action.params)
   117	        if "seed" in params:
   118	            params["seed"] = seed
   119	        if menu == "unit" and "n_samples" in params:
   120	            params["n_samples"] = 1
   121	        out[a] = OptimizationAction(action.type, params)
   122	    return out

   116	def _maximize_lbfgsb(acqf, bounds: torch.Tensor) -> torch.Tensor:
   117	    from botorch.optim import optimize_acqf
   118	
   119	    candidate, _ = optimize_acqf(
   120	        acq_function=acqf,
   121	        bounds=bounds,
   122	        q=1,
   123	        num_restarts=NUM_RESTARTS,
   124	        raw_samples=RAW_SAMPLES,
   125	    )
   126	    return candidate.detach()

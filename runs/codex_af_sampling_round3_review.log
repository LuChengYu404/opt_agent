    81	def test_checkpoint_is_clone_not_view() -> None:
    82	    """Mutating the checkpoint tensor must not affect the backend."""
    83	    be = initialized_backend()
    84	    cp = be.checkpoint()
    85	    cp.X[0, 0] = 999.0
    86	
    87	    assert be.get_history().X[0, 0] != 999.0

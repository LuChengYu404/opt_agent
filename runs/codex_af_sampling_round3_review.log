    70	
    71	    # Stale-state detection: if backend has grown past state, refuse.
    72	    current_n = len(backend.get_history())
    73	    if current_n != state.sampling.n_samples:
    74	        raise ValueError(
    75	            f"Stale state: state.sampling.n_samples={state.sampling.n_samples} "
    76	            f"but backend has {current_n} samples. Re-extract state first."
    77	        )
    78	

    72	def _candidate_set(bounds: torch.Tensor, size: int) -> torch.Tensor:
    73	    """Scrambled Sobol candidates scaled to `bounds` [2, d].
    74	
    75	    The scramble seed is drawn from the global torch RNG (not fixed) so
    76	    checkpoint-restored rollouts replay identically.
    77	    """
    78	    from torch.quasirandom import SobolEngine
    79	
    80	    seed = int(torch.randint(0, 2**31 - 1, (1,)).item())
    81	    unit = SobolEngine(dimension=bounds.shape[1], scramble=True, seed=seed).draw(
    82	        size
    83	    ).to(dtype=torch.double)
    84	    return bounds[0] + unit * (bounds[1] - bounds[0])
    85	
    86	
    87	def _draw_optimal_samples(
    88	    model, bounds: torch.Tensor, n: int
    89	) -> tuple[torch.Tensor, torch.Tensor]:
    90	    """Draw `n` optimal-input samples (Thompson-style argmax draws).
    91	
    92	    Returns (optimal_inputs [n, d], optimal_outputs [n, 1]) where the output
    93	    is the same posterior sample evaluated at its argmax. Used to construct
    94	    qPES/qJES, which in BoTorch >=0.18 require explicit optimal-input draws.
    95	    """
    96	    X = _candidate_set(bounds, DISCRETE_CANDIDATES)
    97	    with torch.no_grad():
    98	        posterior = model.posterior(X)
    99	        samples = posterior.rsample(torch.Size([n]))  # [n, C, 1]
   100	    flat = samples.reshape(n, -1)
   101	    idx = flat.argmax(dim=-1)  # [n]
   102	    optimal_inputs = X[idx]  # [n, d]
   103	    optimal_outputs = flat.gather(1, idx.unsqueeze(-1))  # [n, 1]
   104	    return optimal_inputs, optimal_outputs

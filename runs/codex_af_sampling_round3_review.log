    61	def test_checkpoint_preserves_fitted_state_with_gp_model() -> None:
    62	    """Phase 6 correction: restore() rehydrates the GP model from pickled
    63	    state_dict, so is_fitted remains True and propose() works without refit.
    64	    """
    65	    be = initialized_backend()
    66	    be.fit()
    67	    assert be.is_fitted
    68	    cp = be.checkpoint()
    69	
    70	    # Mutate backend.
    71	    be.evaluate(torch.tensor([[0.0, 7.5]], dtype=torch.double))
    72	
    73	    # Restore.
    74	    be.restore(cp)
    75	    assert be.is_fitted  # GP model was rehydrated
    76	    # propose() works without explicit refit.
    77	    x_new = be.propose(n=1)
    78	    assert x_new.shape == (1, 2)
    79	

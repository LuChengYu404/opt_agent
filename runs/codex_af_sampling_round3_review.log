   136	# ---------------------------------------------------------------------------
   137	# AF-based sampling helpers
   138	# ---------------------------------------------------------------------------
   139	
   140	
   141	def _trust_region_bounds(
   142	    backend: UnifiedBackend, step: float
   143	) -> torch.Tensor:
   144	    """[incumbent - step*span, incumbent + step*span] ∩ domain, as [2, d].
   145	
   146	    LOCAL_EXPLOITATION's `step` param is reinterpreted (h2) as the
   147	    trust-region radius: the PI maximizer is confined to this box, so the
   148	    action keeps its locality contract (same |x - best| <= step*span
   149	    guarantee as the pre-portfolio perturbation implementation).
   150	    """
   151	    history = backend.get_history()
   152	    best_idx = int(history.objectives[:, 0].argmax().item())
   153	    best = history.X[best_idx]
   154	    dom = backend.bounds
   155	    assert dom is not None, "Backend must expose bounds for LOCAL_EXPLOITATION"
   156	    span = dom[1] - dom[0]
   157	    lo = torch.maximum(dom[0], best - step * span)
   158	    hi = torch.minimum(dom[1], best + step * span)
   159	    return torch.stack([lo, hi])
   160	
   161	
   162	def _greedy_af_samples(
   163	    backend: UnifiedBackend,
   164	    n_samples: int,
   165	    af: str,
   166	    *,
   167	    trust_region_step: float | None = None,
   168	) -> int:
   169	    """Sequential greedy AF maximization: one point per round-trip.
   170	
   171	    Each evaluate() invalidates the GP, so the next point maximizes the same
   172	    AF on the refitted posterior — equivalent to running `n_samples` LMABO
   173	    iterations with `af` fixed. Fits are lazy (only when stale); returns the
   174	    number of fits triggered.
   175	
   176	    Atomicity (codex round-1 review, finding B): the module contract says
   177	    backend exceptions propagate with NO partial history mutation. A greedy
   178	    multi-point action would otherwise commit earlier points before a later
   179	    fit/propose/evaluate fails, with no ActionResult reporting them. When the
   180	    backend supports checkpoint/restore, the action is therefore wrapped
   181	    atomically: any exception rolls history, GP, and RNG back to the
   182	    pre-action state before propagating. Backends without checkpoint support
   183	    (e.g. scripts/ioh_backend.py's IOHBackend) keep the pre-h2 behaviour of
   184	    partial commitment — documented here rather than silently assumed.
   185	    """
   186	    cp = backend.checkpoint() if hasattr(backend, "checkpoint") else None
   187	    try:
   188	        fits = 0
   189	        for _ in range(n_samples):
   190	            if not backend.is_fitted:
   191	                backend.fit()
   192	                fits += 1
   193	            bounds = None
   194	            if trust_region_step is not None:
   195	                bounds = _trust_region_bounds(backend, trust_region_step)
   196	            X_new = backend.propose(n=1, af=af, bounds=bounds)
   197	            backend.evaluate(X_new)
   198	    except Exception as exc:
   199	        if cp is not None:
   200	            try:
   201	                backend.restore(cp)
   202	            except Exception as rollback_exc:  # pragma: no cover - defense in depth
   203	                # Surface BOTH failures: the rollback failing silently would
   204	                # hide a partially-mutated backend (codex round-2 MINOR).
   205	                raise RuntimeError(
   206	                    "Greedy action failed AND the rollback restore failed; "
   207	                    "the backend may be partially mutated. "
   208	                    f"original={exc!r}; rollback={rollback_exc!r}"
   209	                ) from exc
   210	        raise
   211	    return fits
   212	
   213	
   214	# ---------------------------------------------------------------------------
   215	# Action implementations
   216	# ---------------------------------------------------------------------------
   217	
   218	
   219	def _do_global_exploration(backend: UnifiedBackend, action: OptimizationAction) -> int:
   220	    """TS (LMABO exploratory group): argmax of a posterior sample.
   221	
   222	    Replaces the pre-h2 Sobol space-filling draw; `seed` is accepted but
   223	    unused (see module docstring)."""
   224	    n_samples = int(action.params.get("n_samples", 1))
   225	    return _greedy_af_samples(backend, n_samples, AF_GLOBAL_EXPLORATION)
   226	
   227	
   228	def _do_local_exploitation(backend: UnifiedBackend, action: OptimizationAction) -> int:
   229	    """PI (LMABO exploitative group, tau = incumbent) inside the step trust region.
   230	
   231	    Replaces the pre-h2 uniform perturbation of the incumbent."""
   232	    step = float(action.params.get("step", 0.1))
   233	    return _greedy_af_samples(
   234	        backend, 1, AF_LOCAL_EXPLOITATION, trust_region_step=step
   235	    )
   236	
   237	
   238	def _do_surrogate_acquisition(backend: UnifiedBackend, action: OptimizationAction) -> int:
   239	    """Single point from the selected portfolio AF (default LogEI, h1 behaviour)."""
   240	    af = str(action.params.get("af", AF_DEFAULT))
   241	    fits = 0
   242	    if not backend.is_fitted:
   243	        backend.fit()
   244	        fits = 1
   245	    X_new = backend.propose(n=1, af=af)
   246	    backend.evaluate(X_new)
   247	    return fits
   248	
   249	
   250	def _do_uncertainty_sampling(backend: UnifiedBackend, action: OptimizationAction) -> int:
   251	    """PosSTD (LMABO exploratory group): maximize posterior std analytically.
   252	
   253	    Replaces the pre-h2 Sobol-grid std argmax with continuous AF
   254	    maximization; `seed` is accepted but unused."""
   255	    n_samples = int(action.params.get("n_samples", 1))


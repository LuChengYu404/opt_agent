    43	def test_checkpoint_restores_history_bit_for_bit() -> None:
    44	    be = initialized_backend()
    45	    cp = be.checkpoint()
    46	    expected = be.get_history()
    47	
    48	    # Mutate backend.
    49	    be.fit()
    50	    candidate = torch.tensor([[0.0, 7.5]], dtype=torch.double)
    51	    be.evaluate(candidate)
    52	
    53	    # Restore.
    54	    be.restore(cp)
    55	    actual = be.get_history()
    56	    assert torch.equal(actual.X, expected.X)
    57	    assert torch.equal(actual.objectives, expected.objectives)
    58	    assert torch.equal(actual.constraints, expected.constraints)
    59	

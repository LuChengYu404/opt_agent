   107	def _maximize_discrete(acqf, bounds: torch.Tensor) -> torch.Tensor:
   108	    """Discrete argmax of a q-acquisition over the random candidate set."""
   109	    X = _candidate_set(bounds, DISCRETE_CANDIDATES).unsqueeze(1)  # [C, 1, d]
   110	    with torch.no_grad():
   111	        values = acqf(X).reshape(-1)  # [C]
   112	    idx = int(values.argmax().item())
   113	    return X[idx, 0].unsqueeze(0)  # [1, d]

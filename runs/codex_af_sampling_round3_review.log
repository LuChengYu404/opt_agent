     1	"""Dataset / harness version stamps — code-side half of guide §4.5 + §6.6.
     2	
     3	Discipline (RESEARCH_BOUNDARY_GUIDE.md):
     4	
     5	- ``HARNESS_VERSION`` freezes the measurement system: observation format
     6	  (state features), the action menu, and the harness-side record schema.
     7	  ``UTILITY_VERSION`` is the finer stamp tracking the S-class
     8	  supervision-defining components (utility weights/scales, continuation
     9	  policy, rollout horizon, gold temperature, action-subset quota,
    10	  replicate count): an S-class change bumps UTILITY_VERSION (and
    11	  HARNESS_VERSION too iff observation format or the action menu also
    12	  changed) — matching guide §6.6 rule 1.
    13	- ``UTILITY_VERSION`` is the finer stamp: it tracks the S-class label
    14	  definition only (utility weights/scales, continuation policy, rollout
    15	  horizon, gold temperature, action-subset quota, replicate count).
    16	
    17	Reading rule (:func:`check_record_versions`):
    18	
    19	- ``OK``       — record carries the current stamps; poolable.
    20	- ``LEGACY``   — stamp missing (records predate the mechanism) or holds a
    21	  known-past value: readable, but must not be pooled with current-version
    22	  records without an explicit same-data A/B note (§6.6 rule 1).
    23	- ``MISMATCH`` — stamp is not a recognized value (e.g. a future version
    24	  read by older code): refuse to pool.
    25	
    26	Known-past values are listed in ``_KNOWN_PAST``; extend it when bumping
    27	either constant so old data reads as LEGACY rather than MISMATCH.
    28	"""
    29	
    30	from __future__ import annotations
    31	
    32	import json
    33	from enum import Enum
    34	from pathlib import Path
    35	from typing import Any, Mapping
    36	
    37	# h2 (2026-10-01): LMABO AF transplant (docs/AF_SAMPLING_20261001.md) —
    38	# executor sampling semantics changed (TS / trust-region PI / PosSTD) and
    39	# SURROGATE_ACQUISITION gained the `af` param. Action menu, observation
    40	# format, and record schema are unchanged, but trajectories and U(a,s)
    41	# labels generated under h1 executors are not poolable with h2 data
    42	# (guide 4.5 rule 5: harness evolution happens at version boundaries).
    43	HARNESS_VERSION = "h2"
    44	UTILITY_VERSION = "phase8.6b"
    45	
    46	# Stamps that may appear in historical records. "phase8.6b" doubles as the
    47	# current UTILITY_VERSION; "h1" predates the LMABO AF transplant.
    48	_KNOWN_PAST: dict[str, set[str]] = {
    49	    "harness": {"h1"},  # heuristic sampling executors (Sobol / perturbation)
    50	    "utility": set(),  # phase8.6b is the first formalized utility version
    51	}
    52	
    53	
    54	class VersionStatus(str, Enum):
    55	    OK = "ok"
    56	    LEGACY = "legacy"
    57	    MISMATCH = "mismatch"
    58	
    59	
    60	class VersionPolicy(str, Enum):
    61	    """Pooling policy enforced at a dataset loading boundary (guide 4.5/6.6).
    62	
    63	    ALLOW  - no check (back-compat; implicit pooling decision is "unchecked").
    64	    WARN   - summarize LEGACY once per source (do-not-pool reminder) and warn
    65	             on MISMATCH, but keep reading.
    66	    STRICT - raise VersionPolicyError on the first MISMATCH; LEGACY still only
    67	             warns (legacy records are the repo's history, the policy makes
    68	             the pooling decision EXPLICIT rather than forbidding reads).
    69	    """
    70	
    71	    ALLOW = "allow"
    72	    WARN = "warn"
    73	    STRICT = "strict"
    74	
    75	
    76	class VersionPolicyError(ValueError):
    77	    """A record carries an unrecognized version stamp under STRICT policy."""
    78	
    79	
    80	_legacy_warned: set[str] = set()
    81	
    82	
    83	def enforce_record_versions(
    84	    record_metadata: Mapping[str, Any],
    85	    policy: str | VersionPolicy,
    86	    *,
    87	    record_id: str = "",
    88	    source: str = "",
    89	) -> dict[str, VersionStatus]:
    90	    """Apply a pooling policy to one record's metadata.
    91	
    92	    Returns the per-axis status (same shape as check_record_versions).
    93	    LEGACY warns at most once per (source, axis) to avoid spam on large
    94	    legacy datasets; MISMATCH raises under STRICT.
    95	    """
    96	    policy = VersionPolicy(policy)
    97	    status = check_record_versions(record_metadata)
    98	    if policy is VersionPolicy.ALLOW:
    99	        return status
   100	    import warnings
   101	
   102	    for axis, st in status.items():
   103	        key = f"{source}:{axis}"
   104	        if st is VersionStatus.LEGACY and key not in _legacy_warned:
   105	            _legacy_warned.add(key)
   106	            warnings.warn(
   107	                f"{source}: {axis} stamp is legacy/absent (record "
   108	                f"{record_id!r} first seen); pooling legacy records with "
   109	                f"current-version records requires an explicit same-data "
   110	                f"A/B note (guide 6.6 rule 1)",
   111	                stacklevel=2,
   112	            )
   113	        if st is VersionStatus.MISMATCH:
   114	            stamp = record_metadata.get(f"{axis}_version")
   115	            msg = (f"{source}: record {record_id!r} has unrecognized "
   116	                   f"{axis} stamp {stamp!r} (current: "
   117	                   f"{HARNESS_VERSION if axis == 'harness' else UTILITY_VERSION}); "
   118	                   f"refusing to pool under STRICT policy")
   119	            if policy is VersionPolicy.STRICT:
   120	                raise VersionPolicyError(msg)
   121	            warnings.warn(msg, stacklevel=2)
   122	    return status
   123	
   124	
   125	import os
   126	
   127	_recorded_pooling_decisions: list[dict] = []
   128	
   129	# Pooling opt-ins are persisted here (best effort) so the decision survives
   130	# the process that made it (codex round-5 B3). Override for tests/other CWDs.
   131	POOLING_AUDIT_PATH = Path(
   132	    os.environ.get("OPT_AGENT_POOLING_AUDIT", "runs/POOLING_DECISIONS.jsonl"))
   133	
   134	
   135	def pooling_decisions() -> list[dict]:
   136	    """Audit trail of explicit cross-version pooling decisions."""
   137	    return list(_recorded_pooling_decisions)
   138	
   139	
   140	def _persist_pooling_decision(entry: dict) -> None:
   141	    """Persist a pooling opt-in; an opt-in without a durable trail FAILS.
   142	
   143	    Codex round-6 B3: silently swallowing the write error would let an
   144	    accepted cross-version pool leave no record, defeating the audit.
   145	    """
     1	"""Utility function for counterfactual rollouts (Phase 8.5 fix).
     2	
     3	Per MASTER_PLAN.md §10 and codex (gpt-5.6-sol) review 2025-09-23 + Phase 8.5
     4	empirical finding (STOP dominance):
     5	
     6	  U(a|s) = w_optimization * ΔQ_optimization / optimization_scale
     7	        + w_surrogate * ΔQ_surrogate
     8	        + w_coverage * ΔQ_coverage
     9	        − w_evaluation * n_new_samples / evaluation_scale
    10	        − w_fit * n_model_fits / fit_scale
    11	        − w_stop_opportunity * remaining_budget_ratio   (if is_stop)
    12	
    13	Scales (default 1.0) decouple problem units from weights: objective scale
    14	estimated per problem family, evaluation/fit scale = total_budget. Defaults
    15	preserve backward compatibility for tests that don't supply scales.
    16	
    17	NaN / Inf handling: non-finite delta_surrogate / delta_coverage are treated
    18	as 0; non-finite delta_optimization / scales raise ValueError (programmer
    19	error, not data uncertainty).
    20	"""
    21	
    22	from __future__ import annotations
    23	
    24	import math
    25	from dataclasses import dataclass
    26	from typing import Any
    27	
    28	
    29	@dataclass(frozen=True)
    30	class UtilityWeights:
    31	    """Weights for the 5-term utility function.
    32	
    33	    Phase 8.5 defaults (per codex review):
    34	      - w_surrogate = 0: validation_rmse is in-sample training RMSE, not
    35	        leave-one-out; cannot be trusted until surrogate metric is fixed.
    36	      - w_coverage = 0: `boundary_coverage` is fraction near edge, not a
    37	        proper coverage metric; needs a grid/fill-distance version.
    38	      - w_stop_opportunity = 0: disables the optional linear STOP penalty
    39	        (proportional to remaining_budget_ratio). The DEFAULT is 0.75
    40	        (Phase 8.5, codex-empirical), not 0.
    41	    """
    42	    w_optimization: float = 1.0
    43	    w_surrogate: float = 0.0
    44	    w_coverage: float = 0.0
    45	    w_evaluation: float = 1.0
    46	    w_fit: float = 0.5

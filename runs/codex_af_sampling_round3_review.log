    97	class CounterfactualRollout:
    98	    """Run counterfactual rollouts from a state for a list of candidate actions.
    99	
   100	    Parameters
   101	    ----------
   102	    backend : UnifiedBackend
   103	    horizon : int
   104	        How many action steps to simulate per branch (≥1). Per codex Q-T1
   105	        (2026-09-25): horizon is a plain int. To simulate until the budget
   106	        is exhausted, the caller passes `state.resource.remaining_budget` as
   107	        the horizon value — this keeps `CounterfactualRollout` free of
   108	        special "until exhausted" semantics.
   109	    utility_weights : UtilityWeights
   110	    continuation_spec : ContinuationPolicySpec | None
   111	        Spec describing the policy used for follow-up steps when horizon > 1.
   112	        Defaults to `DEFAULT_CONTINUATION_SPEC` (rule). Per codex Q-T2, the
   113	        spec's name/seed/extras must be recorded in dataset metadata so that
   114	        any record can be replayed with a different continuation.
   115	    max_rollout_steps : int
   116	        Hard cap on total (candidates × horizon) evaluations to prevent
   117	        runaway computation.
   118	    """
   119	
   120	    def __init__(
   121	        self,
   122	        backend: UnifiedBackend,
   123	        *,
   124	        horizon: int = 1,
   125	        utility_weights: UtilityWeights | None = None,
   126	        continuation_spec: ContinuationPolicySpec | None = None,
   127	        max_rollout_steps: int = 200,
   128	        optimization_scale: float = 1.0,
   129	        evaluation_scale: float = 1.0,
   130	        fit_scale: float = 1.0,
   131	    ) -> None:
   132	        if horizon < 1:
   133	            raise ValueError(f"horizon must be >= 1; got {horizon}")
   134	        scales = (optimization_scale, evaluation_scale, fit_scale)
   135	        if not all(math.isfinite(s) and s > 0 for s in scales):
   136	            raise ValueError(
   137	                f"utility scales must be finite and positive; got {scales}"
   138	            )
   139	        self.backend = backend
   140	        self.horizon = horizon
   141	        self.weights = utility_weights or UtilityWeights()
   142	        self.continuation_spec = continuation_spec or DEFAULT_CONTINUATION_SPEC
   143	        self.max_rollout_steps = max_rollout_steps
   144	        self.optimization_scale = optimization_scale
   145	        self.evaluation_scale = evaluation_scale
   146	        self.fit_scale = fit_scale
   147	
   148	    def rollout(
   149	        self,
   150	        state: OptimizationState,
   151	        candidates: list[Candidate],
   152	    ) -> RolloutOutput:
   153	        if not candidates:
   154	            raise ValueError("candidates must not be empty")
   155	        # Reject duplicate action_ids — they would collide in results dict.
   156	        ids = [c.action_id for c in candidates]
   157	        duplicates = [i for i, c in Counter(ids).items() if c > 1]
   158	        if duplicates:
   159	            raise ValueError(
   160	                f"duplicate action_id in candidates: {duplicates}. "
   161	                f"Each candidate must have a unique id."
   162	            )
   163	        if len(candidates) * self.horizon > self.max_rollout_steps:
   164	            raise ValueError(
   165	                f"rollout step cap exceeded: {len(candidates)} candidates × "
   166	                f"{self.horizon} horizon = {len(candidates) * self.horizon} > "
   167	                f"{self.max_rollout_steps}"
   168	            )
   169	
   170	        base = self.backend.checkpoint()
   171	        observed = extract_state(
   172	            self.backend,
   173	            total_budget=state.resource.total_budget,
   174	            last_action=state.history.last_action,
   175	        )
   176	        # State sanity check: extract_state from current backend must match the
   177	        # passed state (otherwise caller passed stale state).
   178	        if observed.sampling.n_samples != state.sampling.n_samples:
   179	            raise ValueError(
   180	                f"State does not describe the checkpointed backend: "
   181	                f"state has n_samples={state.sampling.n_samples}, "
   182	                f"backend has {observed.sampling.n_samples}."
   183	            )
   184	
   185	        results: list[CounterfactualResult] = []
   186	        try:
   187	            for candidate in candidates:
   188	                results.append(self._run_one_branch(state, candidate, base))
   189	        finally:
   190	            self.backend.restore(base)
   191	
   192	        return RolloutOutput(s_t=state, results=tuple(results))
   193	
   194	    def _run_one_branch(
   195	        self,
   196	        state: OptimizationState,
   197	        candidate: Candidate,
   198	        base: Checkpoint,
   199	    ) -> CounterfactualResult:
   200	        self.backend.restore(base)
   201	        # Re-extract branch's starting state from the restored backend.
   202	        branch_state = extract_state(
   203	            self.backend,
   204	            total_budget=state.resource.total_budget,
   205	            last_action=state.history.last_action,
   206	        )
   207	        steps: list = []
   208	        n_new = 0
   209	        n_fits = 0
   210	        status = "valid"
   211	        error: Optional[str] = None
   212	        policy = (
   213	            build_continuation_policy(self.continuation_spec)
   214	            if self.horizon > 1 else None
   215	        )
   216	        try:
   217	            action = candidate.action
   218	            for step_index in range(self.horizon):
   219	                if step_index > 0:
   220	                    if branch_state.resource.remaining_budget <= 0:
   221	                        break
   222	                    assert policy is not None
   223	                    action = policy.select_action(branch_state, self.backend)
   224	
   225	                result = execute_action(self.backend, branch_state, action)
   226	                n_new += result.n_new_samples
   227	                n_fits += result.n_model_fits
   228	
   229	                next_state = extract_state(
   230	                    self.backend,
   231	                    total_budget=state.resource.total_budget,
   232	                    last_action=action.type.value,
   233	                )
   234	                steps.append((branch_state, action, result, next_state))
   235	                branch_state = next_state
   236	
   237	                if result.should_stop:
   238	                    break
   239	        except ValueError as exc:
   240	            status, error = "invalid", str(exc)
   241	
   242	        # Phase 7: Δopt = best_after − best_before (positive = improvement).
   243	        delta_opt = branch_state.optimization.best_value - state.optimization.best_value
   244	
   245	        # Phase 7: Δsurrogate = validation_rmse_before − validation_rmse_after
   246	        # (positive = surrogate improved). NaN if either side is NaN.
   247	        rs_before = state.surrogate.validation_rmse
   248	        rs_after = branch_state.surrogate.validation_rmse
   249	        if math.isfinite(rs_before) and math.isfinite(rs_after):
   250	            delta_surrogate = float(rs_before - rs_after)
   251	        else:
   252	            delta_surrogate = float("nan")
   253	
   254	        # Phase 7: Δcoverage = boundary_coverage_after − boundary_coverage_before
   255	        # (positive = more boundary coverage).
   256	        delta_coverage = float(
   257	            branch_state.sampling.boundary_coverage
   258	            - state.sampling.boundary_coverage
   259	        )
   260	
   261	        utility = compute_utility(
   262	            delta_optimization=delta_opt,
   263	            delta_surrogate=delta_surrogate,
   264	            delta_coverage=delta_coverage,
   265	            n_new_samples=n_new,
   266	            n_model_fits=n_fits,
   267	            weights=self.weights,
   268	            optimization_scale=self.optimization_scale,
   269	            evaluation_scale=self.evaluation_scale,
   270	            fit_scale=self.fit_scale,
   271	            is_stop=(candidate.action.type.name == "STOP"),
   272	            remaining_budget_ratio=branch_state.resource.remaining_budget_ratio,
   273	        )
   274	        return CounterfactualResult(
   275	            action_id=candidate.action_id,
   276	            action=candidate.action,
   277	            status=status,
   278	            n_new_samples=n_new,
   279	            n_model_fits=n_fits,
   280	            delta_optimization=float(delta_opt),
   281	            delta_surrogate=float(delta_surrogate),
   282	            delta_coverage=float(delta_coverage),
   283	            utility=float(utility),
   284	            metrics={
   285	                "best_before": float(state.optimization.best_value),
   286	                "best_after": float(branch_state.optimization.best_value),
   287	                "rmse_before": float(rs_before),
   288	                "rmse_after": float(rs_after),
   289	                "boundary_coverage_before": float(state.sampling.boundary_coverage),
   290	                "boundary_coverage_after": float(branch_state.sampling.boundary_coverage),
   291	            },
   292	            trajectory_tail=tuple(steps),
   293	            error=error,
   294	        )
   295	
   296	
   297	# ---------------------------------------------------------------------------
   298	# Helpers
   299	# ---------------------------------------------------------------------------
   300	
   301	
   302	def to_gold_probs(
   303	    results: tuple[CounterfactualResult, ...],
   304	    *,
   305	    temperature: float = 1.0,
   306	    include_invalid_as_zero: bool = False,
   307	) -> dict[str, float]:
   308	    """Convert CounterfactualResult utilities into softmax probabilities.
   309	
   310	    Parameters
   311	    ----------
   312	    include_invalid_as_zero : bool
   313	        If True, invalid candidates are included in the output dict with
   314	        probability 0.0 (preserves aligned vocabulary). Default False: only
   315	        valid candidates are returned (vocabulary may shrink).
   316	    """
   317	    if not results:
   318	        raise ValueError("results must not be empty")
   319	    if not math.isfinite(temperature) or temperature <= 0:
   320	        raise ValueError(
   321	            f"temperature must be finite and > 0; got {temperature}"
   322	        )
   323	    valid = [r for r in results if r.status == "valid"]
   324	    if not valid:
   325	        if not include_invalid_as_zero:
   326	            raise ValueError("no valid candidate actions")
   327	        # All invalid; emit zeros so vocabulary is preserved.
   328	        return {r.action_id: 0.0 for r in results}
   329	    utilities = np.asarray([r.utility for r in valid], dtype=np.float64)
   330	    if not np.isfinite(utilities).all():
   331	        raise ValueError("valid utilities must be finite")
   332	    z = utilities / temperature
   333	    z -= z.max()
   334	    probabilities = np.exp(z)
   335	    probabilities /= probabilities.sum()
   336	    valid_probs = {
   337	        r.action_id: float(p)
   338	        for r, p in zip(valid, probabilities, strict=True)
   339	    }
   340	    if include_invalid_as_zero:
   341	        for r in results:
   342	            if r.status != "valid":
   343	                valid_probs[r.action_id] = 0.0
   344	    return valid_probs


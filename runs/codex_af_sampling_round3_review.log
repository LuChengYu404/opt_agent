    36	    bounds_ub: np.ndarray = field(default=None, init=False)
    37	    dim: int = field(default=0, init=False)
    38	    _history_X: Optional[torch.Tensor] = field(default=None, init=False)
    39	    _history_y: Optional[torch.Tensor] = field(default=None, init=False)
    40	    _fitted_X: Optional[torch.Tensor] = field(default=None, init=False)
    41	    _fitted_y: Optional[torch.Tensor] = field(default=None, init=False)
    42	    _fitted: bool = field(default=False, init=False)
    43	    _counter: int = field(default=0, init=False)
    44	
    45	    def initialize(self, problem, n_init: int = 5, seed: int = 0) -> None:
    46	        """Initialize with an ioh problem. n_init and seed are honored.
    47	
    48	        Convention: IOH minimizes, but v3 framework assumes maximization.
    49	        We negate IOH values at storage time so `history.objectives.max()`
    50	        gives the best-seen (negated-min = max of negated). The LLM sees
    51	        correct maximization values; local_exploitation's argmax works.
    52	        """
    53	        self.problem = problem
    54	        self.dim = int(problem.meta_data.n_variables)
    55	        # bounds.lb / bounds.ub may be scalars or per-dim arrays.
    56	        lb_arr = np.asarray(problem.bounds.lb).flatten()
    57	        ub_arr = np.asarray(problem.bounds.ub).flatten()
    58	        if lb_arr.size == 1:
    59	            lb = float(lb_arr[0])
    60	            ub = float(ub_arr[0])
    61	            self.bounds_lb = np.full(self.dim, lb)
    62	            self.bounds_ub = np.full(self.dim, ub)
    63	        else:
    64	            assert lb_arr.size == self.dim and ub_arr.size == self.dim
    65	            self.bounds_lb = lb_arr.astype(float)
    66	            self.bounds_ub = ub_arr.astype(float)
    67	        # Sobol-like initial points (using torch.quasirandom).
    68	        from torch.quasirandom import SobolEngine
    69	        torch.manual_seed(seed)
    70	        sobol = SobolEngine(dimension=self.dim, scramble=True, seed=seed)
    71	        unit = sobol.draw(n_init).to(dtype=torch.double)
    72	        X0 = torch.tensor(self.bounds_lb, dtype=torch.double) + unit * (
    73	            torch.tensor(self.bounds_ub - self.bounds_lb, dtype=torch.double)
    74	        )
    75	        # Evaluate IOH problems in batch (ioh supports vectorized).
    76	        with torch.no_grad():
    77	            raw_y0 = torch.tensor(
    78	                [self.problem(x.cpu().numpy()) for x in X0], dtype=torch.double
    79	            ).reshape(-1, 1)
    80	        # NEGATE so that maximization semantics hold throughout the
    81	        # downstream state extraction / LLM payload.
    82	        y0 = -raw_y0
    83	        self._history_X = X0.detach().clone()
    84	        self._history_y = y0.detach().clone()
    85	        self._fitted = False
    86	        self._counter = 0
    87	
    88	    def evaluate(self, X: torch.Tensor):
    89	        if X.ndim != 2 or X.shape[1] != self.dim:
    90	            raise ValueError(f"shape mismatch: {tuple(X.shape)} vs dim={self.dim}")
    91	        if not torch.isfinite(X).all():
    92	            raise ValueError("non-finite X")
    93	        with torch.no_grad():
    94	            raw_y = torch.tensor(
    95	                [self.problem(x.cpu().numpy()) for x in X], dtype=torch.double
    96	            ).reshape(-1, 1)
    97	        # NEGATE for maximization semantics.
    98	        new_y = -raw_y
    99	        self._history_X = torch.cat([self._history_X, X.detach()], dim=0)
   100	        self._history_y = torch.cat([self._history_y, new_y.detach()], dim=0)
   101	        self._fitted = False
   102	        return new_y.detach()
   103	
   104	    def fit(self) -> None:
   105	        from botorch.models import SingleTaskGP
   106	        from botorch.models.transforms import Normalize
   107	        from gpytorch.mlls import ExactMarginalLogLikelihood
   108	        from botorch.fit import fit_gpytorch_mll
   109	
   110	        X = self._history_X.detach().clone()
   111	        # history_y already stores -IOH_y; GP fits a maximization model
   112	        # directly on it. No negation needed here.
   113	        Y = self._history_y.detach().clone()
   114	        transform = (Normalize(d=self.dim, bounds=self.bounds)
   115	                     if self.normalize_inputs else None)
   116	        self._model = SingleTaskGP(X, Y, input_transform=transform)
   117	        self._mll = ExactMarginalLogLikelihood(self._model.likelihood, self._model)
   118	        try:
   119	            fit_gpytorch_mll(self._mll)
   120	            self._fitted = True
   121	        except Exception:
   122	            self._fitted = False
   123	            raise
   124	
   125	    @property
   126	    def is_fitted(self) -> bool:
   127	        return self._fitted
   128	
   129	    def propose(
   130	        self,
   131	        n: int = 1,
   132	        af: str = "LogEI",
   133	        bounds: torch.Tensor | None = None,
   134	    ) -> torch.Tensor:
   135	        if not self._fitted:
   136	            raise RuntimeError("Backend not fitted — call fit() first.")
   137	        if n != 1:
   138	            raise ValueError("IOHBackend only supports n=1 propose.")
   139	        bounds_t = bounds if bounds is not None else self.bounds
   140	        # history_y stores -IOH_y; max is the best (negated-min).
   141	        best_f = float(self._history_y.max().item())
   142	        try:
   143	            # Shared LMABO portfolio registry (src/opt_agent). All exp
   144	            # entry points already import opt_agent, so this resolves.
   145	            from opt_agent.backend.acquisitions import propose_candidate
   146	            return propose_candidate(
   147	                af, model=self._model, best_f=best_f, bounds=bounds_t
   148	            )
   149	        except ImportError:
   150	            # Standalone fallback: inline LogEI only.
   151	            if af != "LogEI":
   152	                raise ValueError(
   153	                    f"af={af!r} requires opt_agent.backend.acquisitions."
   154	                )
   155	            from botorch.acquisition.analytic import LogExpectedImprovement
   156	            from botorch.optim import optimize_acqf
   157	
   158	            ei = LogExpectedImprovement(model=self._model, best_f=best_f)
   159	            candidate, _ = optimize_acqf(
   160	                acq_function=ei, bounds=bounds_t, q=1,
   161	                num_restarts=4, raw_samples=16,
   162	            )
   163	            return candidate.detach()
   164	
   165	    def predict(self, X: torch.Tensor):
   166	        if not self._fitted:
   167	            raise RuntimeError("not fitted")
   168	        if X.ndim != 2:
   169	            raise ValueError(f"predict expects [n, d]; got {tuple(X.shape)}")
   170	        self._model.eval()
   171	        with torch.no_grad():
   172	            posterior = self._model.posterior(X)
   173	            mean = posterior.mean
   174	            var = posterior.variance
   175	            if var.ndim == 1:
   176	                var = var.unsqueeze(-1)
   177	            std = var.clamp(min=0.0).sqrt()
   178	        # GP is fit on -IOH_y; posterior.mean is on the negated scale
   179	        # (= v3 maximizing scale). Return as-is.
   180	        return mean.detach(), std.detach()
   181	
   182	    @property
   183	    def bounds(self):
   184	        return torch.stack([
   185	            torch.tensor(self.bounds_lb, dtype=torch.double),
   186	            torch.tensor(self.bounds_ub, dtype=torch.double),
   187	        ])
   188	
   189	    def get_history(self):
   190	        class _Batch:
   191	            def __init__(self, X, y):
   192	                self.X = X
   193	                self.objectives = y
   194	            def __len__(self):
   195	                return self.X.shape[0]
   196	        return _Batch(self._history_X.detach(), self._history_y.detach())
   197	
   198	    # -- checkpoint / restore -------------------------------------------------
   199	    # Added for the h2 atomic-executor contract (codex round-2 review,
   200	    # MAJOR-2): multi-point greedy actions roll back through
   201	    # checkpoint/restore, so every executor-driven backend must support
   202	    # them. Mirrors BocodeBotorchBackend's Checkpoint protocol. NOTE: both
   203	    # IOHBackend consumers in this repo (exp_rq2_ioh_closed_loop,
   204	    # exp_attribution_suite) use BBOB-class problems; `problem_id` encodes
   205	    # "fid:dim:instance" and restore() reconstructs via ProblemClass.BBOB —
   206	    # extend the encoding before reusing this backend with other classes.
   207	
   208	    def checkpoint(self):
   209	        from io import BytesIO
   210	
   211	        from opt_agent.backend.checkpoint import Checkpoint
   212	
   213	        if self.problem is None or self._history_X is None:
   214	            raise RuntimeError("Backend not initialized — call initialize() first.")
   215	        md = self.problem.meta_data
   216	        model_bytes = None
   217	        if self._fitted and self._model is not None:
   218	            buf = BytesIO()
   219	            torch.save(self._model.state_dict(), buf)
   220	            model_bytes = buf.getvalue()
   221	        rng_buf = BytesIO()
   222	        torch.save(torch.random.get_rng_state(), rng_buf)
   223	        n = self._history_X.shape[0]
   224	        return Checkpoint(
   225	            backend_id=type(self).__module__ + "." + type(self).__name__,
   226	            problem_id=f"{md.problem_id}:{self.dim}:{md.instance}",
   227	            problem_bounds=list(zip(self.bounds_lb.tolist(),
   228	                                    self.bounds_ub.tolist())),
   229	            X=self._history_X.detach().clone(),
   230	            objectives=self._history_y.detach().clone(),
   231	            constraints=torch.zeros((n, 0), dtype=torch.double),
   232	            fitted=self._fitted,
   233	            model_state_dict=model_bytes,
   234	            torch_rng_state=rng_buf.getvalue(),
   235	            normalize_inputs=self.normalize_inputs,
   236	        )
   237	
   238	    def restore(self, cp) -> None:
   239	        from io import BytesIO
   240	
   241	        from opt_agent.backend.checkpoint import Checkpoint
   242	
   243	        if not isinstance(cp, Checkpoint):
   244	            raise ValueError(
   245	                f"restore() expects Checkpoint; got {type(cp).__name__}")
   246	        expected = type(self).__module__ + "." + type(self).__name__
   247	        if cp.backend_id != expected:
   248	            raise ValueError(
   249	                f"Checkpoint backend_id mismatch: expected {expected}, "
   250	                f"got {cp.backend_id!r}. Refusing to restore.")
   251	        X = cp.X.detach().clone()
   252	        y = cp.objectives.detach().clone()
   253	        if X.ndim != 2 or y.shape[0] != X.shape[0]:
   254	            raise ValueError(
   255	                f"Checkpoint shape mismatch: X={tuple(X.shape)}, "
   256	                f"obj={tuple(y.shape)}")
   257	        bounds = torch.tensor(cp.problem_bounds, dtype=torch.double).T.contiguous()
   258	        if (bounds.shape != (2, X.shape[1]) or not torch.isfinite(bounds).all()
   259	                or not (bounds[1] > bounds[0]).all()):
   260	            raise ValueError("Checkpoint bounds mismatch or invalid search box")
   261	        fid_s, dim_s, inst_s = cp.problem_id.split(":")
   262	        fid, dim, inst = int(fid_s), int(dim_s), int(inst_s)
   263	        if dim != X.shape[1]:
   264	            raise ValueError(
   265	                f"Checkpoint dim {dim} != history dim {X.shape[1]}")
   266	
   267	        md = getattr(self.problem, "meta_data", None)
   268	        if (self.problem is None or md is None
   269	                or (md.problem_id, self.dim, md.instance) != (fid, dim, inst)):
   270	            import ioh
   271	            problem = ioh.get_problem(
   272	                fid=fid, dimension=dim, instance=inst,
   273	                problem_class=ioh.ProblemClass.BBOB,
   274	            )
   275	        else:
   276	            problem = self.problem
   277	
   278	        self.problem = problem
   279	        self.dim = dim
   280	        self.bounds_lb = bounds[0].numpy().astype(float)
   281	        self.bounds_ub = bounds[1].numpy().astype(float)
   282	        self._history_X = X
   283	        self._history_y = y
   284	        setting = getattr(cp, "normalize_inputs", None)
   285	        if setting is not None:
   286	            self.normalize_inputs = bool(setting)
   287	
   288	        if cp.fitted and cp.model_state_dict is not None:
   289	            from botorch.models import SingleTaskGP
   290	            from botorch.models.transforms import Normalize
   291	            from gpytorch.mlls import ExactMarginalLogLikelihood
   292	
   293	            try:
   294	                state = torch.load(BytesIO(cp.model_state_dict),
   295	                                   weights_only=False)
   296	                transform = (Normalize(d=dim, bounds=bounds)
   297	                             if self.normalize_inputs else None)
   298	                model = SingleTaskGP(X, y, input_transform=transform)
   299	                self._mll = ExactMarginalLogLikelihood(model.likelihood, model)
   300	                model.load_state_dict(state)
   301	                # eval() normalizes train inputs (_set_transformed_inputs);
   302	                # see acquisitions._entropy_workspace for the train-mode pitfall.
   303	                model.eval()
   304	                self._model = model
   305	                self._fitted = True
   306	            except Exception:
   307	                self._model = None
   308	                self._mll = None
   309	                self._fitted = False
   310	        else:
   311	            self._model = None
   312	            self._mll = None
   313	            self._fitted = False
   314	
   315	        if cp.torch_rng_state is not None:
   316	            try:
   317	                torch.random.set_rng_state(
   318	                    torch.load(BytesIO(cp.torch_rng_state), weights_only=False))
   319	            except Exception:
   320	                pass  # RNG restore is best-effort

+# ---------------------------------------------------------------------------
+# AF-based sampling helpers
+# ---------------------------------------------------------------------------
+
+
+def _trust_region_bounds(
+    backend: UnifiedBackend, step: float
+) -> torch.Tensor:
+    """[incumbent - step*span, incumbent + step*span] ∩ domain, as [2, d].
+
+    LOCAL_EXPLOITATION's `step` param is reinterpreted (h2) as the
+    trust-region radius: the PI maximizer is confined to this box, so the
+    action keeps its locality contract (same |x - best| <= step*span
+    guarantee as the pre-portfolio perturbation implementation).
+    """
+    history = backend.get_history()
+    best_idx = int(history.objectives[:, 0].argmax().item())
+    best = history.X[best_idx]
+    dom = backend.bounds
+    assert dom is not None, "Backend must expose bounds for LOCAL_EXPLOITATION"
+    span = dom[1] - dom[0]
+    lo = torch.maximum(dom[0], best - step * span)
+    hi = torch.minimum(dom[1], best + step * span)
+    return torch.stack([lo, hi])
+
+
+def _greedy_af_samples(
+    backend: UnifiedBackend,
+    n_samples: int,
+    af: str,
+    *,
+    trust_region_step: float | None = None,
+) -> int:
+    """Sequential greedy AF maximization: one point per round-trip.
+
+    Each evaluate() invalidates the GP, so the next point maximizes the same
+    AF on the refitted posterior — equivalent to running `n_samples` LMABO
+    iterations with `af` fixed. Fits are lazy (only when stale); returns the
+    number of fits triggered.
+    """
+    fits = 0
+    for _ in range(n_samples):
+        if not backend.is_fitted:
+            backend.fit()
+            fits += 1
+        bounds = None
+        if trust_region_step is not None:
+            bounds = _trust_region_bounds(backend, trust_region_step)
+        X_new = backend.propose(n=1, af=af, bounds=bounds)
+        backend.evaluate(X_new)
+    return fits
+
+

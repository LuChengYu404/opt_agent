   176	def test_subprocess_pickle_roundtrip() -> None:
   177	    """Spawn a subprocess that creates a checkpoint and prints its pickle.
   178	
   179	    Validate that the parent process can pickle.loads and inspect it.
   180	    """
   181	    import pickle
   182	    import subprocess
   183	
   184	    script = """
   185	import pickle, sys
   186	sys.path.insert(0, 'src')
   187	from opt_agent.backend.bocode_botorch import BackendConfig, BocodeBotorchBackend
   188	be = BocodeBotorchBackend()
   189	be.initialize(BackendConfig(problem_id='Branin', seed=0, n_init=5))
   190	cp = be.checkpoint()
   191	sys.stdout.buffer.write(pickle.dumps(cp))
   192	"""
   193	    out = subprocess.run(
   194	        ["uv", "run", "python", "-c", script],
   195	        capture_output=True, check=True, cwd=ROOT

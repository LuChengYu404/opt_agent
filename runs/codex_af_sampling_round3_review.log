   236	    monkeypatch.setattr(ver, "POOLING_AUDIT_PATH", audit)
   237	    monkeypatch.setattr(ver, "_legacy_warned", set())
   238	    monkeypatch.setattr(ver, "_recorded_pooling_decisions", [])
   239	

   136	def test_ts_proposal_replays_after_checkpoint_restore() -> None:
   137	    """TS randomness flows through the global torch RNG, so a checkpoint
   138	    restore (history + GP + RNG) reproduces the exact proposal — the
   139	    counterfactual-rollout fairness mechanism under the h2 sampler."""
   140	    be = BocodeBotorchBackend()
   141	    be.initialize(BackendConfig(problem_id="Branin", seed=11, n_init=5))
   142	    be.fit()
   143	    cp = be.checkpoint()
   144	    x1 = be.propose(n=1, af="TS")
   145	    be.evaluate(x1)
   146	    be.restore(cp)
   147	    x2 = be.propose(n=1, af="TS")
   148	    assert torch.equal(x1, x2)

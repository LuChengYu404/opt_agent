   352	def test_global_exploration_failure_rolls_back_committed_points() -> None:
   353	    """Round-1 B regression: a later greedy point failing must not leave the
   354	    earlier committed evaluations in history (atomic action contract)."""
   355	
   356	    class FailSecondEvaluate(RecordingBackend):
   357	        def evaluate(self, X):
   358	            if self.evaluate_calls == 1:  # second call (0-indexed first passed)
   359	                raise RuntimeError("second evaluation failure")
   360	            return super().evaluate(X)
   361	
   362	    backend = FailSecondEvaluate()
   363	    with pytest.raises(RuntimeError, match="second evaluation failure"):
   364	        execute_action(
   365	            backend,
   366	            state_for(backend),
   367	            OptimizationAction(ActionType.GLOBAL_EXPLORATION, {"n_samples": 2}),
   368	        )
   369	    # Atomic: the first point's evaluation was rolled back via restore().
   370	    assert len(backend.get_history()) == 2
   371	

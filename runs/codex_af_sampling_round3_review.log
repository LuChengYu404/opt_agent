    90	def test_checkpoint_independent_of_caller_mutation() -> None:
    91	    """Mutating the cp.X tensor after restore() must not affect the restored history.
    92	
    93	    restore() internally clones cp.X; subsequent in-place mutation of cp.X
    94	    is irrelevant.
    95	    """
    96	    be = initialized_backend()
    97	    cp = be.checkpoint()
    98	    original_x00 = float(be.get_history().X[0, 0].item())
    99	    be.restore(cp)
   100	    # Now mutate the cp's tensor.
   101	    cp.X[0, 0] = -999.0
   102	    # Backend's restored history was already cloned — should still hold the original.
   103	    assert float(be.get_history().X[0, 0].item()) == original_x00

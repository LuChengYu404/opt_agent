"""extract_state() — converts a backend's history into OptimizationState (Phase 2 + 6).

Pure read: must not mutate the backend or affect its RNG state.

Phase 6 additions: SamplingState includes min_pairwise_distance and
boundary_coverage; SurrogateState includes validation_rmse, mean_uncertainty,
max_uncertainty (populated only when backend.is_fitted; NaN otherwise).
"""

from __future__ import annotations

import functools
import math
from typing import Optional

import torch
from torch.quasirandom import SobolEngine

from opt_agent.backend.bocode_botorch import UnifiedBackend
from opt_agent.state.models import (
    HistoryState,
    OptimizationProgress,
    OptimizationState,
    ResourceState,
    SamplingState,
    SurrogateState,
)

# Grid size for posterior uncertainty statistics.
_UNCERTAINTY_GRID_SIZE = 64


def _boundary_tol() -> float:
    """Boundary coverage threshold as a fraction of the per-dimension
    range. Deferred import keeps `state.extractor` from depending on
    `actions.factory` at module load time. The single source of truth is
    `actions.factory.BOUNDARY_TOL`; that constant also drives
    BOUNDARY_SAMPLING's default `tol` so the coverage metric stays in
    sync with the action's actual search margin."""
    from opt_agent.actions.factory import BOUNDARY_TOL
    return BOUNDARY_TOL


def _min_pairwise_distance(X: torch.Tensor) -> float:
    if X.shape[0] < 2:
        return float("inf")
    # torch.cdist avoids the [n, n, d] intermediate the unsqueeze-sub
    # form would allocate; same answer, ~10x less transient memory for
    # n>=30 / d>=10.
    dists = torch.cdist(X, X)
    n = X.shape[0]
    mask = ~torch.eye(n, dtype=torch.bool, device=X.device)
    return float(dists[mask].min().item())


def _boundary_coverage(X: torch.Tensor, bounds: torch.Tensor, tol: float) -> float:
    """Fraction of samples within `tol` of any bounds edge.

    Phase 8.5 fix: validate bounds span > 0, validate samples are inside bounds,
    and use unit-cube normalized distance so the result is affine-invariant.

    Note (per codex): this is a "boundary-fraction" metric, NOT a true
    boundary coverage metric. Duplicates at one corner still score highly,
    and baseline increases with dimension. A grid-based fill-distance metric
    would be more rigorous but is out of scope for Phase 8.5.
    """
    if X.shape[0] == 0:
        return 0.0
    if not 0.0 <= tol <= 0.5:
        raise ValueError(f"tol must be in [0, 0.5]; got {tol}")
    span = bounds[1] - bounds[0]
    if torch.any(span <= 0):
        raise ValueError("bounds must have positive span")
    unit = (X - bounds[0]) / span
    eps = 10 * torch.finfo(unit.dtype).eps
    if torch.any((unit < -eps) | (unit > 1.0 + eps)):
        raise ValueError("samples lie outside bounds")
    near = ((unit <= tol) | (unit >= 1.0 - tol)).any(dim=-1)
    return float(near.to(torch.double).mean().item())


def _validation_rmse(backend: UnifiedBackend) -> float:
    """One-step RMSE of the GP on training history (predict at each X, compare to y)."""
    history = backend.get_history()
    if history.objectives.shape[0] < 2:
        return float("nan")
    mean, _ = backend.predict(history.X)
    residuals = mean - history.objectives
    return float(residuals.pow(2).mean().sqrt().item())


@functools.lru_cache(maxsize=16)
def _sobol_grid(d: int, size: int) -> torch.Tensor:
    """A unit-cube Sobol grid is deterministic for fixed (d, size) and
    is rebuilt on every ``extract_state`` call without this cache. The
    grid is reused across all backends of a given dimension."""
    return SobolEngine(dimension=d, scramble=True, seed=0).draw(size)


def _uncertainty_stats(backend: UnifiedBackend) -> tuple[float, float]:
    """Compute mean and max posterior std on a Sobol grid."""
    bounds = backend.bounds
    if bounds is None:
        return float("nan"), float("nan")
    d = bounds.shape[1]
    grid = bounds[0] + _sobol_grid(d, _UNCERTAINTY_GRID_SIZE).to(
        dtype=torch.double
    ) * (bounds[1] - bounds[0])
    _, std = backend.predict(grid)
    return float(std.mean().item()), float(std.max().item())


def extract_state(
    backend: UnifiedBackend,
    *,
    total_budget: int,
    last_action: Optional[str] = None,
) -> OptimizationState:
    """Read backend history + optional action label, produce OptimizationState.

    Parameters
    ----------
    backend : UnifiedBackend
        Must be initialized (have history). is_fitted is read.
    total_budget : int
        Maximum number of evaluations allowed for this run. Must be > 0 and
        >= n_samples.
    last_action : Optional[str]
        Name of the action that produced the most recent sample. None means
        "no action recorded yet" (typically the initial design).

    Returns
    -------
    OptimizationState — frozen, JSON-serializable, tensor-free.
    """
    if total_budget <= 0:
        raise ValueError(f"total_budget must be > 0; got {total_budget}")

    history = backend.get_history()
    n_samples = len(history)
    if total_budget < n_samples:
        raise ValueError(
            f"total_budget ({total_budget}) is less than current n_samples "
            f"({n_samples}); cannot extract state for a budget that is "
            f"already exhausted."
        )

    values = history.objectives[:, 0].tolist()  # Phase 1: single-objective only
    dimension = int(history.X.shape[1])

    incumbent = values[0]
    best_value = incumbent
    stagnation_steps = 0
    recent_improvement = 0.0
    for value in values[1:]:
        if value > incumbent:
            recent_improvement = value - incumbent
            incumbent = value
            stagnation_steps = 0
        else:
            recent_improvement = 0.0
            stagnation_steps += 1
    best_value = incumbent
    last_value = values[-1]

    # SamplingState coverage (Phase 6 extension).
    bounds = backend.bounds
    if bounds is not None and bounds.shape[1] == dimension:
        min_pd = _min_pairwise_distance(history.X)
        bcov = _boundary_coverage(history.X, bounds, tol=_boundary_tol())
    else:
        min_pd = float("inf")
        bcov = 0.0

    # SurrogateState (Phase 6 extension).
    is_fitted = bool(backend.is_fitted)
    if is_fitted:
        try:
            val_rmse = _validation_rmse(backend)
            mean_u, max_u = _uncertainty_stats(backend)
        except Exception:
            val_rmse, mean_u, max_u = float("nan"), float("nan"), float("nan")
    else:
        val_rmse, mean_u, max_u = float("nan"), float("nan"), float("nan")

    remaining_budget = total_budget - n_samples
    remaining_budget_ratio = remaining_budget / total_budget

    return OptimizationState(
        sampling=SamplingState(
            n_samples=n_samples,
            dimension=dimension,
            min_pairwise_distance=float(min_pd),
            boundary_coverage=float(bcov),
        ),
        surrogate=SurrogateState(
            is_current=is_fitted,
            validation_rmse=float(val_rmse),
            mean_uncertainty=float(mean_u),
            max_uncertainty=float(max_u),
        ),
        optimization=OptimizationProgress(
            best_value=float(best_value),
            last_value=float(last_value),
            recent_improvement=float(recent_improvement),
            stagnation_steps=int(stagnation_steps),
        ),
        resource=ResourceState(
            used_budget=n_samples,
            total_budget=total_budget,
            remaining_budget=remaining_budget,
            remaining_budget_ratio=float(remaining_budget_ratio),
        ),
        history=HistoryState(last_action=last_action),
    )
"""OptimizationAction dataclass + ActionType enum (Phase 3).

Per MASTER_PLAN.md §8 and codex (gpt-5.6-sol) review 2025-09-23.

Phase 3 actions (5 total — ERROR_GUIDED deferred because we don't yet have
leave-one-out residuals to distinguish "high uncertainty" from "high error"):
  - GLOBAL_EXPLORATION     Sobol sampling, ignores surrogate
  - LOCAL_EXPLOITATION     Perturb current best within bounds
  - SURROGATE_ACQUISITION  Fit GP (if needed), propose via LogEI, evaluate
  - RETRAIN_SURROGATE      Force a fresh GP fit, no evaluation
  - STOP                   Signal termination; does not mutate backend

`OptimizationAction.__post_init__` validates params at construction time so
invalid actions fail before reaching `execute_action`.
"""

from __future__ import annotations

import math
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Mapping


class ActionType(str, Enum):
    GLOBAL_EXPLORATION = "global_exploration"
    LOCAL_EXPLOITATION = "local_exploitation"
    UNCERTAINTY_SAMPLING = "uncertainty_sampling"
    ERROR_GUIDED_SAMPLING = "error_guided_sampling"
    BOUNDARY_SAMPLING = "boundary_sampling"
    SURROGATE_ACQUISITION = "surrogate_acquisition"
    RETRAIN_SURROGATE = "retrain_surrogate"
    STOP = "stop"


# Param schemas per action. Each entry lists (name, type, check_fn).
# check_fn returns the parsed value or raises ValueError.
def _positive_int(name: str, value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise ValueError(f"{name!r} must be int; got {type(value).__name__}")
    if value <= 0:
        raise ValueError(f"{name!r} must be > 0; got {value}")
    return int(value)


def _finite_float(name: str, value: Any, lo: float, hi: float) -> float:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        raise ValueError(f"{name!r} must be a number; got {type(value).__name__}")
    value = float(value)
    if not math.isfinite(value):
        raise ValueError(f"{name!r} must be finite; got {value}")
    if not (lo <= value <= hi):
        raise ValueError(f"{name!r} must lie in [{lo}, {hi}]; got {value}")
    return value


def _strictly_positive_finite_float(name: str, value: Any, hi: float) -> float:
    """Float in (0, hi] — used for step sizes where 0 is meaningless."""
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        raise ValueError(f"{name!r} must be a number; got {type(value).__name__}")
    value = float(value)
    if not math.isfinite(value):
        raise ValueError(f"{name!r} must be finite; got {value}")
    if not (0.0 < value <= hi):
        raise ValueError(f"{name!r} must lie in (0, {hi}]; got {value}")
    return value


def _non_negative_int(name: str, value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise ValueError(f"{name!r} must be int; got {type(value).__name__}")
    if value < 0:
        raise ValueError(f"{name!r} must be >= 0; got {value}")
    return int(value)


_PARAM_SCHEMAS: dict[ActionType, dict[str, Any]] = {
    ActionType.GLOBAL_EXPLORATION: {
        "n_samples": _positive_int,
        "seed": lambda n, v: _non_negative_int(n, v) if v is not None else None,
    },
    ActionType.LOCAL_EXPLOITATION: {
        "step": lambda n, v: _strictly_positive_finite_float(n, v, hi=1.0),
        "seed": lambda n, v: _non_negative_int(n, v) if v is not None else None,
    },
    ActionType.UNCERTAINTY_SAMPLING: {
        "n_samples": _positive_int,
        "seed": lambda n, v: _non_negative_int(n, v) if v is not None else None,
    },
    ActionType.ERROR_GUIDED_SAMPLING: {
        "n_samples": _positive_int,
        "seed": lambda n, v: _non_negative_int(n, v) if v is not None else None,
    },
    ActionType.BOUNDARY_SAMPLING: {
        "n_samples": _positive_int,
        "tol": lambda n, v: _finite_float(n, v, 0.0, 0.5),
        "seed": lambda n, v: _non_negative_int(n, v) if v is not None else None,
    },
    ActionType.SURROGATE_ACQUISITION: {},
    ActionType.RETRAIN_SURROGATE: {},
    ActionType.STOP: {},
}

_ALLOWED_PARAMS: dict[ActionType, set[str]] = {
    ActionType.GLOBAL_EXPLORATION: {"n_samples", "seed"},
    ActionType.LOCAL_EXPLOITATION: {"step", "seed"},
    ActionType.UNCERTAINTY_SAMPLING: {"n_samples", "seed"},
    ActionType.ERROR_GUIDED_SAMPLING: {"n_samples", "seed"},
    ActionType.BOUNDARY_SAMPLING: {"n_samples", "tol", "seed"},
    ActionType.SURROGATE_ACQUISITION: set(),
    ActionType.RETRAIN_SURROGATE: set(),
    ActionType.STOP: set(),
}


@dataclass(frozen=True)
class OptimizationAction:
    """A structured optimization action.

    Parameters
    ----------
    type : ActionType
    params : Mapping[str, Any]
        Per-action-type params; validated in __post_init__.
        See _ALLOWED_PARAMS for the allowed keys per type.
    """

    type: ActionType
    params: Mapping[str, Any] = field(default_factory=dict)

    def __post_init__(self) -> None:
        if not isinstance(self.type, ActionType):
            raise TypeError(
                f"action.type must be ActionType; got {type(self.type).__name__}: "
                f"{self.type!r}"
            )
        params = dict(self.params) if self.params is not None else {}
        allowed = _ALLOWED_PARAMS[self.type]
        for k in params:
            if k not in allowed:
                raise ValueError(
                    f"Unsupported params {k!r} for action {self.type.value}. "
                    f"Allowed: {sorted(allowed) or '<none>'}."
                )
        schema = _PARAM_SCHEMAS[self.type]
        validated: dict[str, Any] = {}
        for k, fn in schema.items():
            if k in params:
                validated[k] = fn(k, params[k])
        # Copy validated back so default values like seed=None don't leak through.
        for k in allowed - set(schema):
            if k in params:
                validated[k] = params[k]
        # Bypass frozen to install validated params.
        object.__setattr__(self, "params", validated)


@dataclass(frozen=True)
class ActionResult:
    """What `execute_action` returns after performing an action.

    Attributes
    ----------
    action : OptimizationAction
        The action that was executed (echo for logging).
    n_new_samples : int
        How many new samples were added to the backend (0 for RETRAIN / STOP).
    n_model_fits : int
        How many GP fits were triggered. SURROGATE_ACQUISITION triggers 1
        implicit fit when the surrogate is not yet fitted; RETRAIN_SURROGATE
        always triggers 1 fit; other actions trigger 0.
    should_stop : bool
        True iff action.type == STOP. Caller should break its loop.
    """

    action: OptimizationAction
    n_new_samples: int
    n_model_fits: int = 0
    should_stop: bool = False

